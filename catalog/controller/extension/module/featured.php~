<?php
class ControllerExtensionModuleFeatured extends Controller {
	public function index($setting) {
		$this->load->language('extension/module/featured');

		$this->load->model('catalog/product');
		$this->load->model('catalog/mark');

		$this->load->model('tool/image');

		$data['products'] = array();

		if (!$setting['limit']) {
			$setting['limit'] = 4;
		}

		if(isset($this->session->data['model_id'])){
			
			$filter_mark_id = (int)$this->session->data['model_id'];
			
			$mark_info = $this->model_catalog_mark->getMark($filter_mark_id);
			
			if($mark_info){
				$parent_info = $this->model_catalog_mark->getMark($mark_info['parent_id']);
			}
			
			if($parent_info){
				$data['heading_title'] = $this->language->get('heading_title') . ' ' . $parent_info['name'] . ' ' . $mark_info['name'];
			}
		
			
			
			$filter_data = array(
				'filter_category_id' => 0,
				'filter_diagram'      => 2, //Только товары
				'filter_model'	=> true,
				'filter_mark_id' => $filter_mark_id,
				'filter_sub_category' > true,
				'sort'               => 'pd.name',
				'order'              => 'ASC',
				'start'              => 0,//($page - 1) * $limit,
				'limit'              => (int)$setting['limit'],//$limit
			);
			$product_list = $this->model_catalog_product->getProducts($filter_data);		
		
			if($product_list){
				
				$setting['product'] = array();
				
				foreach($product_list as $product){
					
					$setting['product'][] = $product['product_id'];
					
				}
				
			}
		
		}
		
		//Если нет товаров этой модели тогда подтянем товары этой марки
		if (!empty($setting['product']) AND isset($mark_info) AND $mark_info) {
			
			$filter_data = array(
				'filter_category_id' => 0,
				'filter_diagram'      => 2, //Только товары
				'filter_model'	=> true,
				'filter_mark_id' => $mark_info['parent_id'],
				'filter_sub_category' > true,
				'sort'               => 'pd.name',
				'order'              => 'ASC',
				'start'              => 0,//($page - 1) * $limit,
				'limit'              => (int)$setting['limit'],//$limit
			);
			$product_list = $this->model_catalog_product->getProducts($filter_data);		
		
			if($product_list){
				
				$setting['product'] = array();
				
				foreach($product_list as $product){
					
					$setting['product'][] = $product['product_id'];
					
				}
				
			}
			
		}
		
		//Если вообще нет - подтянем дефолтный фильтр
		if (!empty($setting['product'])) {
			$products = array_slice($setting['product'], 0, (int)$setting['limit']);

			foreach ($products as $product_id) {
				$product_info = $this->model_catalog_product->getProduct($product_id);

				if ($product_info) {
					if ($product_info['image']) {
						//$image = $this->model_tool_image->resize($product_info['image'], $setting['width'], $setting['height']);
						$image = $this->model_tool_image->resize($product_info['image'], $setting['width'], $setting['height'],'product_list');
					} else {
						$image = $this->model_tool_image->resize('placeholder.png', $setting['width'], $setting['height']);
					}

					if ($this->customer->isLogged() || !$this->config->get('config_customer_price')) {
						$price = $this->currency->format($this->tax->calculate($product_info['price'], $product_info['tax_class_id'], $this->config->get('config_tax')), $this->session->data['currency']);
					} else {
						$price = false;
					}

					if (!is_null($product_info['special']) && (float)$product_info['special'] >= 0) {
						$special = $this->currency->format($this->tax->calculate($product_info['special'], $product_info['tax_class_id'], $this->config->get('config_tax')), $this->session->data['currency']);
						$tax_price = (float)$product_info['special'];
					} else {
						$special = false;
						$tax_price = (float)$product_info['price'];
					}
		
					if ($this->config->get('config_tax')) {
						$tax = $this->currency->format($tax_price, $this->session->data['currency']);
					} else {
						$tax = false;
					}

					if ($this->config->get('config_review_status')) {
						$rating = $product_info['rating'];
					} else {
						$rating = false;
					}

					$data['products'][] = array(
						'product_id'  => $product_info['product_id'],
						'thumb'       => $image,
		 			'sku'  => ($product_info['sku'] != '') ? $product_info['sku'] : $product_info['model'],
					'manufacturer_img' => isset($manufacturer_img) ? $manufacturer_img : '',

						'name'        => $product_info['name'],
						'description' => utf8_substr(strip_tags(html_entity_decode($product_info['description'], ENT_QUOTES, 'UTF-8')), 0, $this->config->get('theme_' . $this->config->get('config_theme') . '_product_description_length')) . '..',
						'price'       => $price,
						'special'     => $special,
						'tax'         => $tax,
						'rating'      => $rating,
						'href'        => $this->url->link('product/product', 'product_id=' . $product_info['product_id'])
					);
				}
			}
		}

		if ($data['products']) {
			return $this->load->view('extension/module/featured', $data);
		}
	}
}