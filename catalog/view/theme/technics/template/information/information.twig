		$(document).on('click', '#simpleregister_button_confirm', function(){
			
			$.ajax({
				url: 'index.php?route=mail/send_form',
				type: 'post',
				data: $('#request_block').serialize(),
				dataType: 'text',
				beforeSend: function () {
				},
				complete: function () {
				},
				success: function (json) {
					console.log(json);
					$('#request_block input').val('');
				},

			});
			
		});
	  </script>
	  
{{ footer }}</body></html>

