{{ header }} {% set col = column_left ? 9 : 12 %} {% set col = column_right ? col - 3 : col %}
      <!-- Main :: Start-->
      <main class="main inform">
        <!-- Breadcrumbs :: Start-->
        {{ breadcrumbs_twig }}
        <!-- Breadcrumbs :: End-->
        <!-- Page :: Start-->
        <div class="page information_page">
	<div class="container-fluid">
{% if ( home_url == '/katalog' or   home_url == '/index.php?route=information/information&information_id=14') %}
{{ content_top }}
	{% else %}

	
            <h1 class="page__heading">{{ heading_title }}</h1>
            <div class="row">
		
				{% if info16 %}
				<div class="box_info_id16">
					<div>
						{{ description }}
					</div>
					<div><img src="/image/VCM112_alt1.jpg"> </div>
				</div>
				{% else %}

				 
				
				
				
						{{ column_left ? '<div id="column-left" class="col-xl-3">' ~ column_left ~ '</div>' : ''}}
						<div class="col-xl-{{ col }}">
							<div class="editor">





<div class="maserati_template">
          <div class="info_fixed_heading">
            <img src="/image/catalog/windshield/windshield-first.jpg" alt="">
            <img src="/image/catalog/windshield/windshield-first-mob.jpg" alt="">
          </div>

          <div class="windshield_info_banner">
            <h1>Sicurvetro windshield</h1>
            <span>We manufacture glass for a range of classic Italian and European cars, as well as for custom automotive projects.</span>
          </div>
			
			<div class="filter_windshield_block">
					<h2>List of Availability</h2>
					<h3>Choose the product and send a request</h3>
					
			  <form action="javascript:;" method="post" id="request_block">
					<div class="filter_windshield">
					  <select class="filter_windshield" name="mark" id="production_mark">
						{% for model in marks %}
						<option value="{{ model.mark_id }}" selected="">{{ model.name }}</option>
						{% endfor %}
					  </select>
					   
					  <select class="filter_windshield" name="model" id="production_model">
							<option value="0" data-mark_id="0">. . .</option>
							{% for model in models %}
								<option value="{{ model.mark_id }}" data-mark_id="{{ model.parent_id }}">{{ model.name }}</option>
							{% endfor %}
						</select>
																
					  <select class="filter_windshield" name="windshield" id="production_windshield">
							<option value="0">. . .</option>
							{% for production in productions %}
								<option value="{{ production.production_id }}" data-model_id="{{ production.mark_id }}_{{ production.model_id }}">{{ production.name }}</option>
								{% endfor %}
						</select>
																
					  <input class="filter_windshield" type="text" name="production_firstname" id="production_firstname" value="" placeholder="Your Name">
					  <input class="filter_windshield" type="text" name="production_phone" id="production_firstname" value="" placeholder="Phone number">
					  <input class="filter_windshield" type="text" name="production_email" id="production_firstname" value="" placeholder="Email">
					  <div class="simpleregister-button-right">
						<a class="button btn-primary button_oc btn" data-onclick="submit" id="simpleregister_button_confirm"><span>send a request</span></a>
					  </div>
					</div>
				</form>
			</div>
			
            <div class="block_gallery_images">
            <img src="/image/catalog/windshield/wgal1.jpg" alt="">
            <img src="/image/catalog/windshield/wgal2.jpg" alt="">
            <img src="/image/catalog/windshield/wgal3.jpg" alt="">
            <img src="/image/catalog/windshield/wgal4.jpg" alt="">
            <img src="/image/catalog/windshield/wgal5.jpg" alt="">
            <img src="/image/catalog/windshield/wgal6.jpg" alt="">
            <img src="/image/catalog/windshield/wgal7.jpg" alt="">
            <img src="/image/catalog/windshield/wgal8.jpg" alt="">
  		  	</div>
  
			
			{{ description }}  
			
          <div class="simpleregister-button-right">
             <a class="button btn-primary button_oc btn" data-onclick="submit" id="simpleregister_button_confirm"><span>send a request</span></a>
          </div> 		
 

 </div>  

						
	<script>
	  
		function set_models(){
		 
		  	var mark_id = $('#production_mark').val();
			$('#production_model option').hide();
			$('#production_model option[data-mark_id="'+mark_id+'"]').show();
			$('#production_model option[value="0"]').show();
			$('#production_model').val(0);
			$('#production_windshield').val(0);
		}
		
		function set_productions(mark_id, model_id){
			$('#production_windshield option').hide();
			$('#production_windshield option[data-model_id="'+mark_id+'_0"]').show();
			
			if(model_id > 0){
				$('#production_windshield option[data-model_id="'+mark_id+'_'+model_id+'"]').show();
				console.log('#production_windshield option[data-model_id="'+mark_id+'_'+model_id+'"]');
			}else{
				$('#production_windshield option[data-model_id^="'+mark_id+'_"]').show();
				console.log('#production_windshield option[data-model_id^="'+mark_id+'_"]');
			}
		}
	  
		$(document).on('change', '#production_mark', function(){
			var mark_id = $('#production_mark').val();
			set_models();
			set_productions(mark_id, 0);
		});
	  
		$(document).on('change', '#production_model', function(){
			var mark_id = $('#production_mark').val();
			var model_id = $('#production_model').val();
			
			$('#production_windshield').val(0);
			
			set_productions(mark_id, model_id);
		});
	  
		$(document).ready(function(){
			
			var mark_id = $('#production_mark').val();
			set_models();
			set_productions(mark_id, 0);
			
		});
	 
	</script>







							</div>
						</div>
						{{ column_right ? '<div id="column-right" class="col-xl-3">' ~ column_right ~ '</div>' : ''}}
						</div>
				{% endif %}		
			</div>
		  
		  {% endif %}	


</div>
        <!-- Page :: End-->
      </main>
	  <!-- Main :: End-->
	  
	  <script>
		$(document).on('click', '#simpleregister_button_confirm', function(){
			
			$.ajax({
				url: 'index.php?route=mail/send_form/send_production',
				type: 'post',
				data: $('#request_block').serialize(),
				dataType: 'text',
				beforeSend: function () {
				},
				complete: function () {
				},
				success: function (json) {
					console.log(json);
					$('#request_block input').val('');
					alert('Form send success!');
				},

			});
			
		});
	  </script>
	  
{{ footer }}</body></html>

