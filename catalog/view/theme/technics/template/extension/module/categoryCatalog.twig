<div class="box_categorywall_title">
	{{ text_select_category_title }}
</div>
<div class="box_categorywall_wrapper">
	<div class="row box_categorywall">
		{% for category in categories %}
			<div class="product-layout product-grid col-lg-3 col-md-3 col-sm-6 col-xs-12">
			  <div class="product-thumb transition">
				  <div class="image">
					<a href="{{ category.href }}" class="dinamik_link" style="padding-bottom: 100%" data-href="{{ category.short_href }}">
						<img alt="{{ category.name }}" title="{{ category.name }}" class="img" data-src="{{ category.image }}" src="{{ category.image }}" src="#"/>
					</a>
				  </div>
				  <div class="caption">
					<div class="name"><a href="{{ category.href }}" class="dinamik_link"  data-href="{{ category.short_href }}">{{ category.name }}</a></div>
				  </div>
			  </div>
			</div>

		{% endfor %}
	</div>
</div>
