{% if (products) %} 
 <!-- Products :: Start-->
        <div class="products box_bestsellers">
          <div class="container-fluid">
              <div class="row">
                <div class="col-lg-12">
                  <span class="h2 products__heading">{{ heading_title }}</span>
                </div>
              </div>
                  <div class="products__slides_bestsel js-slick-recomended">
						{% for product in products %}
                      
					  
					  <div class="products__item{% if (category_time and product['special'] and product['special_date_end']) %} products__item--countdown{% endif %}">
						<div class="products__item-in">
 
 
						  <div class="products__item-stickers stickers_{{  product['stock_status_id']  }} ">{{  product['stock']  }}</div>
		
	 						  {% if (not product['images']) %} 
						  <div class="products__item-images"><a href="{{ product['href'] }}"><img {{ lazyload ? 'src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" data-lazy' : 'src' }}="{{ product['thumb'] }}" alt="{{ product['name'] }}"></a></div>
						  {% else %}
						  <div class="products__item-images js-slick-products">
							<a href="{{ product['href'] }}"><img data-lazy="{{ product['thumb'] }}" src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" alt="{{ product['name'] }}"></a>
							
						  </div>
						  {% endif %}
						  
		 						  
						  
						  <div class="products__item-desc">
<a href="{{ product['href'] }}" class="products__item-title">{{ product['name'] }}</a>
								
<div class="box_manuf_sku">	
<div>
	{% if (product['manufacturer']) %} 
	<span class="products__item-category">
		{% if (product['manufacturer_img']) %} 
			<img src="{{ product['manufacturer_img'] }}">	
			{% else %} 
			{{ product['manufacturer'] }}
		{% endif %}
	</span>
	{% endif %}
</div>
<div>
<span class="products__item-category"># {{ product['sku'] }}</span>
</div>
</div>				  
	
<div class="box_price_cart">	
<div>
 <span class="products__item-price">
							{% if (product['price']) %} 
								{% if (product['special']) %} 
									<u>{{ product['price'] }}</u>{{ product['special'] }} 
								{% else %} 
									{{ product['price'] }}
								{% endif %}
							{% endif %} 
						  </span>	
  {% if (category_time and product['special'] and product['special_date_end']) %}
							  <div class="products__item-countdown">
								<div class="countdown">
								  <p class="countdown__text">{{ time_text_1 }} <small>{{ time_text_2 }}</small></p>
								  <time class="countdown__time js-countdown-time" data-text-countdown="{{ text_countdown }}">{{ product['special_date_end'] }}</time>
								</div>
							  </div>
							  {% endif %}

</div>
<div>
<div class="">
								{% if (product['isoption_required']) %}
									<a data-for="{{ product['product_id'] }}" title="{{ button_cart }}" data-opt="isoptneed" class="btn btn--cart js-btn-preview" href="#popupprod">
	                                 </a>
	                            {% else %}
									<button type="button" class="btn btn--cart" title="{{ button_cart }}" onclick="cart.add('{{ product['product_id'] }}', '{{ product['minimum'] }}');" {{ product['buy_btn'] ? 'disabled' : ''}}> 
									 </button>	                                
								{% endif %}
								{% if (product_detail) %}
								<a data-for="{{ product['product_id'] }}" title="{{ text_product_view_btn }}" class="btn btn--preview js-btn-preview" href="#popupprod">
                                <svg class="icon-preview">
                                  <use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-preview"></use>
                                </svg></a>
								{% endif %}
							</div>
</div>
</div>				  
						  </div>
						</div>
					  </div>
					  
						{% endfor %} 
                  </div>
          </div>
        </div>
		
		
		
<script>
$('.products__slides_bestsel').slick({
 		rows: 2,
		dots: false,
		arrows: true,
		infinite: true,
		speed: 300,
		slidesToShow: 6,
		slidesToScroll: 5,
responsive: [
    {
      breakpoint: 1000,
      settings: {
        slidesToShow: 2,
        slidesToScroll: 2,
      },
    },
    {
      breakpoint: 768,
      settings: {
        slidesToShow: 2,
        slidesToScroll: 2,
      },
    },
    {
      breakpoint: 420,
      settings: {
        slidesToShow: 2,
        slidesToScroll: 2,
      },
    },
  ],		
});
</script>
	
	
	
	
	
<!-- Products :: End-->
{% endif %}		