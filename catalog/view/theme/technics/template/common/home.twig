<!DOCTYPE html>
<html lang="{{ lang }}" class="page">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
		<meta http-equiv="X-UA-Compatible" content="ie=edge">
		<meta name="theme-color" content="#000000">
		<title>{{ title }}</title>
		<base href="{{ base }}">
		<meta name="description" content="{{ description }}">
		<meta name="keywords" content="{{ keywords }}">
		{% if links %}
			{% for link in links %}
				<link {{ link }}>
			{% endfor %}
		{% endif %}
		<link rel="preload" href="{{ lm_theme_assets }}fonts/GoogleSansFlex.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="{{ lm_theme_assets }}fonts/Hand.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="stylesheet" href="{{ lm_theme_assets }}css/vendor.css">
		<link rel="stylesheet" href="{{ lm_theme_assets }}css/main.css">
		<link rel="stylesheet" href="{{ lm_theme_assets }}css/custom.css?v{{ lm_assets_ver }}1">
		<link rel="stylesheet" href="{{ lm_theme_assets }}css/donor.css?v{{ lm_assets_ver }}">
		<script src="{{ lm_theme_assets }}js/jquery.min.js"></script>
		<script src="{{ lm_theme_assets }}js/jquery-ui.min.js"></script>
		{% for style in lm_styles %}
			<link {{ style }}>
		{% endfor %}
		<script defer src="{{ lm_theme_assets }}js/main.js?v{{ lm_assets_ver }}1"></script>
		<script defer src="{{ lm_theme_assets }}js/custom.js?v{{ lm_assets_ver }}2"></script>
		<script defer src="{{ lm_theme_assets }}js/donor.js?v{{ lm_assets_ver }}"></script>
	</head>
	<body class="page__body">
		<div
			class="site-container">

			<!-- Header -->
			<header class="header">
				<div class="container container__header">
					<div class="logo header__logo">
						<a href="{{ home }}" class="logo__link">
							<img src="{{ lm_theme_assets }}img/svg/logo.svg" alt="{{ name }}" class="logo__img">
						</a>
					</div>
					<div class="header__user">
						<div class="header__user-cabinet">
							<div class="m-select">
								<div class="m-select__header bg-white user__btn">
									<span class="m-select__current">
										<img src="{{ lm_theme_assets }}img/svg/user.svg" alt="{{ text_login }}">
										{% if logged %}
											{{ text_account }}
										{% else %}
											{{ text_login }}
										{% endif %}
									</span>
									<div class="m-select__icon">
										<img src="{{ lm_theme_assets }}img/svg/down.svg" alt="">
									</div>
								</div>
								{% if logged %}
									<ul class="list-reset m-select__body">
										<li class="m-select__item">
											<a class="m-select__item-inner" href="{{ account }}">{{ text_account }}</a>
										</li>
										<li class="m-select__item">
											<a class="m-select__item-inner" href="{{ garage }}">{{ text_garage }}</a>
										</li>
										<li class="m-select__item">
											<a class="m-select__item-inner" href="{{ order }}">{{ text_order }}</a>
										</li>
										<li class="m-select__item">
											<a class="m-select__item-inner" href="{{ wishlist }}">{{ text_wishlist }}</a>
										</li>
										<li class="m-select__item">
											<a class="m-select__item-inner" href="{{ auction }}">{{ text_auction_href }}</a>
										</li>
										<li class="m-select__item">
											<a class="m-select__item-inner" href="{{ logout }}">{{ text_logout }}</a>
										</li>
									</ul>
								{% else %}
									<ul class="list-reset m-select__body">
										<li class="m-select__item">
											<a class="m-select__item-inner" href="{{ login_url }}">{{ text_login }}</a>
										</li>
										<li class="m-select__item">
											<a class="m-select__item-inner" href="{{ register }}">{{ text_register }}</a>
										</li>
									</ul>
								{% endif %}
							</div>
						</div>
						<div class="header__user-cart">
							<button type="button" class="btn-reset bg-white btn">
								<img src="{{ lm_theme_assets }}img/svg/cart.svg" alt="cart">
								<span>{{ text_cart_empty }}</span>
							</button>
						</div>
					</div>

					<div class="header__right">
						<div class="m-select lang__select">
							<div class="m-select__header bg-white lang__btn">
								<span class="m-select__current">
									{% for lang_item in lm_languages %}
										{% if lang_item.code == lm_current_lang_code %}
											<img src="{{ lm_theme_assets }}img/lang/{{ lang_item.code[:2] }}.svg" alt="{{ lang_item.long_name }}">
											{{ lang_item.name }}
										{% endif %}
									{% endfor %}
								</span>
								<div class="m-select__icon">
									<img src="{{ lm_theme_assets }}img/svg/down.svg" alt="">
								</div>
							</div>
							<ul class="list-reset m-select__body lang__menu">
								{% for lang_item in lm_languages %}
									<li class="m-select__item" data-lang="{{ lang_item.code }}">
										<a class="lang__link m-select__item-inner" href="{{ lang_item.href }}">
											<img src="{{ lm_theme_assets }}img/lang/{{ lang_item.code[:2] }}.svg" alt="{{ lang_item.long_name }}">{{ lang_item.name }}
										</a>
									</li>
								{% endfor %}
							</ul>
						</div>
						<div class="mobi_menu">
							<button type="button" class="btn-reset btn bg-blue color-white btn-menu mobi_menu_togle">
								<div class="toggle_wrap">
									<span></span>
									<span></span>
									<span></span>
								</div>
							</button>
							<div class="mobi_menu_overlay"></div>
							<div class="mobi_menu_box">
								<div class="mobi_menu_box_content">
									<div class="mobi_menu_box_top">
										<div class="header__user-cabinet">
											<div class="m-select">
												<div class="m-select__header bg-white user__btn">
													<span class="m-select__current">
														<img src="{{ lm_theme_assets }}img/svg/user.svg" alt="{{ text_login }}">
														{% if logged %}
															{{ text_account }}
														{% else %}
															{{ text_login }}
														{% endif %}
													</span>
													<div class="m-select__icon">
														<img src="{{ lm_theme_assets }}img/svg/down.svg" alt="">
													</div>
												</div>
												{% if logged %}
													<ul class="list-reset m-select__body">
														<li class="m-select__item">
															<a class="m-select__item-inner" href="{{ account }}">{{ text_account }}</a>
														</li>
														<li class="m-select__item">
															<a class="m-select__item-inner" href="{{ garage }}">{{ text_garage }}</a>
														</li>
														<li class="m-select__item">
															<a class="m-select__item-inner" href="{{ order }}">{{ text_order }}</a>
														</li>
														<li class="m-select__item">
															<a class="m-select__item-inner" href="{{ wishlist }}">{{ text_wishlist }}</a>
														</li>
														<li class="m-select__item">
															<a class="m-select__item-inner" href="{{ auction }}">{{ text_auction_href }}</a>
														</li>
														<li class="m-select__item">
															<a class="m-select__item-inner" href="{{ logout }}">{{ text_logout }}</a>
														</li>
													</ul>
												{% else %}
													<ul class="list-reset m-select__body">
														<li class="m-select__item">
															<a class="m-select__item-inner" href="{{ login_url }}">{{ text_login }}</a>
														</li>
														<li class="m-select__item">
															<a class="m-select__item-inner" href="{{ register }}">{{ text_register }}</a>
														</li>
													</ul>
												{% endif %}
											</div>
										</div>
										<div class="cart_mobi_menu">
											<button type="button" class="btn-reset bg-white btn">
												<img src="{{ lm_theme_assets }}img/svg/cart.svg" alt="cart">
												<span>{{ text_cart_empty }}</span>
											</button>
										</div>
										<div class="m-select lang__select">
											<div class="m-select__header bg-white lang__btn">
												<span class="m-select__current">
													{% for lang_item in lm_languages %}
														{% if lang_item.code == lm_current_lang_code %}
															<img src="{{ lm_theme_assets }}img/lang/{{ lang_item.code[:2] }}.svg" alt="{{ lang_item.long_name }}">
															{{ lang_item.name }}
														{% endif %}
													{% endfor %}
												</span>
												<div class="m-select__icon">
													<img src="{{ lm_theme_assets }}img/svg/down.svg" alt="">
												</div>
											</div>
											<ul class="list-reset m-select__body lang__menu">
												{% for lang_item in lm_languages %}
													<li class="m-select__item" data-lang="{{ lang_item.code }}">
														<a class="lang__link m-select__item-inner" href="{{ lang_item.href }}">
															<img src="{{ lm_theme_assets }}img/lang/{{ lang_item.code[:2] }}.svg" alt="{{ lang_item.long_name }}">{{ lang_item.name }}
														</a>
													</li>
												{% endfor %}
											</ul>
										</div>
										<div class="mobi_menu_togle_close menu-close">
											<svg class="icon-back" width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
												<path d="M1 2L22 23" stroke="white" stroke-width="2" stroke-linecap="round"/>
												<path d="M22 2L1 23" stroke="white" stroke-width="2" stroke-linecap="round"/>
											</svg>
										</div>
									</div>
									<div class="mobi_menu_box_select">
										<div class="mobi_menu_box_select_items">
											{% for mark in marks %}
												<a href="{{ mark.href }}">{{ mark.name }}</a>
											{% endfor %}
										</div>
									</div>
									<div class="box_menu_articles">
										<ul class="list-reset">
											<li>
												<a href="/maserati/">{{ text_car_parts }}</a>
											</li>
											<li>
												<a href="{{ blog_href }}">{{ text_club_store }}</a>
											</li>
											<li>
												<a href="{{ auction_href }}">{{ text_auction }}</a>
											</li>
											<li>
												<a href="{{ blog_href }}">{{ text_club_news_link }}</a>
											</li>
											<li>
												<a href="{{ customer_service_href }}">{{ text_customer_service }}</a>
											</li>
											<li>
												<a href="{{ about_href }}">{{ text_about_us }}</a>
											</li>
											<li>
												<a href="{{ contact_href }}">{{ text_contacts }}</a>
											</li>
										</ul>
									</div>
									<div class="box_menu__bottom">
										<div class="box_menu__contact">
											<p class="contacts-title">{{ text_contact_us_heading }}</p>
											<a href="tel:{{ telephone }}">{{ telephone }}</a>
											<a href="mailto:{{ config_email }}">{{ config_email }}</a>
										</div>
										<ul class="list-reset social__list">
											<li>
												<a href="#"><img src="{{ lm_theme_assets }}img/social/fb.svg" alt=""></a>
											</li>
											<li>
												<a href="#"><img src="{{ lm_theme_assets }}img/social/inst.svg" alt=""></a>
											</li>
											<li>
												<a href="#"><img src="{{ lm_theme_assets }}img/social/yt.svg" alt=""></a>
											</li>
										</ul>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</header>

			<main
				class="main">

				<!-- Hero -->
				<section class="hero" data-reveal-container>
					{{ content_top  }}
{##}
					<div class="hero__content">
						<h1 class="page-title">{{ text_home_title }}</h1>
						<div class="box_home_search">
							<nav class="nav hero-nav js-sticky">
								<div id="search" class="search js-search">
									<div class="search__wrapper">
										<a href="#" class="search__btn search__btn-icon">
											<img src="{{ lm_theme_assets }}img/svg/search.svg" alt="">
										</a>
										<input type="text" name="search" value="" placeholder="{{ text_search_placeholder }}" class="form-control" autocomplete="off">
										<div class="search__right">
											<a href="#" class="search__list-close">
												<img src="{{ lm_theme_assets }}img/svg/s-close.svg" alt="search close button" type="button">
											</a>
											<span class="vertical-line"></span>
											<a href="#" class="search__btn search__btn-text">{{ text_search }}</a>
										</div>
										<div class="live-search">
											<ul></ul>
											<div class="result-text"></div>
										</div>
									</div>
								</div>
							</nav>
						</div>
					</div>
					<div class="swiper-pagination hero-pagination"></div>
				</section>

				<!-- Categories -->
				<section class="categories" data-reveal-container>
					<div class="container">
						<div class="categories__top">
							<div class="swiper categories__slider" data-mark-ids="{{ lm_mark_ids|json_encode }}" data-reveal="text">
								<div class="swiper-wrapper">
									{% for mark in lm_marks %}
										<div class="swiper-slide categories__slide" data-mark-id="{{ mark.mark_id }}">
											<a href="{{ mark.href }}">
												<img src="{{ mark.image }}" alt="{{ mark.name }}">
											</a>
										</div>
									{% endfor %}
								</div>
								<div class="categories__navigation">
									<div class="slider-nav categories__slider-prev">
										<img src="{{ lm_theme_assets }}img/slider-logo/left.svg" alt="">
									</div>
									<div class="slider-nav categories__slider-next">
										<img src="{{ lm_theme_assets }}img/slider-logo/right.svg" alt="">
									</div>
								</div>
							</div>
							<form class="select__group">
								<div class="select__models" data-reveal="txt">
									<p class="color-grey">{{ text_select_model }}</p>
									<div class="c-select" id="lm-model-select">
										<select name="model" class="c-select__native">
											<option value="">{{ text_select_model }}</option>
											{% for model in lm_first_models %}
												<option value="{{ model.model_id }}" data-href="{{ model.href }}">{{ model.name }}</option>
											{% endfor %}
										</select>
										<div class="c-select__custom">
											<div class="c-select__trigger">
												<span class="c-select__label">{{ text_select_model }}</span>
												<img src="{{ lm_theme_assets }}img/svg/down.svg" alt="" class="c-select__icon">
											</div>
											<div class="c-select__dropdown">

												{% for model in lm_first_models %}
													<div class="c-select__option" data-value="{{ model.model_id }}" data-href="{{ model.href }}">
														{% if model.image %}
															<img src="{{ model.image }}" alt="">
														{% endif %}
														<span>{{ model.name }}</span>
													</div>
												{% endfor %}
											</div>
										</div>
									</div>
								</div>
								<div class="select__category" data-reveal="txt" style="transition-delay: 0.25s;">
									<p class="color-grey">{{ text_select_category }}</p>
									<div class="c-select" id="lm-category-select">
										<select name="category" class="c-select__native">
											<option value="">{{ text_select_category }}</option>
											{% for item in lm_first_categories %}
												<option value="{{ item.product_id }}" data-href="{{ item.href }}">{{ item.name }}</option>
											{% endfor %}
										</select>
										<div class="c-select__custom">
											<div class="c-select__trigger">
												<span class="c-select__label">{{ text_select_category }}</span>
												<img src="{{ lm_theme_assets }}img/svg/down.svg" alt="" class="c-select__icon">
											</div>
											<div class="c-select__dropdown">
												{% for item in lm_first_categories %}
													<div class="c-select__option" data-value="{{ item.product_id }}" data-href="{{ item.href }}">
														<span>{{ item.name }}</span>
													</div>
												{% else %}
													<div class="c-select__option" data-value="">{{ text_select_category }}</div>
												{% endfor %}
											</div>
										</div>
									</div>
								</div>
								<a id="category-open-link" href="{{ lm_first_categories[0].href }}" class="btn-reset btn bg-blue color-white btn-search">{{ text_search }}</a>
							</form>
						</div>
					</div>
					<div class="wrapper-categories__bottom">
						<div class="container">
							<div class="swiper categories__bottom">
								<div class="swiper-wrapper categories__list grid">
									{% for item in lm_category_bottom %}
										<div class="swiper-slide categories__list-item" data-reveal="txt" style="transition-delay: 0.15s;">
											<a href="{{ item.href }}" class="category_link">

												<div class="category-image">
													<picture>
														<img src="{{ item.thumb }}" class="image" alt="{{ item.name }}">
													</picture>
												</div>
												<h3 class="item-title">{{ item.name }}</h3>
											</a>
										</div>
									{% endfor %}
								</div>
								<div class="categories__list-pagination"></div>
							</div>
						</div>
					</div>
					<a id="categories-view-all" href="{{ all_categories_href }}" class="btn btn-reset btn-view">{{ text_all_categories }}</a>
				</section>

				<!-- Banner Promo -->
				<section class="section banner ">
					<div class="container banner__container">
						<div class="banner__image">
							<img src="{{ lm_banner_promo.image }}" alt="{{ lm_banner_promo.title }}" class="banner-image">
						</div>
						<div class="banner__content text-white" data-reveal="txt">
							<h3 class="section-title promo-title text-white">{{ lm_banner_promo.title }}</h3>
							<div class="promo-data">
								<span class="promo-text">{{ text_promo_code }}</span>
								<button type="button" class="btn-reset promo-code-btn" data-promo="{{ lm_banner_promo.code }}" title="Click to copy code">
									<code>{{ lm_banner_promo.code }}</code>
								</button>
							</div>
						</div>
					</div>
				</section>

				<!-- Club -->
				<section class="section club">
					<div class="container">
						<h2 class="section-title">
							{{ text_club_title }}
							<span class="club-logo"><img src="{{ lm_theme_assets }}img/club-list/club-logo.png" alt=""></span>
						</h2>
						<div class="swiper club__slider">
							<div class="swiper-wrapper club__list grid">
								{% for article in blog_products %}
									<div class="swiper-slide article" data-reveal="elem">
										<div class="article-image">
											<img src="{{ article.thumb }}" class="image" alt="{{ article.name }}">
										</div>
										<div class="article-content">
											<p class="article-meta">
												<time datetime="{{ article.date_available }}" itemprop="datePublished">{{ article.date_available }}</time>
											</p>
											<h4 class="article-title">
												<a href="{{ article.href }}">{{ article.name }}</a>
											</h4>
											<div class="article-text">{{ article.description }}</div>
											<a href="{{ article.href }}" class="article-link"><img src="{{ lm_theme_assets }}img/svg/article-link.svg" alt=""></a>
										</div>
									</div>
								{% endfor %}
							</div>
						</div>
						<a href="{{ blog_href }}" class="btn btn-reset btn-view">{{ text_club_store_bttn }}</a>
					</div>
				</section>

				<!-- Auctions -->
				<section class="section bg-grey auctions">
					<div class="container">
						<h2 class="section-title" data-reveal="txt">{{ text_auctions_title }}</h2>
						<div class="swiper auctions__slider">
							<div class="swiper-wrapper auctions__list grid">
								{% for product in auction_products %}
									<div class="swiper-slide article" data-reveal="elem">
										<a href="{{ product.href }}">
											<div class="article-image">
												<img src="{{ product.thumb }}" class="image" alt="{{ product.name }}">
											</div>
											<div class="article-content" data-reveal="txt" style="transition-delay: 0.25s;">
												<h4 class="article-title">{{ product.name }}</h4>
												<div class="article-bottom">
													{% if product.price %}
														<p class="price">{{ product.price }}</p>
													{% endif %}
													<span class="article-link"><img src="{{ lm_theme_assets }}img/svg/article-link.svg" alt=""></span>
												</div>
												<script>// var icon = $('.mobi_menu_togle');
// $(".mobi_menu_togle, .mobi_menu_togle_close").click(function () {
// if ($(".mobi_menu_box").hasClass("open")) {
// $(".mobi_menu_box").removeClass("open");
// } else {
// $(".mobi_menu_box").addClass("open");
// }
// });
											</script>
										</div>
									</a>
								</div>
							{% else %}
								<div class="swiper-slide article" data-reveal="elem">
									<div class="article-image">
										<picture>
											<source srcset="{{ lm_theme_assets }}img/auction/1.webp" type="image/webp">
											<img src="{{ lm_theme_assets }}img/auction/1.jpg" class="image" width="" height="" alt="">
										</picture>

									</div>
									<div class="article-content">
										<h4 class="article-title">
											A6 GCS/53 Berlinetta (s/n 2060)
										</h4>
										<div class="article-bottom">
											<p class="price">
												15 000 $
											</p>
											<a href="#" class="article-link"><img src="{{ lm_theme_assets }}img/svg/article-link.svg" alt=""></a>
										</div>

									</div>
								</div>
								<div class="swiper-slide article" data-reveal="elem">
									<div class="article-image">
										<picture>
											<source srcset="{{ lm_theme_assets }}img/auction/2.webp" type="image/webp">
											<img src="{{ lm_theme_assets }}img/auction/2.jpg" class="image" width="" height="" alt="">
										</picture>

									</div>
									<div class="article-content">
										<h4 class="article-title">
											Ferrari Is Ending Its Engine Supply Deal With Maserati
										</h4>
