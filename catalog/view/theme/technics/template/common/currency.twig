{% if currencies|length > 1 %}
              <div class="wallet js-toggle">
				<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-currency">
                <button class="wallet__btn js-toggle-btn">


		{% for currency in currencies %}
		{% if currency.symbol_left and currency.code == code %} {{ currency.title }}  {% elseif currency.symbol_right and currency.code == code %}  {{ currency.title }}  {% endif %}
		{% endfor %}
                </button>
                <div class="wallet__dropdown js-toggle-dropdown">

		        <div class="lang__dropdown_title">{{ select_currency }} <span class="close_model_lang"></span></div>


<ul class="wallet__menu">
        {% for currency in currencies %}
        {% if currency.symbol_left %}
		<li data-curr="{{ currency.code }}"><a class="wallet__link" href="javascript:;" name="{{ currency.code }}">{{ currency.symbol_left }} {{ currency.title }}</a></li>
        {% else %}
		<li data-curr="{{ currency.code }}"><a class="wallet__link" href="javascript:;" name="{{ currency.code }}">{{ currency.symbol_right }} {{ currency.title }}</a></li>
        {% endif %}
        {% endfor %}
                  </ul>
                </div>
				<input type="hidden" class="curr_code" name="code" value="" />
				<input type="hidden" name="redirect" value="{{ redirect }}" />
			  </form>
              </div>
{% endif %}

<script>
	$(document).on('click', '.wallet__menu li', function(){
		
		var curr = $(this).data('curr');
		$('input.curr_code').val(curr);
		console.log($('input.curr_code').val());
		
		$('#form-currency').submit();
	});
</script>