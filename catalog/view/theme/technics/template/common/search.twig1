                <div class="search js-search">
	<input type="hidden" class="search_href" name="search_href" value="{{ search_href }}">
	<input type="hidden" class="autocomplete_href" name="autocomplete_href" value="{{ autocomplete_href }}">
				


{% if (home_url == '/' or home_url == '/index.php?route=common/home') %}
                    <button class="search__btn search__send">    </button>

{% else %}
                    <button class="search__btn">    </button>
{% endif %}	  

				<div class="search__wrapper">
                      <div class="search__wrapper-in">
						<button class="search__send">
                          <svg class="icon-search">
                            <use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-search"></use>
                          </svg>
						</button>
                        <button class="search__close">
                          <svg class="icon-close">
                            <use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-close"></use>
                          </svg>
                        </button>
                        <input class="search__input js-search-input" name="search" value="{{ search }}" type="search" placeholder="{{ text_search_placeholder }}">
                      </div>
                    </div>
                </div>