			$('.mySwiperLogo').slick({
    centerMode: true,
    centerPadding: '10px',
    slidesToShow: 3,
    autoplay: false,
    infinite: true,
    responsive: [
      {
        breakpoint: 768,
        settings: {
          arrows: false,
          centerMode: true,
          centerPadding: '40px',
          slidesToShow: 3
        }
      },
      {
        breakpoint: 480,
        settings: {
          arrows: false,
