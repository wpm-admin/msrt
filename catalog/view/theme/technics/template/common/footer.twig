      <!-- Footer :: Start-->
<div id="popupprod" class="popup popup--1170"></div>
    {% if (buy_click['status']) %} 
      <div class="popup popup--570" style="display: none;" id="popup-buy-click">
      <button class="popup__close" data-fancybox-close>
        <svg class="icon-close">
        <use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-close"></use>
        </svg>
      </button>
      <div class="writeus"><span class="writeus__heading">{{ text_technics_buy_click }}</span>
        <div class="writeus__form">
        {{ buyclick_form }}
        {{ captcha_fo }}
          <div class="writeus__action">
          <button type="button" class="btn btn--blue js-btn-add-cart-fast quickbuy-send">{{ button_fastorder_sendorder }}</button>
          <input name="quantity" id="cat_qty" type="hidden"  value="2">
          <input name="buy-click-type" id="buy-click-type" type="hidden"  value="product">
          <input name="product_id" id="cat_prod_id" type="hidden"  value="">
          <input name="redirect"  value="1" class="fast-redirect" type="hidden">
          </div>
          {% if (text_click_pdata) %} 
          <div class="personal-data">{{ text_click_pdata }}</div>
          {% endif %} 
        </div>
      </div>
      </div>
    {% endif %} 
{% if (scroll_to_top) %} 
	<a href="#" class="scroll-to-top js-stt" style="{{ scroll_to_top_pos }}: 0;"><svg class="icon-arrow-up"><use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-arrow-up"></use></svg></a>
{% endif %} 

{% if (messenger_status) %}		  
	{% if (messenger_navs is defined) %} 
              <div class="app-chats app-chats--{{ messenger_pos }}">
                <button class="app-chats__toggle">
                  <svg class="icon-chats-open">
                    <use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-chats-open"></use>
                  </svg>
                  <svg class="icon-chats-close">
                    <use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-chats-close"></use>
                  </svg>
                </button>
                <div class="app-chats__dropdown" style="{{ messenger_pos }}: 0;">
                  <ul class="app-chats__list">
			 {% for key,messenger_nav in messenger_navs %} 
				{% if (messenger_links[messenger_nav['settype']] == 'whatsapp') %} 
                    <li><a class="app-chats__item" target="_blank" rel="nofollow" href="https://wa.me/{{ messenger_nav['link'] }}">
                        <figure class="app-chats__item-image"><img src="catalog/view/theme/technics/images/icons/icon-chats-whatsapp.svg" alt=""></figure>
                        <p class="app-chats__item-text">WhatsApp</p></a></li>
				{% endif %} 
				{% if (messenger_links[messenger_nav['settype']] == 'viber') %} 
                     <li><a class="app-chats__item app-chats__item--viber-mobile" target="_blank" href="viber://chat?number={{ messenger_nav['link'] }}">
                        <figure class="app-chats__item-image"><img src="catalog/view/theme/technics/images/icons/icon-chats-viber.png" alt=""></figure>
                        <p class="app-chats__item-text">Viber</p></a>
						<a class="app-chats__item app-chats__item--viber-pc" target="_blank" href="viber://chat?number={{ messenger_nav['link'] }}" rel="nofollow">
                       <figure class="app-chats__item-image"><img src="catalog/view/theme/technics/images/icons/icon-chats-viber.png" alt=""></figure>
                        <p class="app-chats__item-text">Viber</p></a></li>
				{% endif %} 
				{% if (messenger_links[messenger_nav['settype']] == 'telegram') %} 
                    <li><a class="app-chats__item" target="_blank" rel="nofollow" href="https://t.me/{{ messenger_nav['link'] }}" rel="nofollow">
                        <figure class="app-chats__item-image"><img src="catalog/view/theme/technics/images/icons/icon-chats-telegram.svg" alt=""></figure>
                        <p class="app-chats__item-text">Telegram</p></a></li>
				{% endif %} 
				{% if (messenger_links[messenger_nav['settype']] == 'skype') %} 
                    <li><a class="app-chats__item" target="_blank" rel="nofollow" href="skype:{{ messenger_nav['link'] }}?chat" rel="nofollow">
                        <figure class="app-chats__item-image"><img src="catalog/view/theme/technics/images/icons/icon-chats-skype.svg" alt=""></figure>
                        <p class="app-chats__item-text">Skype</p></a></li>
				{% endif %} 
				{% if (messenger_links[messenger_nav['settype']] == 'facebook-messenger') %} 
                    <li><a class="app-chats__item" target="_blank" rel="nofollow" href="http://m.me/{{ messenger_nav['link'] }}" rel="nofollow">
                        <figure class="app-chats__item-image"><img src="catalog/view/theme/technics/images/icons/icon-chats-messenger.svg" alt=""></figure>
                        <p class="app-chats__item-text">Messenger</p></a></li>
				{% endif %} 
				{% if (messenger_links[messenger_nav['settype']] == 'email') %} 
                    <li><a class="app-chats__item" target="_blank" href="mailto:{{ messenger_nav['link'] }}" rel="nofollow">
                        <figure class="app-chats__item-image"><img src="catalog/view/theme/technics/images/icons/icon-chats-email.svg" alt=""></figure>
                        <p class="app-chats__item-text">Email</p></a></li>
				{% endif %} 
				{% if (messenger_links[messenger_nav['settype']] == 'vk') %} 
                    <li><a class="app-chats__item" target="_blank" rel="nofollow" href="https://vk.me/{{ messenger_nav['link'] }}">
                        <figure class="app-chats__item-image"><img src="catalog/view/theme/technics/images/icons/icon-chats-vk.svg" alt=""></figure>
                        <p class="app-chats__item-text">VK</p></a></li>
				{% endif %} 
			{% endfor %} 
                  </ul>
                </div>
              </div>
	{% endif %} 
{% endif %}
{% if (text_technics_cookieagry_btn) %} 
	{% if (not islogged and not cookieagry) %} 
			<div class="cookieagry" style="display: block;">
				<div class="cookieagry__text">
					{{ text_technics_cookieagry_btn }} 
					<button type="button" class="cookieagry__close close" id="cookieagry"><svg class="icon-delete"><use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-delete"></use></svg></button>
				</div>	
			</div>
	{% endif %} 
{% endif %} 


{% if (footer_type == 6) %} 
      <!-- Footer v6 :: Start-->
        <footer class="footer footer--v6">
          <div class="footer__middle">
            <div class="container-fluid">
              <div class="row">
                <div class="col-12 col-md-6 col-xl-3">
			    {% if (footer_t_logo or footer_logo) %}
						{% if (footer_logo) %} 
						<div class="footer__logo"><a {{ home == og_url ? '' : 'href="' ~ home ~'"' }}><img src="/image/catalog/logo_wh.svg" title="{{ name }}" alt="{{ name }}"></a></div>
						{% else %} 
						<div class="footer__logo"><a class="footer__logo-text" {{ home == og_url ? '' : 'href="' ~ home ~'"' }}>{{ text_logo }}</a></div>
						{% endif %} 
				{% endif %}
                <p class="footer__copyright">{{ footer_text }} </p>
			  {% if (soc_stat) %}
			  {% if (social_navs is not empty) %}
                  <div class="footer__social">
                    <nav class="footer__social-nav">
					{% for social_nav in social_navs %}
					  <a class="footer__social-link" href="{{ social_nav['link'] }}" target="{{ social_nav['attr'] }}" rel="nofollow">
                        <svg class="icon-social-{{ (social_links[social_nav['settype']])|lower }}">
                          <use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-social-{{ (social_links[social_nav['settype']])|lower }}"></use>
                        </svg>{{ social_nav['language'][language_id]['name'] }}</a>
					{% endfor %}
					</nav>
                  </div>
			  {% endif %}
			  {% endif %}
                </div>
                <div class="col-12 col-md-6 col-xl-6">
                  <nav class="nav-categories nav-categories--flex{{ footer_categories ? ' js-slick-categories' : ''}}">
					{% for key,footer_nav in footer_navs %}
                        <div class="nav-categories__group">
							{% if (footer_nav['language'][language_id]['name']) %}
								<span class="h4 nav-categories__heading">{{ footer_nav['language'][language_id]['name'] }}</span>
							{% endif %}
							{% if (footer_nav['settype']) %}
							  {{ footer_nav['type'][footer_nav['settype']]['links']['html'] }}
							{% else %}
							<ul class="nav-categories__menu">
							  {% for id,link in footer_nav['type'][footer_nav['settype']]['links'] %}
							  <li><a class="nav-categories__link" href="{{ link }}" {% if (top_links[id]['target'] is defined) %}target="{{ top_links[id]['target'] }}" {% endif %}>{{ footer_nav['type'][footer_nav['settype']]['names'][id] is defined ? footer_nav['type'][footer_nav['settype']]['names'][id] : '' }}</a></li>
							  {% endfor %}
							</ul>
							{% endif %}
                        </div>
					{% endfor %}
                  </nav>
                </div>
                <div class="col-12 col-md-6 col-xl-3 footer_last">
					<div class="footer_lang">
                        {{ text_languages }}
					</div>
					
					<div class="footer_contact">
		<strong>CONTACT US</strong></br>
			8:00am - 5.00pm PST GMT+8</br>
    <a href="tel:{{telephone}}">{{telephone}}</a></br>			
		<a href="mailto:{{config_email}}">{{config_email}}</a>
					</div>
					
					
	<div class="footer_contact_ico">
	<a href="https://www.facebook.com/maseratinetcom/" target="_blank" rel="nofollow"></a><a href="https://www.instagram.com/maseratinet/" target="_blank" rel="nofollow"></a><a href="https://twitter.com/maseratinet/" target="_blank" rel="nofollow"></a>
	</div>
				
					
					
				</div>
              </div>
            </div>
          </div>
          <div class="footer__bottom">
            <div class="container-fluid">
              <div class="row box_footer_copyright">
                <div class="col">© 1976-{{ end_date }} MIE Corporation. All rights reserved.{# footer_copyright #}</div>
                <div class="col">				
<div class="footer_link">
{% for information in informations %}
        <a href="{{ information.href }}">{{ information.title }}</a>
{% endfor %}
</div>
				</div>
                
				
				
                <div class="col-auto">
		
<div class="devel_copy">		Developed by    <a href="https://liberty.ua/en/" target="_blank">Liberty</a> 		</div>
					
					
                </div>
              </div>
            </div>
          </div>
        </footer>
	  <!-- Footer v6 :: End-->
{% endif %} 
{% if (footer_type == 'maintenance') %} 
	  <!-- Footer maintenance :: End-->
      <footer class="footer footer--service">
        <div class="container-fluid">
			    {% if (footer_t_logo or footer_logo) %}
						{% if (footer_logo) %} 
						<div class="footer__logo"><a {{ home == og_url ? '' : 'href="' ~ home ~'"' }}><img src="{{ footer_logo }}" title="{{ name }}" alt="{{ name }}"></a></div>
						{% else %} 
						<div class="footer__logo"><a class="footer__logo-text" {{ home == og_url ? '' : 'href="' ~ home ~'"' }}>{{ text_logo }}</a></div>
						{% endif %} 
				{% endif %}
          <ul class="footer__contacts">
			{% if (technics_phones) %}
            <li><b>{{ text_technics_maintenance_phone }}</b>
			{% for key, technics_phone in technics_phones %}
				{% if (key + 1 < (technics_phones)|length) %}
				<a rel="nofollow" href="tel:{{ technics_phone[language_id]|replace({' ': '', '-': '', '(': '', ')': ''}) }}">{{ technics_phone[language_id] }}</a>,
				{% else %}
				<a rel="nofollow" href="tel:{{ technics_phone[language_id]|replace({' ': '', '-': '', '(': '', ')': ''}) }}">{{ technics_phone[language_id] }}</a>
				{% endif %}
			{% endfor %}
			</li>
			{% endif %}
            <li><b>{{ text_technics_maintenance_email }}</b>
			<a href="mailto:{{ shop_email }}">{{ shop_email }}</a>
			</li>
          </ul>
        </div>
      </footer>
	  <!-- Footer maintenance :: End-->
{% endif %} 
      <!-- Footer :: End-->
    </div>
