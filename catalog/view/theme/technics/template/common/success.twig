{{ header }} {% set col = column_left ? 9 : 12 %} {% set col = column_right ? col - 3 : col %}
	{% if (order_id is defined) %}
      <!-- Main :: Start-->
      <main class="main">
		{{ content_top }}
        <!-- System :: Start-->
        <div class="system system--success">
          <div class="container-fluid">
            <div class="row">
			{{ column_left ? '<div id="column-left" class="col-xl-3">' ~ column_left ~ '</div>' : ''}}
			<div class="col-xl-{{ col }}">
            <figure class="system__image">
					{% if (logo_success) %} 
						<img src="{{ logo_success }}" alt="{{ heading_title }}">
					{% else %} 
						<img src="/image/success_pic.png"  alt="{{ heading_title }}">
{% endif %} 
			</figure><strong class="system__title">{{ heading_title }}</strong>
            <div class="system__text">{{ text_message }}</div>
 
			</div>
			{{ column_right ? '<div id="column-right" class="col-xl-3">' ~ column_right ~ '</div>' : ''}}
            </div>
          </div>
        </div>
        <!-- System :: End-->
 
<div id="simplecheckout_step_menu">
                                                            <span class="simple-step simple-step-completed" data-onclick="gotoStep" data-step="1">Order Details</span><span class="simple-step-delimiter" data-step="2"><img src="catalog/view/image/next_green.png"></span>                                                             <span class="simple-step simple-step-completed" data-onclick="gotoStep" data-step="2">address</span><span class="simple-step-delimiter" data-step="3"><img src="catalog/view/image/next_green.png"></span>                                                             <span class="simple-step simple-step-completed" data-onclick="gotoStep" data-step="3">Confirmation</span><span class="simple-step-delimiter" data-step="4"><img src="catalog/view/image/next_green.png"></span>                                                             <span class="simple-step simple-step-completed" data-onclick="gotoStep" data-step="4">Payment</span><span class="simple-step-delimiter" data-step="5"><img src="catalog/view/image/next_green.png"></span>                                                             <span class="simple-step simple-step-current" data-onclick="gotoStep" data-step="5">Complete</span>                                                    </div>															
      </main>
      <!-- Main :: End-->
	{% else %}
      <!-- Main :: Start-->
      <main class="main">
        <!-- Breadcrumbs :: Start-->
        <div class="breadcrumbs">
          <div class="container-fluid">
            <ul class="breadcrumbs__menu">
			{% for i,breadcrumb in breadcrumbs %}
				{% if (i + 1 < (breadcrumbs)|length) %} 
				<li><a class="breadcrumbs__link" href="{{ breadcrumb['href'] }}"><span>{{ breadcrumb['text'] }}</span></a></li>
				{% else %} 
				<li>{{ breadcrumb['text'] }}</li>
				{% endif %}
			{% endfor %}
            </ul>
          </div>
        </div>
        <!-- Breadcrumbs :: End-->
		{{ content_top }}
        <!-- Page :: Start-->
        <div class="page">
          <div class="container-fluid">
            <h1 class="page__heading">{{ heading_title }}</h1>
            <div class="row">
			{{ column_left ? '<div id="column-left" class="col-xl-3">' ~ column_left ~ '</div>' : ''}}
			<div class="col-xl-{{ col }}">
				{{ text_message }} 
				<a href="{{ continue }}" class="btn btn--blue">{{ button_continue }}</a>
			</div>
			{{ column_right ? '<div id="column-right" class="col-xl-3">' ~ column_right ~ '</div>' : ''}}
            </div>
          </div>
        </div>
        <!-- Page :: End-->
		{{ content_bottom }}
      </main>
      <!-- Main :: End-->
	{% endif %}
{{ footer }}
<script>
	{% if (order_id is defined) %} 
	function send_checkout_success() {
		$(document).ready(function() {
			sendGAch("order_id={{ order_id }}",'purchase');
			sendMetrics('technics_checkout_success');
		});
	}
	document.addEventListener('DOMContentLoaded', send_checkout_success);
	{% endif %} 
</script>	
</body></html>