{% set col = column_left ? 9 : 12 %} {% set col = column_right ? col - 3 : col %} 
	<main class="content">
	{% if (column_left or column_right) %} 
	<div class="container-fluid">
		<div class="row">
 			{{ column_left ? '<div class="col-sm-3">' ~ column_left ~ '</div>' : ''}}
			<div class="col-sm-{{ col }}">
				{{ content_top }} 
				{{ content_bottom }} 
			</div>
			{{ column_right ? '<div class="col-sm-3">' ~ column_right ~ '</div>' : ''}}
		</div>	
	</div>	
	{% else %} 


<div class="container-fluid">
{{ content_top }} 

<div id="bf_banner">

</div>





<!--box CLUB NEWS-->
<div class="news_title_top_club">{{ text_title_top }}</div>
<div class="news_title_club">{{ text_title }}</div>

    <div class="swiper3 mySwiper3">
      <div class="swiper-wrapper">

{% for blog_product in blog_products %}
<div class="swiper-slide blog_product-layout blog_product-grid ">
		<div class="blog_product-thumb transition">
			<a href="{{ blog_product['href'] }}"> </a>
				<div class="image">
					<a href="{{ blog_product['href'] }}">
					{% if (not blog_product['images']) %} 
						<img {{ lazyload ? 'src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" data-src' : 'src' }}="{{ blog_product['thumb'] }}" alt="{{ blog_product['name'] }}"></a>
					{% else %}    
						<a href="{{ blog_product['href'] }}"><img data-lazy="{{ blog_product['thumb'] }}" src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" alt="{{ blog_product['name'] }}">
					{% endif %}
					</a>
				</div>
				<div class="caption">
					<div class="name"><a href="{{ blog_product['href'] }}">{{ blog_product['name'] }}</a></div>
					<div class="description">{{ blog_product['description'] }}</div>
					<div class="autor">{{ text_author }}: {{ blog_product['sku'] }}</div>
					<div class="date">{{ blog_product['date_available'] }} </div>
				</div>
		</div>
	</div>
{% endfor %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
<!-- end Latest blog -->
<a class="bttn_club"  href="{{ blog_href }}">{{ text_club_store_bttn }}</a>
<script>
      var swiper3 = new Swiper(".mySwiper3", {
        slidesPerView: 3,
        spaceBetween: 30,
		
		
 breakpoints: {
    // when window width is >= 320px
    320: {
      slidesPerView: 1,
      spaceBetween: 20
    },
    // when window width is >= 480px
    480: {
      slidesPerView: 1,
      spaceBetween: 30
    },
    // when window width is >= 640px
    640: {
      slidesPerView:3,
      spaceBetween: 40
    }
  },
        freeMode: true,
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
      });
    </script>

