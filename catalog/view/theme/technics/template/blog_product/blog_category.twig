{{ header }} {% set col = column_left ? 9 : 12 %} {% set col = column_right ? col - 3 : col %}
      <!-- Main :: Start-->
      <main class="main">
        <!-- Breadcrumbs :: Start-->
        {{ breadcrumbs_twig }}
        <!-- Breadcrumbs :: End-->

       <!-- Catalog :: Start-->
        <div class="catalog">
          <div class="container-fluid">
            <h1 class="catalog__heading">{{ heading_title }}</h1>
            <div class="row">
			{{ column_left ? '<div id="column-left" class="col-lg-3 col-left">' ~ column_left ~ '</div>' : ''}}
			<div class="col-lg-{{ col }}">
			
			{% if (blog_category_categories and categories) %}
				<!-- Category :: Start-->
				<div class="catalog__blog_category">
					<div class="blog_category__grid">
					  <div class="row">
						{% for blog_category in categories %}
						<div class="col-6 col-sm-6 col-lg-{{ blog_category_categories }}"><a class="blog_category__item" href="{{ blog_category['href'] }}">
							{% if (blog_category['thumb']) %}
							<figure class="blog_category__item-image"><img {{ lazyload ? 'src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" data-src' : 'src' }}="{{ blog_category['thumb'] }}" alt="{{ blog_category['name'] }}"></figure>
							{% endif %}
							<span class="h3 blog_category__item-title">{{ blog_category['name'] }}</span></a>
						</div>
						{% endfor %}	
					  </div>
					</div>
				</div>
				<!-- Category :: End-->
			{% endif %}	
		{% if (blog_products) %} 
		
			 
			 
				<div id="mainContainer">
<div class="row box_blog_categorywall">
  {% for blog_product in blog_products %}

                <div class="blog_product-layout blog_product-grid col-lg-4 col-md-4 col-sm-6 col-xs-12">
                   
				   <div class="blog_product-thumb transition">
                       <a href="{{ blog_product['href'] }}"> </a>
					<div class="image">
                        <a href="{{ blog_product['href'] }}">
						  {% if (not blog_product['images']) %} 
						 <img {{ lazyload ? 'src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" data-src' : 'src' }}="{{ blog_product['thumb'] }}" alt="{{ blog_product['name'] }}"></a>
						  {% else %}    
							<a href="{{ blog_product['href'] }}"><img data-lazy="{{ blog_product['thumb'] }}" src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" alt="{{ blog_product['name'] }}">
					  {% endif %}
					
						  </a>
                      </div>
                      <div class="caption">
                        <div class="name"><a href="{{ blog_product['href'] }}">{{ blog_product['name'] }}</a></div>
                        <div class="description">{{ blog_product['description'] }}</div>
                        <div class="autor">{{ text_author }}: {{ blog_product['sku'] }}</div>
                        <div class="date">{{ blog_product['date_available'] }} </div>
					</div>
                  </div>
				   
                </div>

            {% endfor %}
        </div>

				</div>
				
				{% if (pagination) %}
				<div class="container-pagination">
					{{ pagination }}
				</div>
				{% endif %}

				<input type="hidden" id="path_id" value='{{ path }}'>
				<input type="hidden" id="url" value='{{ url }}'>				 
			{% endif %}
				<!-- Seo :: Start-->
				
				{% if (description) %}
				<div class="seo">
				  <div class="container-fluid">
					<div class="row">
					  <div class="{{ col == 12 ? 'col-lg-8 offset-lg-2' : 'col-lg-12' }}">
						<div class="sea__readmore js-readmore" data-more="{{ text_readmore_more }}" data-less="{{ text_readmore_less }}">
						  <div class="editor">{{ description }}</div>
						</div>
					  </div>
					</div>
				  </div>
				</div>
				{% else %}
				<div class="seo">
				  {% if (not blog_products) %}
				  <div class="container-fluid">
					<div class="row">
					  <div class="{{ col == 12 ? 'col-lg-8 offset-lg-2' : 'col-lg-12' }}">
						<p>{{ text_empty }}</p>
					  </div>
					</div>
				  </div>
				  {% endif %}
				</div>
				{% endif %}
				<!-- Seo :: End-->
				
			</div>
			{{ column_right ? '<div id="column-right" class="col-lg-3 col-right">' ~ column_right ~ '</div>' : ''}}
            </div>
          </div>
        </div>
        <!-- Page :: End-->
		{{ content_bottom }}
      </main>
      <!-- Main :: End-->
{{ footer }}
{% if schema %} 
<!-- Schema Org :: Start-->
<script type="application/ld+json">
          {
            "@context": "http://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
			{% for i,breadcrumb in breadcrumbs %}
			{
              "@type": "ListItem",
              "position": {{ i + 1 }},
              "item": {
                "@id": "{{ breadcrumb['href'] }}",
                "name": "{{ breadcrumb['text'] }}"
              }
            }{% if (i + 1 < breadcrumbs|length) %},{% endif %}
			{% endfor %}
			]
          }
</script>
 <!-- Schema Org :: End-->
{% endif %}
</body></html>