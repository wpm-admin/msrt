							<a class="sku__slides-item article_top" href="{{ popup }}" data-fancybox="images"><img {% if (lazyload) %}src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" width="{{ image_thumb_width }}" height="{{ image_thumb_height }}" data-lazy{% else %}src{% endif %}="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}"></a>
						{% endif %}
					{% endif %}
					
	
	
	
	
	      {% if is_mobile %}
              {% else %}



<div class="dop_img_art ">	
					{% if (images) %} 
						{% for image in images %}
						 {% if image.isvideo is defined %}
