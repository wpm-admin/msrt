						  </div>
						  {% endif %}
						  <div class="products__item-desc">
							<div class="name"><a href="{{ product['href'] }}">{{ product['name'] }}</a></div>
							 <div class="description">{{ product['description'] }}</div>
							<div class="autor">{{ text_author }}: {{ product['sku'] }}</div>
							<div class="date">{{ product['date_available'] }} </div>
						  </div>
                          </div>
                        </div>
	
				
				{% endfor %}
            </div>
			{% else %}
			{% endif %}
          </div>
        </div>
        <!-- Products :: End-->
		{% endif %}

			  
 			  
		{{ blogs_related }}
			  
		  </div>		  
		  </div>		  
		  
		  
