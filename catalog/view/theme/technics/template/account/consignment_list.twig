{{ header }} {% set col = column_left ? 9 : 12 %} {% set col = column_right ? col - 3 : col %}

<div class="alerts">
	{% if success %}
	<div class="alert alert-success alert-dismissible fade show" role="alert">
		{{ success }}
		<button type="button" class="close" data-dismiss="alert" aria-label="Close">
		<svg class="icon-delete">
			<use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-delete"></use>
		</svg>
		</button>
	</div>
	{% endif %}
	{% if error_warning %}
	<div class="alert alert-danger alert-dismissible fade show" role="alert">
		{{ error_warning }}
		<button type="button" class="close" data-dismiss="alert" aria-label="Close">
		<svg class="icon-delete">
			<use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-delete"></use>
		</svg>
		</button>
	</div>
	{% endif %}
</div>

      <!-- Main :: Start-->
      <main class="main">
        <!-- Breadcrumbs :: Start-->
        <div class="breadcrumbs">
          <div class="container-fluid">
            <ul class="breadcrumbs__menu">
			{% for i,breadcrumb in breadcrumbs %}
				{% if (i + 1 < (breadcrumbs)|length) %} 
				<li><a class="breadcrumbs__link" href="{{ breadcrumb['href'] }}"><span>{{ breadcrumb['text'] }}</span></a></li>
				{% else %} 
				<li>{{ breadcrumb['text'] }}</li>
				{% endif %}
			{% endfor %}
            </ul>
          </div>
        </div>
        <!-- Breadcrumbs :: End-->
		{{ content_top }}
        <!-- Page :: Start-->
        <div class="page">
          <div class="container-fluid">
            <h1 class="page__heading">{{ heading_title }}</h1>
            <div class="row">
			{{ column_left ? '<div id="column-left" class="col-xl-3">' ~ column_left ~ '</div>' : ''}}
			<div class="col-xl-{{ col }}">
			<div class="row">
				<div class="panel panel-default">
					<div class="panel-heading">
					  <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
					</div>
					<div class="panel-body">
					  <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-consignment">
						<div class="table-responsive">
						  <table class="table table-bordered table-hover">
							<thead>
							  <tr>
								<td style="width: 1px;" class="text-center">
									<!--input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /-->
								</td>
								<td class="text-left">{% if sort == 'name' %}
								  <a href="{{ sort_name }}" class="{{ order|lower }}">{{ column_name }}</a>
								  {% else %}
								  <a href="{{ sort_name }}">{{ column_name }}</a>
								  {% endif %}</td>
								<td class="text-left">Images</td>
								<td class="text-left">Customer</td>
								<td class="text-left">Category</td>
								<td class="text-left">Model</td>
								<td class="text-left">Price</td>
								<td class="text-right" colspan="2">{{ column_action }}</td>
							  </tr>
							</thead>
							<tbody>
							  {% if consignments %}
							  {% for consignment in consignments %}
							  <tr>
								<td class="text-center">{% if consignment.consignment_id in selected %}
								  <!--input type="checkbox" name="selected[]" value="{{ consignment.consignment_id }}" checked="checked" /-->
								  {% else %}
								  <!--input type="checkbox" name="selected[]" value="{{ consignment.consignment_id }}" /-->
								  {% endif %}</td>
								
								<td class="text-left">
									{% set break = false %}
									{% for image in consignment.images if not break %}
										<img src="{{ image }}" style="width: 100px;">
										{% set break = true %}
									{% endfor %}
								</td>
								<td class="text-left">{{ consignment.name }}</td>
								<td class="text-left">{{ consignment.customer.firstname }} {{ consignment.customer.lastname }} ({{ consignment.customer.telephone }})</td>
								<td class="text-left">{{ consignment.category.name }}</td>
								<td class="text-right">{{ consignment.mark.path }} -> {{ consignment.mark.name }}</td>
								<td class="text-right">{{ consignment.price }}</td>
								<!--td class="text-right"><a href="{{ consignment.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a></td-->
								<td class="text-right"><a href="{{ consignment.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a></td>
								<td class="text-right"><a href="{{ consignment.delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-delete"><i class="fa fa-trash"></i></a></td>
							  </tr>
							  {% endfor %}
							  {% else %}
							  <tr>
								<td class="text-center" colspan="5">{{ text_no_results }}</td>
							  </tr>
							  {% endif %}
							</tbody>
						  </table>
						</div>
					  </form>
					  <div class="row">
						<a href="javascript:;" class="bttn_prod_form folder_form" data-form="consignment">Add New</a>
						<div class="col-sm-6 text-left">{{ pagination }}</div>
						<div class="col-sm-6 text-right">{{ results }}</div>
					 	<div class="col-sm-6 text-right">Ads limit <span class="ads_limit">{{ points }}</span>
					 	<button class="btn btn-primary">Кнопка Купить лимиты</button></div>
					  </div>
					</div>
				  </div>
							  
			</div>
			</div>
			{{ column_right ? '<div id="column-right" class="col-xl-3">' ~ column_right ~ '</div>' : ''}}
            </div>
          </div>
        </div>
        <!-- Page :: End-->
		{{ content_bottom }}
      </main>
	  <style>
		.ads_limit{
			padding: 10px;
			font-size: 18px;
			border: 1px solid;
			margin: 5px;
		}
	  </style>
      <!-- Main :: End-->
{{ footer }}</body></html>