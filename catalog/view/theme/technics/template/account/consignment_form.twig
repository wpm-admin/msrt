{{ header }}{% set col = column_left ? 9 : 12 %} {% set col = column_right ? col - 3 : col %}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-consignment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  	{{ content_top }}
    <!-- Page :: Start-->
    <div class="page">
      <div class="container-fluid">
        <h1 class="page__heading">{{ heading_title }}</h1>
        <div class="row">
          {{ column_left ? '<div id="column-left" class="col-xl-3">' ~ column_left ~ '</div>' : ''}}
          <div class="col-xl-{{ col }}">
            <div class="row">
		
              <div class="container-fluid">{% if error_warning %}
                <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
                  <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
                {% endif %}
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
                  </div>
                  <div class="panel-body">
                    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-consignment" class="form-horizontal">
                      <div class="form-group required" style="display: none;">
                        <label class="col-sm-2 control-label">{{ entry_name }}</label>
                        <div class="col-sm-10">
                          {% for language in languages %}
                          <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
                            <input type="text" name="consignment_description[{{ language.language_id }}][name]" value="{{ consignment_description[language.language_id] ? consignment_description[language.language_id].name }}" placeholder="{{ entry_name }}" class="form-control" />
                          </div>
                          {% if error_name[language.language_id] %}
                          <div class="text-danger">{{ error_name[language.language_id] }}</div>
                          {% endif %}
                          {% endfor %}
                        </div>
                      </div>
                  
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-sort-order">{{ column_name }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
                  </div>
                </div>
                 
                <div class="form-group" style="display: none;">
                  <label class="col-sm-2 control-label" for="input-customer"><span data-toggle="tooltip" title="Customer">Customer</span></label>
                  <div class="col-sm-10">
                    <input type="text" name="customer" value="{{ customer.firstname }} {{ customer.lastname }}" placeholder="entry customer" id="input-customer" class="form-control"/>
                    <input type="hidden" name="customer_id" value="{{ customer_id }}"/>
                  </div>
                </div>
                      
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-telephone">Telephone</label>
                  <div class="col-sm-4">
                    <input type="text" name="telephone" value="{{ telephone }}" id="input-telephone" class="form-control" />
                  </div>
                  
                  <label class="col-sm-2 control-label" for="input-email">Email</label>
                  <div class="col-sm-4">
                    <input type="text" name="email" value="{{ email }}" id="input-email" class="form-control" />
                  </div>
                </div>
                
                <div class="form-group">
                   <label class="col-sm-2 control-label" for="input-date_end">Date stop publishet</label>
                   <div class="col-sm-3">
                     <div class="input-group date">
                       <input type="text" name="date_end" value="{{ date_end }}" placeholder="" data-date-format="YYYY-MM-DD" id="input-date_end" class="form-control"/> <span class="input-group-btn">
                       <button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
                       </span></div>
                   </div>
                 </div>
             
                
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-category"><span data-toggle="tooltip" title="category">Category</span></label>
                  <div class="col-sm-10">
                    	<select name="category_id" class="form-control">
                        <!--option value="0">{{ text_part_category }}</option-->
                        {% for category in categories %}
                          {% if category.category_id == category_id %}
                            <option value="{{ category.category_id }}" selected>{{ category.name }}</option>
                          {% else %}
                            <option value="{{ category.category_id }}">{{ category.name }}</option>
                          {% endif %}
                        {% endfor %}
                      </select>
                    <!--input type="text" name="category" value="{{ category.name }}" placeholder="entry category" id="input-category" class="form-control"/>
                    <input type="hidden" name="category_id" value="{{ category_id }}"/-->
                  </div>
                </div>
                    
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-mark"><span data-toggle="tooltip" title="Mark">Mark</span></label>
                  <div class="col-sm-10">
                    <input type="text" name="mark" value="{{ mark.name }}" placeholder="entry mark" id="input-mark" class="form-control"/>
                    <input type="hidden" name="mark_id" value="{{ mark_id }}"/>
                  </div>
                </div>
                    
                <div class="form-group" style="display: none;">
                  <label class="col-sm-2 control-label" for="input-product"><span data-toggle="tooltip" title="Product">Product</span></label>
                  <div class="col-sm-8">
                    <input type="text" name="product" value="{{ product_info.name }}" placeholder="entry product" id="input-product" class="form-control"/>
                    <input type="hidden" name="product_id" value="{{ product_id }}"/>
                  </div>
                  <div class="col-sm-2">
                    {% if product_id %}
                      <a href="{{ edit_product }}" target="_blank" data-toggle="tooltip" title="Create product for consignment" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
                    {% else %}
                      <a href="{{ add_product }}" target="_blank" data-toggle="tooltip" title="Create product for consignment" class="btn btn-primary"><i class="fa fa-plus"></i></a>
                    {% endif %}
                  </div>
                </div>
                    
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-year">Year</label>
                  <div class="col-sm-10">
                    <input type="text" name="year" value="{{ year }}" placeholder="2022" id="input-year" class="form-control" />
                  </div>
                </div>
                 
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-price">Cost</label>
                  <div class="col-sm-10">
                    <input type="text" name="price" value="{{ price }}" placeholder="0.00" id="input-price" class="form-control" />
                  </div>
                </div>
                 
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-my_price">Price</label>
                  <div class="col-sm-10">
                    <input type="text" name="my_price" value="{{ my_price }}" placeholder="0.00" id="input-my_price" class="form-control" />
                  </div>
                </div>
            
                 
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-status">Status</label>
                  <div class="col-sm-10">
                    <select name="status" id="input-status" class="form-control">
                      <option value="">-- status --</option>
  
                      {% for status_id, statusa in statuses %}
                        {% if status_id == status %}
                          <option value="{{ status_id }}" selected="selected">{{ statusa }}</option>
                        {% else %}
                          <option value="{{ status_id }}">{{ statusa }}</option>
                        {% endif %}
                      {% endfor %}
  
                    </select>
                  </div>
                </div>
                 
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-description">Description</label>
                  <div class="col-sm-10">
                    <textarea name="description" rows="5" id="input-description" class="form-control">{{ description }}</textarea>
                  </div>
                </div>
            
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-images">Images</label>
                  <div class="col-sm-10 images_list">
                    {% for image in images %}
                      <div class="col-sm-3">
                        <input type="hidden" name="images[]" value="{{ image }}" id="input-images" class="form-control" />
                        <img class="add_image_list" src="{{ image }}" style="width: 100px;">
                        <a href="javascript:;" data-toggle="tooltip" title="" class="btn btn-delete delete_image" data-original-title="Delete"><i class="fa fa-trash"></i></a>
                      </div>
                    {% endfor %}
                    <div class="col-sm-3">
                      <input type="hidden" name="images[]" value="" id="input-images" class="form-control" />
                      <img class="add_image_list last" src="/image/catalog/add_foto.png" style="width: 100px;">
                    </div>
               
  
                  </div>
                </div>
            
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

</div>
<style>
  .add_image_list{
    cursor: pointer;
  }
</style>
	  <script>
      $(document).on('click', '.add_image_list', function() {
             var element = this;
             var element_img = $(this);
             var is_last = element_img.hasClass('last');
          
        
             $('#form-upload').remove();
        
             var targer = $(element).parent().find('input');//.prop('name');
          
             $('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display: none;"><input type="hidden" name="id" value="' + targer + '"><input type="file" name="file" /></form>');
        
             $('#form-upload input[name=\'file\']').trigger('click');
        
             if (typeof timer != 'undefined') {
              clearInterval(timer);
             }
          
             console.log('load');
        
             timer = setInterval(function() {
                  if ($('#form-upload input[name=\'file\']').val() != '') {
                       clearInterval(timer);
        
                       var filename = $('#form-upload input[name=\'file\']').val();
                       $.ajax({
                            url: 'index.php?route=tool/upload',
                            type: 'post',
                            dataType: 'json',
                            data: new FormData($('#form-upload')[0]),
                            cache: false,
                            contentType: false,
                            processData: false,
                            beforeSend: function() {
                                 $(element).button('loading');
                            },
                            complete: function() {
                                 $(element).button('reset');
                            },
                            success: function(json) {
                  
                            console.log(json);
                  
                            $(element).parent().find('.text-danger').remove();
                            $(element).parent().find('.text-success').remove();
                            $(element).parent().find('a').css('text-decoration','line-through');
        
                            element_img.prop('src', json.file);
        
                            if (json['error']) {
                              $(element).parent().find('input').after('<div class="text-danger">' + json['error'] + '</div>');
                            }
        
                            if (json['success']) {
                              $(element).parent().find('input').val(json.file);
                              
                              if(is_last){
                                element_img.removeClass('last');
                                element_img.parent('div').append('<a href="javascript:;" data-toggle="tooltip" title="" class="btn btn-delete delete_image" data-original-title="Delete"><i class="fa fa-trash"></i></a>');
                                
                                html = '<div class="col-sm-3">';
                                html += '<input type="hidden" name="images[]" value="" id="input-images" class="form-control" />';
                                html += '<img class="add_image_list last" src="/image/catalog/add_foto.png" style="width: 100px;">';
                                html += '</div>';
                                
                                $('.images_list').append(html);

                              }
                              
                            }
                            },
                            error: function(xhr, ajaxOptions, thrownError) {
                                 console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                            }
                       });
                  }
             }, 500);
        });
		 // Manufacturer
    $(document).on('click', '.delete_image', function(){
      $(this).parent('div').remove();
      var image = $(this).parent('div').children('input').val();
      
      $.ajax({
			  url: 'index.php?route=account/consignment/delete_image&file=' + encodeURIComponent(image),
			  dataType: 'text',
			  success: function(json) {
          console.log(json);
			  }
		  });
      
      
    });
     
  $('input[name=\'customer\']').autocomplete({
	  'source': function(request, response) {
		  $.ajax({
			  url: 'index.php?route=customer/customer/autocomplete&filter_name=' + encodeURIComponent(request),
			  dataType: 'json',
			  success: function(json) {
				  json.unshift({
					  customer_id: 0,
					  name: 'none'
				  });

				  response($.map(json, function(item) {
					  return {
						  label: item['name'],
						  value: item['customer_id']
					  }
				  }));
			  }
		  });
	  },
	  'select': function(item) {
		  $('input[name=\'customer\']').val(item['label']);
		  $('input[name=\'customer_id\']').val(item['value']);
	  }
  });

