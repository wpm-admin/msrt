          {
            "@context": "http://schema.org/",
            "@type": "Product",
            "name": "{{ heading_title }}",
            "image": [
			{% if (images_for_schema) %}
			{{ images_for_schema }}
			{% endif %} 
             ],
            "description": "{{ schema_description }}",
            "mpn": "{{ model }}",
            "sku": "{{ model }}",
            "brand": "{{ manufacturer }}",
