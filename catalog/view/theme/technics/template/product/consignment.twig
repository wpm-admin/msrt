								{% endif %}
								{% if points %}
								{{ text_points }} {{ points }}<br>
								{% endif %}
								{% if discounts %}
								{% for discount in discounts %}
								{{ discount.quantity }}{{ text_discount }}{{ discount.price }}<br>
								{% endfor %}
								{% endif %}
								</p>
							{% endif %}
						{% endif %}
                    </div>
	 		
 				
				<div class="line_consignment"><span>{{ text_mark_consign }}:</span>{{ mark_info.name }}  </div>
				<div class="line_consignment"><span>{{ text_model_consign }}:</span>{{ model_info.name }}  </div>
				<div class="line_consignment"><span>{{ text_year_consign }}:</span>{{ year }}  </div>
				<!--div class="line_consignment"><span>{{ text_engine_consign }}:</span>4900  </div-->
				
				
				<div class="contact_consignment">	
					<div class="contact_consignment_title">{{ text_title_consign }}</div>	
					<div class="contact_consignment_tel"><a href="tel:{{ telephone }}">{{ telephone }}</a> </div>				
					<div class="contact_consignment_mail"><a href="mailto:{{ email }}">{{ email }}</a></div>				
				</div>
				
				
				
				
				
			<div class="prod_text hide">
				
				<ul>
					<li><div class="prod_status">{{ stock_status }}</div>
				  </li>
					<li>{{ Condition }}: <strong>{{ condition }}</strong> </li>
					  <li>{{ text_shipping_cost }} </li>
					<!--li>{{ text_Estimated_Shipping }}:
							<select name="option" id="" class="ui-select">
								  <option value="">Check now</option>
						</select>
					  </li-->
					<li>{{ text_Payment_Options }}: </li>
					
					<li><b>ДАННЫЕ ДЛЯ ВСТАВКИ НА СТРАНИЦУ</b></li>
					<li>Марка <b>{{ mark_info.name }}</b></li>
					<li>Модель <b>{{ model_info.name }}</b></li>
					<li>Категория <b>{{ category_info.name }}</b></li>
					<li>Год <b>{{ year }}</b></li>
					<li>Цена <b>{{ price }}</b></li>
					<li>Название <b>{{ heading_title }}</b></li>
					<li>Описание <b>{{ description }}</b></li>
					<li>Телефон <b>{{ email }}</b></li>
					<li>Емаил <b>{{ telephone }}</b></li>
					<li>Самого пользователя можно вынуть из массива customer_info <b>{{ customer_info.firstname }}</b></li>
					
				</ul>
				 


</div>
		
 		

		
{% if (buy_click['status'] and not buy_btn) %} 
<a class="btn btn--dashed js-fancy-popup-cart" href="#popup-buy-click" data-for="{{ consignment_id }}" data-typefrom="consignment">{{ text_technics_buy_click }}</a>{% endif %} 
					
