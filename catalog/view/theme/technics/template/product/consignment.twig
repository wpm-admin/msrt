            <div class="row">
			{{ column_left ? '<div id="column-left" class="col-xl-3">' ~ column_left ~ '</div>' : ''}}
			<div class="col-xl-{{ col }}">
		{% endif %}
		
        <!-- SKU :: Start-->
		  <div class="container-fluid">
<h1 class="title_consignment_shema"><span class="category_info">{{ category_info.name }}</span> {{ heading_title }} <span onclick="javascript:history.back(); return false;" class="bttn_back loader"><span></span><span></span></span> </h1> 
<div class="row">
              <div class="col-md-7 col-lg-8 image_box">
              
			  
			  
 		  
			  
			  <div class="sku__gallery js-gallery" {{ images ? '' : 'style="margin-left: 0;"'}}>
					{% if (category_time and special and special_date_end) %}
							{% if (special and sales) %}
								<mark class="consignments__item-discount">{{ '<small>' ~ labelsinfo['sale']['name'][language_id] ~ '</small>' ~ discount }}</mark>
							{% endif %}
						{% endif %}
				   <div class="sku__stickers {{ category_time and special and special_date_end ? 'sku__stickers--top' : ''}}">
					{% if (isnewest) %} 
						<mark class="consignments__item-mark consignments__item-mark--new">{{ labelsinfo['new']['name'][language_id] }}</mark>
					{% endif %} 
					{% if ((special and sales) and not (category_time and special_date_end)) %}
						<mark class="consignments__item-mark consignments__item-mark--sale">{{ labelsinfo['sale']['name'][language_id] ~ ' ' ~ discount }}</mark>
					{% endif %} 
					{% if (popular) %} 
						<mark class="consignments__item-mark consignments__item-mark--popular">{{ popular }}</mark>
					{% endif %} 
					{% if (hit) %} 
						<mark class="consignments__item-mark consignments__item-mark--hit">{{ hit }}</mark>
					{% endif %} 
					{% if (catch) %} 
						{% if (nocatch) %}
							<mark class="consignments__item-mark consignments__item-mark--nocatch">{{ catch }}</mark>
						{% else %} 
							<mark class="consignments__item-mark consignments__item-mark--catch">{{ catch }}</mark>
						{% endif %} 
					{% endif %} 
					{% if (reward) %} 
						<mark class="consignments__item-mark consignments__item-mark--reward">{{ text_reward }} {{ reward }}</mark>
					{% endif %} 
					</div>
			 
					<div class="sku__slides js-gallery-slides">
					{% if (thumb) %}
