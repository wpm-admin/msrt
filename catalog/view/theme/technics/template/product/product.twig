                          <p class="sku__brand"><a href="{{ manufacturers }}"><span>{{ manufacturer }}</span></a></p>
						{% endif %}

				
			 
 
						  
						  
                        </div>
                      </div>
                    </div>
					{% if (options or recurrings) %}
