				//Показать выделенное
				$(document).on('click', '.bttn_sel_show', function(){
					
					$('.coord_list').hide();
					
					$( '.product_list input[type="checkbox"]:checked' ).each(function( index ) {
						
						//Отмечаем метки на карте
						var row = $( this ).data('row');
						
						$('.ul-product_list .row'+row).show();
						
						$('.arr_row'+row+' div').css('opacity', 0.5);
						/*
						$('.arr_row'+row).css('background-color', '#8E0000');
                        $('.arr_row'+row).css('color', 'white');
                        */
					});
					
					
				});
				
				//Убрать все выделенное
				$(document).on('click', '.bttn_sel_clear', function(){
					
					//Очищаем карту
					$('.arr_row'+' div').css('opacity', 0);
					/*
					$('.arr_row').css('background-color', '#fff');
                    $('.arr_row').css('color', '#8E0000');
                    */
					
					//Очищаем таблицу
					$('.coord_list input[type="text"]').val(0);
					$('.coord_list input[type="checkbox"]').prop('checked', false);
					
					$('.coord_list').show();
					
					$('.select_item_text').html('');
					$('#button-cart2').attr('disabled', true);
					
				});
				
				//Пересчет выбранного количества и суммы
				function reload_cart(){
					
					url = ''
					
					$( '.product_list input[type="checkbox"]:checked' ).each(function( index ) {
						
						//соберем строку на отправку
						var product_id = $( this ).val();
						var value = $( '.product_list input[name="product_list['+product_id+']"]' ).val();
						
						url = url + '&product['+product_id+']='+value;
						
					});
					
					$.ajax({
						url: 'index.php?route=checkout/cart/cart_calculater'+url,
						dataType: 'json',
						success: function (json) {
							console.log(json);
							
							$('.select_item_text').html('<strong>'+json.product_total+' Parts‚</strong> Price '+json.total_format+' (Exc VAT) ');
							
							$('#button-cart2').attr('disabled', false);
							
							if(json.product_total == 0){
								$('#button-cart2').attr('disabled', true);
							}
						},
					});
					
					
				}
								
				$('.select_model').keyup(function(){
					
					$('.stock_rows').hide();
					var value = $( this ).val();
					
					$( ".ul-product_list .prod_list_col2" ).each(function( index ) {
						
						var text = $( this ).html();
						
						if(text.toUpperCase().indexOf(value.toUpperCase()) != -1){
							$(this).parent('li').show();
						}
						
					});
					
				});
				
				$('.select_name').keyup(function(){
					
					$('.stock_rows').hide();
					var value = $( this ).val().toUpperCase();
					
					$( ".ul-product_list .prod_list_col6 a" ).each(function( index ) {
						
						var text = $( this ).html().toUpperCase();
						
						if(text.indexOf(value) != -1){
							$(this).parents('li').show();
						}
						
					});
					
				});
				
				$(document).on('change', '.select_stock_statuses', function(){
					
					if($(this).val() > 0){
						$('.stock_rows').hide();
					
						$('.stock_row_'+$(this).val()).show();
					}else{
						$('.stock_rows').show();
					}
				});
				
				$(document).on('change', '.select_condition_statuses', function(){
					
					if($(this).val() > 0){
						$('.condition_rows').hide();
					
						$('.condition_row_'+$(this).val()).show();
					}else{
						$('.condition_rows').show();
					}
				});
				
				$(document).on('change', '.select_manufacturers', function(){
					
					if($(this).val() > 0){
						$('.manuf_rows').hide();
					
						$('.manuf_row_'+$(this).val()).show();
					}else{
						$('.manuf_rows').show();
					}
				});
				
				
                  function addToCartList(){
                     $( '.ul-product_list input[type="checkbox"]:checked' ).each(function( index ) {
                        //console.log($( this ).val() );
                     
                        datapr = 'product_id='+$( this ).val()+'&quantity='+$( 'input[name="product_list['+$( this ).val()+']"' ).val();
                     
                        $.ajax({
                              url: 'index.php?route=checkout/cart/add',
                              type: 'post',
                              data: datapr,
                              dataType: 'json',
                              beforeSend: function() {
                                    $('#button-cart2').button('loading');
                              },
                              complete: function() {
                                    $('#button-cart2').button('reset');
                              },
                              success: function(json) {
                                    $('.alert, .ui-error').remove();
                                    $('[id^="input-option"],.ui-field').removeClass('is-error');
                  
                                    if (json['error']) {
                                          if (json['error']['option']) {
                                                for (i in json['error']['option']) {
                                                      var element = $('#input-option' + i.replace('_', '-'));
                  
                                                      if (element.parent().hasClass('ui-select')) {
                                                            element.parent().after('<span class="error ui-error">' + json['error']['option'][i] + '</span>').parent().addClass('is-error');
                                                      } else if (element.hasClass('ui-input') || element.hasClass('ui-textarea')) {
                                                            element.after('<svg class="icon-error"><use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-error"></use></svg><span class="error ui-error">' + json['error']['option'][i] + '</span>').parent().addClass('is-error');
                                                      } else {
                                                            element.after('<span class="error ui-error">' + json['error']['option'][i] + '</span>').addClass('is-error');
                                                      }
                                                }
                                          }
                  
                                          if (json['error']['recurring']) {
                                                $('select[name=\'recurring_id\']').parent().after('<span class="error ui-error">' + json['error']['recurring'] + '</span>').parent().addClass('is-error');
                                          }
                  
                                    }
                  
                                    if (json['success']) {
                                          cartExrtaElem(json['total']);
                                          
                                          if ($('.js-cart-call').length) {
                                                $('.js-cart-call>button').trigger('click');
                                          } else {
                                                $('.alerts').append($('<div class="alert alert-success alert-dismissible fade show" role="alert"> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert" aria-label="Close"><svg class="icon-delete"><use xlink:href="catalog/view/theme/technics/sprites/sprite.svg#icon-delete"></use></svg></button></div>'));
                                          }
                                          $('#cart-total').html('<mark class="cart__counter" id="cart-total"> ' + json['total'] + '</mark>');
                  
                                          sendYM('technics_addtocart_product');
                                          sendGA(datapr,'technics_addtocart_product');
                                          
                                          $('#cart .cart__body').load('index.php?route=common/cart/info div.cart__scroll',function(){
                                                $('#cart input[type=\'number\']').styler();
                                          });
                                    }
                              },
                         });
                        
                     });
                     
                  }
                  

				  
                  //Клик на списке иконок
                  $(document).on('click', '.arr_row', function(e){
                        var row = $(this).data('row');
                        var val = $('.ul-product_list .'+row+' .product_list_q').val();
                        $('.ul-product_list .'+row+' .product_list_q').val(parseInt(val) + 1);
                        $('.ul-product_list .'+row+' input[type="checkbox"]').first().prop('checked', true);
						
						reload_cart();
