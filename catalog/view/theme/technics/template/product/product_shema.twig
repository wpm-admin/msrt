								html2 += '	 <td class="table_arr_row_txtbox">{{ text_Cond }}</td>';
								html2 += '	 <td class="table_arr_row_txtbox">{{ text_stock2 }}</td>';
								html2 += '	 <td class="table_arr_row_txtbox">{{ tab_description }}</td>';
								html2 += '	 <td class="table_arr_row_txtbox">{{ text_Price2 }}</td>';
								html2 += '	 <td></td>';
								html2 += '  </tr><tr>';
								html2 += '	 <td>{{ product.model }}</td>';
								html2 += '	 <td>{{ manufacturer_list[product.manufacturer_id].name }}</td>';
								html2 += '	 <td>{{ product.condition }}</td>';
								html2 += '	 <td><div class="products__item-stickers stickers_{{ product.stock_status_id }}">{{  product.stock  }}</div></td>';
								html2 += '	 <td>{{ product.name }}</td>';
								html2 += '	 <td>{{ product.price }}</td>';
								html2 += '	 <td><input type="checkbox"></td>';
								html2 += '  </tr></table>';
								
								
								//Если элемента нет - добавим
								if(!$('.arr_row{{ product.num }}').length){
									$('.top_image').parent('div').append(html);
									$('.coordinate_info').append(html2);
								}
							
								$('.arr_row{{ product.num }}').css('top', (imgHeight/10000*(imgHeightP-y))+'px');
								$('.arr_row{{ product.num }}').css('left', (imgWidth/10000*(imgWidthP-x))+'px');
								$('.arr_row{{ product.num }}').css('display', 'inline-block');
								
								//console.log('---- '+(imgHeight/10000*(imgHeightP-150))+'px');
								
							{% endif %}
                        {% endfor %}
				  }
				  {% endif %}
              </script>
              
              
