				  var image_scale = 1;
				  
				  function make_points(x, y){
					
						//$('.arr_row').remove();
					
						imgWidth = $('.top_image').width() * image_scale;
                        imgHeight = $('.top_image').height() * image_scale;
                        
						console.log(image_scale);
						//console.log(imgWidth);
						
                        {% for product in coordinate_products %}
                          
							{% if product.x and product.y %}
								imgHeightP = {{ product.y }} * 100;
								imgWidthP = {{ product.x }} * 100;
								
					 			//console.log(imgHeight+' '+imgWidthP+' '+imgHeightP);
						
								html = '';
								html += '<div class="arr_row arr_row{{ product.num }}" data-row="row{{ product.num }}"><div>{# product.num #}</div>';
								html += '</div>';
								
								
								html2 = '  <table class="table_arr_row table_arr_row{{ product.num }}"><tr>';
								html2 += '	 <td rowspan="2"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}"></td>';
								html2 += '	 <td class="table_arr_row_txtbox">{{ text_Part_Number }}</td>';
