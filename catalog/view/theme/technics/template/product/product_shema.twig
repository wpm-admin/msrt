                        $('.arr_row').css('background-color', '#fff');
                        $('.arr_row').css('color', '#8E0000');
                        
                        $('.arr_'+row).css('background-color', '#8E0000');
                        $('.arr_'+row).css('color', 'white');
						*/
						
						$('.arr_row'+' div').css('opacity', 0);
						$('.arr_'+row+' div').css('opacity', 0.5);
						make_selected();
                  });
                  
                  //Уход со списка товаров
