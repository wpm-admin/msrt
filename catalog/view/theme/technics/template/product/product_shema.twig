$("#zoom-plus").on('click', function(){

    let zoomStep = 0.5;
    //let img = $('.thumb_coordiname img')
    let img = $('#thumb_coordiname');
    let currentScale = parseFloat(img.attr('data-current-scale'));
    let newScale = currentScale + zoomStep;
    
    if (isNaN(currentScale))
    {
        img.css('transform', 'scale('+ (1 + zoomStep) +')').attr('data-current-scale', 1 + zoomStep);
    }
    else
    {
        img.css('transform', 'scale('+ newScale +')').attr('data-current-scale', newScale);
    }
	image_scale += zoomStep;
	//make_points(150, 150);
});


$("#zoom-minus").on('click', function(){

    let zoomStep = 0.5;
    //let img = $('.thumb_coordiname img')
    let img = $('#thumb_coordiname');
    let currentScale = parseFloat(img.attr('data-current-scale'));
    let newScale = currentScale - zoomStep;

    if (currentScale === zoomStep) {return false;};
    
    if (isNaN(currentScale))
    {
        img.css('transform', 'scale('+ (1 - zoomStep) +')').attr('data-current-scale', 1 - zoomStep);
    }
    else
    {
        img.css('transform', 'scale('+ newScale +')').attr('data-current-scale', newScale);
    }
	
	image_scale -= zoomStep;
	if(image_scale < 0.5) image_scale = 0.5;
	//make_points(150, 150);

});

