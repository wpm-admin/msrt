									<span class="prod_list_col1">{{ product.num }}</span>
									<span class="prod_list_col2">{{ product.model }}</span>
									<span class="prod_list_col3">{{ manufacturer_list[product.manufacturer_id].name }}</span>
									<span class="prod_list_col4">{{ product.condition }}</span>
