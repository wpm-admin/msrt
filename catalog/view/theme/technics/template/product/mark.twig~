{{ header }} {% set col = column_left ? 9 : 12 %} {% set col = column_right ? col - 3 : col %}
      <!-- Main :: Start-->
      <main class="main">
				
        <!-- Breadcrumbs :: Start-->
        {# breadcrumbs_twig #}
				<div class="breadcrumbs select_bread">
          <div class="container-fluid">
            <div class="filter_wrapper">
              <select name="filter_mark" id="filter_mark" class="filter_row">
                {% for row in breadcrumbs['1']['breadList'] %}
                  {% if breadcrumbs['1']['href'] == row['href'] %}
                    <option value="{{ row['href'] }}" selected>{{ row['name'] }}</option>
                  {% else %}	
                    <option value="{{ row['href'] }}">{{ row['name'] }}</option>
                  {% endif %}
                {% endfor %}
              </select>
               
              <select name="filter_model" id="filter_model" class="filter_row">
                {% for row in breadcrumbs['2']['breadList'] %}
                  {% if breadcrumbs['2']['href'] == row['href'] %}
                    <option value="{{ row['href'] }}" selected>{{ row['name'] }}</option>
                  {% else %}	
                    <option value="{{ row['href'] }}">{{ row['name'] }}</option>
                  {% endif %}
                {% endfor %}
              </select>
               
              <!--select name="filter_category" id="filter_category" class="filter_row">
								<option value="0" selected></option>
                {% for row in categories %}
                  {% if breadcrumbs['3']['href'] == row['href'] %}
                    <option value="{{ row['href'] }}" selected>{{ row['name'] }}</option>
                  {% else %}	
                    <option value="{{ row['href'] }}">{{ row['name'] }}</option>
                  {% endif %}
                {% endfor %}
              </select-->
							<select name="filter_diagram" id="filter_diagram" class="filter_row">
								{% for row in products %}
									{% if row['active'] %}
										<option value="{{ row['href'] }}" selected>{{ row['name'] }}</option>
									{% else %}	
										<option value="{{ row['href'] }}">{{ row['name'] }}</option>
									{% endif %}
								{% endfor %}
							</select>              
              <script>
                $(document).on('change', '.filter_row', function(){
                  if($(this).val()){
                    location.href = $(this).val();
                  }
                });	
              </script>
            </div>
          </div>
        </div>
				
        <!-- Breadcrumbs :: End-->
				

	<div class="container-fluid">

{{ content_top }}
  </div>

            {# Сам скрипт лежит в футере #}
						{#
            <a href="javascript:;" id="zoom-plus" class="show_as_diagram {% if show_as_diagram %}active{% endif %}">{{ text_show_as_diagram }}</a>
            <a href="javascript:;" id="zoom-minus" class="unshow_as_diagram {% if not show_as_diagram %}active{% endif %}">{{ text_unshow_as_diagram }}</a>
						#}
						
<!-- Catalog :: Start-->
        <div class="catalog">
          <div class="container-fluid">
						
						 <!--<h1 class="catalog__heading">{{ heading_title }}</h1>-->
            <div class="row">
							{{ column_left ? '<div id="column-left" class="col-lg-3 col-left">' ~ column_left ~ '</div>' : ''}}
							<div class="col-lg-{{ col }}">
							
								{% if (mark_marks and marks) %}
									<!-- Mark :: Start-->
									<div class="catalog__mark">
										<div class="mark__grid">
											<div class="row">
											{% for mark in marks %}
											<div class="col-6 col-sm-6 col-lg-{{ mark_marks }}"><a class="mark__item" href="{{ mark['href'] }}">
												{% if (mark['thumb']) %}
												<figure class="mark__item-image"><img {{ lazyload ? 'src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" data-src' : 'src' }}="{{ mark['thumb'] }}" alt="{{ mark['name'] }}"></figure>
												{% endif %}
												<span class="h3 mark__item-title">{{ mark['name'] }}</span></a>
											</div>
											{% endfor %}	
											</div>
										</div>
									</div>
									<!-- Mark :: End-->
								{% endif %}	
 	 
							{% if (products) %} 
		
			          <div id="mainContainer">
                <div class="row box_categorywall">
                  {% for product in products %}
  
                  <div class="product-layout product-grid col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="product-thumb transition">
                        <div class="image">
                          <a href="{{ product['href'] }}" style="padding-bottom: 100%">
                              <img {{ lazyload ? 'src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" data-src' : 'src' }}="{{ product['thumb'] }}" alt="{{ product['name'] }}"></a>
                              
                              {#
                            {% if (not product['images']) %} 
                              <img {{ lazyload ? 'src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" data-src' : 'src' }}="{{ product['thumb'] }}" alt="{{ product['name'] }}"></a>
                            {% else %}    
                              <a href="{{ product['href'] }}"><img data-lazy="{{ product['thumb'] }}" src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" alt="{{ product['name'] }}">
                            {% endif %}
                            #}
                          </a>
                        </div>
                        <div class="caption">
                          <div class="name"><a href="{{ product['href'] }}">{{ product['name'] }}</a></div>
                        </div>
                    </div>
                  </div>

                  {% endfor %}
                </div>

              </div>
				
								{% if (pagination) %}
								<!--div class="container-pagination">
									{{ pagination }}
								</div-->
								{% endif %}
						{% endif %}
						
						
						
								{{ content_bottom }}

							<div class="seo_block">
								{{ description }}
							</div>

							</div>
								{{ column_right ? '<div id="column-right" class="col-lg-3 col-right">' ~ column_right ~ '</div>' : ''}}
            </div>
          </div>
        </div>
        <!-- Page :: End-->
      </main>
      <!-- Main :: End-->
{{ footer }}
{% if schema %} 
<!-- Schema Org :: Start-->
<script type="application/ld+json">
          {
            "@context": "http://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
			{% for i,breadcrumb in breadcrumbs %}
			{
              "@type": "ListItem",
              "position": {{ i + 1 }},
              "item": {
                "@id": "{{ breadcrumb['href'] }}",
                "name": "{{ breadcrumb['text'] }}"
              }
            }{% if (i + 1 < breadcrumbs|length) %},{% endif %}
			{% endfor %}
			]
          }
</script>
 <!-- Schema Org :: End-->
{% endif %}
</body></html>