 {{ header }} {% set col = column_left ? 9 : 12 %} {% set col = column_right ? col - 3 : col %}
      <!-- Main :: Start-->
      <main class="main category_store">
        <!-- Auction Filter :: Start-->

<div class="auction-filter">
          <div class="container-fluid">
            <div class="filter_wrapper">
              <select name="filter_mark" id="filter_mark" class="filter_row">
                <option value="{{ all_brands_href }}">{{ text_all_brands }}</option>
                {% for mark in marks %}
                  {% if mark.mark_id == selected_mark_id %}
                    <option value="{{ mark.href }}" selected>{{ mark.name }}</option>
                  {% else %}
                    <option value="{{ mark.href }}">{{ mark.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              <script>
                $(document).on('change', '.filter_row', function(){
                  if($(this).val()){
                    location.href = $(this).val();
                  }
                });
              </script>
            </div>
          </div>
        </div>

        <!-- Auction Filter :: End-->
		{{ content_top }}
       <!-- Catalog :: Start-->
        <div class="catalog catalog__auctions">
          <div class="container-fluid">
            <h1 class="catalog__heading">{{ heading_title }} <span onclick="javascript:history.back(); return false;" class="bttn_back loader"><span></span><span></span></span></h1>


<div class="text_title_select_category">{{ text_title_select_category }}</div>
			
 			
			
            <div class="row">
			 
			<div class="col-lg-12">
			
			{% if (category_categories and categories) %}
				<!-- Category :: Start-->
				<div class="catalog__category">
					<div class="category__grid">
					  <div class="row">
						{% for category in categories %}
						<div class="col-6 col-sm-6 col-lg-{{ category_categories }}"><a class="category__item" href="{{ category['href'] }}">
							<span class="h3 category__item-title">{{ category['name'] }}</span>
{% if (category['thumb']) %}
							<figure class="category__item-image"><img {{ lazyload ? 'src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" data-src' : 'src' }}="{{ category['thumb'] }}" alt="{{ category['name'] }}"></figure>
							{% endif %}
</a>
						</div>
						{% endfor %}	
					  </div>
					</div>
				</div>
				<!-- Category :: End-->
			{% endif %}	
		{% if (products) %} 
		
 
			
				<div id="mainContainer">

							{{ productslist }}
 
				</div>
				
				{% if (pagination) %}
				<div class="container-pagination">
					{{ pagination }}
				</div>
				{% endif %}

				<input type="hidden" id="path_id" value='{{ path }}'>
				<input type="hidden" id="url" value='{{ url }}'>				 
			{% endif %}
				
    {% if (products) %}
      <div class="box_search_links">
       <div class="box_search_links_title">{{ text_title_parts }}  </div>
       <div class="box_search_links_parts">
        <a href="/maserati/">{{ text_title_parts_1 }}</a>
        <a href="{{ club_href }}">{{ text_title_parts_4 }}</a>
       </div>
      </div>
  {% endif %}
				<!-- Seo :: Start-->
				
				{% if (description) %}
				<div class="seo">
				  <div class="container-fluid">
					<div class="row">
					  <div class="{{ col == 12 ? 'col-lg-8 offset-lg-2' : 'col-lg-12' }}">
						<div class="sea__readmore js-readmore" data-more="{{ text_readmore_more }}" data-less="{{ text_readmore_less }}">
						  <div class="editor">{{ description }}</div>
						</div>
					  </div>
					</div>
				  </div>
				</div>
				{% endif %}
				<!-- Seo :: End-->
				
			
			 

  {% if (not products) %}
     <div class="box_search_links">
      <div class="box_search_links_title">{{ text_title_parts_auctions }}  </div>
      <div class="box_search_links_parts">
       <a href="/maserati/">{{ text_title_parts_1 }}</a>
       <a href="{{ club_href }}">{{ text_title_parts_4 }}</a>
      </div>
     </div>
		{% endif %}


</div>

</div>
          </div>
        </div>
        <!-- Page :: End-->
		{{ content_bottom }}
      </main>
      <!-- Main :: End-->
{{ footer }}
{% if schema %} 
<!-- Schema Org :: Start-->
<script type="application/ld+json">
          {
            "@context": "http://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
			{% for i,breadcrumb in breadcrumbs %}
			{
              "@type": "ListItem",
              "position": {{ i + 1 }},
              "item": {
                "@id": "{{ breadcrumb['href'] }}",
                "name": "{{ breadcrumb['text'] }}"
              }
            }{% if (i + 1 < breadcrumbs|length) %},{% endif %}
			{% endfor %}
			]
          }
</script>
 <!-- Schema Org :: End-->
{% endif %}
</body></html>