				<div class="options options--mobile">
				  <div class="row">
					<div class="col-sm-6">
					  <div class="options__type js-options">
						<button class="options__btn options__btn--arrow js-options-btn">{{ text_sort }} {{ sort_title }}</button>
						<ul class="options__dropdown">
						{% for sortData in sorts %}
						{% if (sortData['value'] == sort ~ '-' ~ order) %}
						  <li class="js-options-item is-active" data-href="{{ sortData['href'] }}">{{ text_sort }} {{ sortData['text'] }}</li>
						  {% else %} 
						  <li class="js-options-item" data-href="{{ sortData['href'] }}">{{ text_sort }} {{ sortData['text'] }}</li>
						  {% endif %}
						{% endfor %}
						</ul>
					  </div>
					</div>
				  </div>
				</div>
				<!-- Options :: End-->
			
				<div id="mainContainer">
					{{ productsview }}
				</div>
				
				{% if (pagination) %}
				<div class="container-pagination">
					{{ pagination }}
				</div>
				{% endif %}

				<input type="hidden" id="path_id" value='{{ path }}'>
				<input type="hidden" id="url" value='{{ url }}'>				 
			{% endif %}
				<!-- Seo :: Start-->
				
				{% if (description) %}
				<div class="seo">
				  <div class="container-fluid">
					<div class="row">
					  <div class="{{ col == 12 ? 'col-lg-8 offset-lg-2' : 'col-lg-12' }}">
						<div class="sea__readmore js-readmore" data-more="{{ text_readmore_more }}" data-less="{{ text_readmore_less }}">
						  <div class="editor">{{ description }}</div>
						</div>
					  </div>
					</div>
				  </div>
				</div>
				{% endif %}
				<!-- Seo :: End-->
	
				{% if (not products) %}
					<div class="box_search_links">
						<div class="box_search_links_title">{{ text_title_parts }}  </div>
						<div class="box_search_links_parts">
							<a href="/maserati/">{{ text_title_parts_1 }}</a>
							<a href="/auctions/">{{ text_title_parts_3 }}</a>
						</div>
					</div>
				{% endif %}

			</div>

			</div>
          </div>
        </div>
        <!-- Page :: End-->
		{{ content_bottom }}
      </main>
      <!-- Main :: End-->
{{ footer }}
{% if schema %} 
<!-- Schema Org :: Start-->
<script type="application/ld+json">
          {
            "@context": "http://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
			{% for i,breadcrumb in breadcrumbs %}
			{
              "@type": "ListItem",
              "position": {{ i  }},
              "item": {
                "@id": "{{ breadcrumb['href'] }}",
                "name": "{{ breadcrumb['text'] }}"
              }
            }{% if (i < breadcrumbs|length) %},{% endif %}
			{% endfor %}
			]
          }
</script>
 <!-- Schema Org :: End-->
{% endif %}
</body></html>