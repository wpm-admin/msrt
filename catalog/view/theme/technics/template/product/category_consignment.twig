 {{ header }} {% set col = column_left ? 9 : 12 %} {% set col = column_right ? col - 3 : col %}
      <!-- Main :: Start-->
      <main class="main category_store">
        <!-- Breadcrumbs :: Start-->

       <div class="breadcrumbs select_bread">
                <div class="container-fluid">
      
      
         <div class="filter_wrapper">
      
          <select name="filter_category" id="filter_category" class="filter_row">
           {% for row in breadcrumbs['1']['breadList'] %}
            {% if row['active'] %}
             <option value="{{ row['href'] }}" selected>{{ row['name'] }}</option>
            {% else %}	
             <option value="{{ row['href'] }}">{{ row['name'] }}</option>
            {% endif %}
           {% endfor %}
          </select>
           
           {% if breadcrumbs['2'] %}
          <select name="filter_mark" id="filter_mark" class="filter_row">
           {% for row in breadcrumbs['2']['breadList'] %}
            {% if row['active'] %}
             <option value="{{ row['href'] }}" selected>{{ row['name'] }}</option>
            {% else %}	
             <option value="{{ row['href'] }}">{{ row['name'] }}</option>
            {% endif %}
           {% endfor %}
          </select>
         {% endif %}
         
         {% if breadcrumbs['3'] %}
          <select name="filter_model" id="filter_model" class="filter_row">
           {% for row in breadcrumbs['3']['breadList'] %}
            {% if row['active'] %}
             <option value="{{ row['href'] }}" selected>{{ row['name'] }}</option>
            {% else %}	
             <option value="{{ row['href'] }}">{{ row['name'] }}</option>
            {% endif %}
           {% endfor %}
          </select>
          {% endif %}
      
          <script>
           $(document).on('change', '.filter_row', function(){
            location.href = $(this).val();	
           });	
          </script>
         </div>
          </div>
        </div>

        <!-- Breadcrumbs :: End-->
		{{ content_top }}
       <!-- Catalog :: Start-->
        <div class="catalog">
          <div class="container-fluid">
            <h1 class="catalog__heading">{{ heading_title }} <span onclick="location = '{{ consignment_href }}'" class="bttn_back loader"><span></span><span></span></span></h1>


			<div class="text_title_select_category">{{ text_title_select_category }}</div>
			
 			
			
            <div class="row">
			 
			<div class="col-lg-12">
			
			{% if (category_categories and categories) %}
				<!-- Category :: Start-->
				<div class="catalog__category">
					<div class="category__grid">
					  <div class="row">
						{% for category in categories %}
						<div class="col-6 col-sm-6 col-lg-{{ category_categories }}">
							<a class="category__item" href="{{ category['href'] }}">
								<span class="h3 category__item-title">{{ category['name'] }}</span>
								{% if (category['thumb']) %}
								<figure class="category__item-image"><img {{ lazyload ? 'src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" data-src' : 'src' }}="{{ category['thumb'] }}" alt="{{ category['name'] }}"></figure>
								{% endif %}
							</a>
						</div>
						{% endfor %}	
					  </div>
					</div>
				</div>
				<!-- Category :: End-->
			{% endif %}	
		{% if true or products %} 
		
				<!-- Options :: Start-->
				<!--div class="options options--desktop">
