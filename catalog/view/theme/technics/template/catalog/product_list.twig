      <div class="col-xs-12">
        <div class="panel panel-default">
          <div class="panel-body">
            <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-product">
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                    <tr>
                      <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                      <td class="text-left">{% if sort == 'p.product_id' %} <a href="{{ sort_product_id }}" class="{{ order|lower }}">ID</a> {% else %} <a href="{{ sort_product_id }}">ID</a> {% endif %}</td>
                      
                      <td class="text-center" data-name="product_image" {% if cols.image == 0 %} style="display: none;" {% endif %}>{{ column_image }}</td>
                      
                      <td class="text-left" {% if cols.name == 0 %} style="display: none;" {% endif %}>{% if sort == 'pd.name' %} <a href="{{ sort_name }}" class="{{ order|lower }}">{{ column_name }}</a> {% else %} <a href="{{ sort_name }}">{{ column_name }}</a> {% endif %}</td>
                     <td class="text-left" {% if cols.description == 0 %} style="display: none;" {% endif %}>Description</td>
                     <td class="text-left" {% if cols.manufacturer == 0 %} style="display: none;" {% endif %}>{% if sort == 'md.name' %} <a href="{{ sort_manufacturer }}" class="{{ order|lower }}">{{ column_manufacturer }}</a> {% else %} <a href="{{ sort_manufacturer }}">{{ column_manufacturer }}</a> {% endif %}</td>
                     <td class="text-left" {% if cols.category == 0 %} style="display: none;" {% endif %}>{% if sort == 'cd.name' %} <a href="{{ sort_category }}" class="{{ order|lower }}">{{ column_category }}</a> {% else %} <a href="{{ sort_category }}">{{ column_category }}</a> {% endif %}</td>
                     
                     <td class="text-left" {% if cols.uom == 0 %} style="display: none;" {% endif %}>
                       {% if sort == 'p.uom' %}
                        <a href="{{ sort_uom }}" class="{{ order|lower }}">UOM</a>
                       {% else %}
                       <a href="{{ sort_uom }}">UOM</a>
                      {% endif %}
                     </td>
                     
                     <td class="text-left" {% if cols.availability == 0 %} style="display: none;" {% endif %}>
                       {% if sort == 'p.stock_status_id' %}
                        <a href="{{ sort_uom }}" class="{{ order|lower }}">Availability</a>
                       {% else %}
                       <a href="{{ sort_uom }}">Availability</a>
                      {% endif %}
                     </td>
                     
                     <td class="text-left" {% if cols.dimensions == 0 %} style="display: none;" {% endif %}>
                       {% if sort == 'p.uom' %}
                        <a href="{{ sort_uom }}" class="{{ order|lower }}">Dimensions</a>
                       {% else %}
                       <a href="{{ sort_uom }}">Dimensions</a>
                      {% endif %}
                     </td>
                     
                     <td class="text-left" {% if cols.sales_tax == 0 %} style="display: none;" {% endif %}>
                       {% if sort == 'p.uom' %}
                        <a href="{{ sort_uom }}" class="{{ order|lower }}">Sales tax</a>
                       {% else %}
                       <a href="{{ sort_uom }}">Sales tax</a>
                      {% endif %}
                     </td>
                     
                     <td class="text-left" {% if cols.condition == 0 %} style="display: none;" {% endif %}>
                       {% if sort == 'p.uom' %}
                        <a href="{{ sort_uom }}" class="{{ order|lower }}">Condition</a>
                       {% else %}
                       <a href="{{ sort_uom }}">Condition</a>
                      {% endif %}
                     </td>
                     
                   <td class="text-left" {% if cols.weight == 0 %} style="display: none;" {% endif %}>
                       {% if sort == 'p.uom' %}
                        <a href="{{ sort_weight }}" class="{{ order|lower }}">Weight</a>
                       {% else %}
                       <a href="{{ sort_weight }}">Weight</a>
                      {% endif %}
                     </td>
                     
                   
                     
                     
                     <td class="text-left" {% if cols.mark == 0 %} style="display: none;" {% endif %}>{% if sort == 'mode.name' %} <a href="{{ sort_mark }}" class="{{ order|lower }}">{{ column_mark }}</a> {% else %} <a href="{{ sort_mark }}">{{ column_mark }}</a> {% endif %}</td>
                      <td class="text-left" {% if cols.code_manual == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.model' %} <a href="{{ sort_model }}" class="{{ order|lower }}">{# column_model #}{{ entry_model }}</a> {% else %} <a href="{{ sort_model }}">{{ entry_model }}{# column_model #}</a> {% endif %}</td>
                      <td class="text-left" {% if cols.fishbowl == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.sku' %} <a href="{{ sort_sku }}" class="{{ order|lower }}">{{ entry_sku }}{# column_sku #}</a> {% else %} <a href="{{ sort_sku }}">{{ entry_sku }}{# column_sku #}</a> {% endif %}</td>
                      <td class="text-right" {% if cols.cost == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.cost' %} <a href="{{ sort_cost }}" class="{{ order|lower }}">Cost</a> {% else %} <a href="{{ sort_cost }}">Cost</a> {% endif %}</td>
                       <td class="text-right" {% if cols.price == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.price' %} <a href="{{ sort_price }}" class="{{ order|lower }}">{{ column_price }}</a> {% else %} <a href="{{ sort_price }}">{{ column_price }}</a> {% endif %}</td>
                      <td class="text-right" {% if cols.quantity == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.quantity' %} <a href="{{ sort_quantity }}" class="{{ order|lower }}">{{ column_quantity }}</a> {% else %} <a href="{{ sort_quantity }}">{{ column_quantity }}</a> {% endif %}</td>
                      <td class="text-left" {% if cols.status == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.status' %} <a href="{{ sort_status }}" class="{{ order|lower }}">{{ column_status }}</a> {% else %} <a href="{{ sort_status }}">{{ column_status }}</a> {% endif %}
                      <br>
                       <select name="change_status" id="change-status" class="form-control"
                       form="form-product" formaction="{{ update }}" data-toggle="tooltip" onChange="confirm('{{ text_confirm }}') ? $('#form-product').submit() : false;" data-original-title="Update"><i class="fa fa-trash-o"></i></button>
                       >
                         <option value="">change status</option>
                           {% if filter_status == '1' %}
                             <option value="1" selected="selected">{{ text_enabled }}</option>
                           {% else %}
                             <option value="1">{{ text_enabled }}</option>
                           {% endif %}
                           {% if filter_status == '0' %}
                             <option value="0" selected="selected">{{ text_disabled }}</option>
                           {% else %}
                             <option value="0">{{ text_disabled }}</option>
                           {% endif %}
                       </select>
                      </td>
                      <td class="text-left" {% if cols.sort_order == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.sort_order' %} <a href="{{ sort_order }}" class="{{ order|lower }}">{{ column_order }}</a> {% else %} <a href="{{ sort_order }}">{{ column_order }}</a> {% endif %}</td>
                      <td class="text-right">{{ column_action }}</td>
                    </tr>
                  </thead>
                  <tbody>
                  
                  {% if products %}
                  {% for product in products %}
                  <tr id="{{ product.product_id }}" class="product_row">
                    <td class="text-center">{% if product.product_id in selected %}
                      <input type="checkbox" name="selected[]" value="{{ product.product_id }}" checked="checked" />
                      {% else %}
                      <input type="checkbox" name="selected[]" value="{{ product.product_id }}" />
                      {% endif %}</td>
                    <td class="text-left">{{ product.product_id }}</td>
                    <td class="text-center" data-name="image" {% if cols.image == 0 %} style="display: none;" {% endif %}>
                      {% if product.image %} <img src="{{ product.image }}" alt="{{ product.name }}" class="img-thumbnail" /> {% else %} <span class="img-thumbnail list"><i class="fa fa-camera fa-2x"></i></span> {% endif %}
                    </td>
                    <td class="text-left pointer111" data-name="name" {% if cols.name == 0 %} style="display: none;" {% endif %}>{{ product.name }}</td>
                    <td class="text-left pointer111" data-name="description"  {% if cols.description == 0 %} style="display: none;max-width: 30%;" {% endif %}>{{ product.description }}</td>
                    <td class="text-left pointer111" data-name="manufacturer_id" {% if cols.manufacturer == 0 %} style="display: none;" {% endif %} >{{ product.manufacturer_name }}{{ product.manufacturer }}</td>
                    <td class="text-left pointer111 category_tree" {% if cols.category == 0 %} style="display: none;" {% endif %}>{{ product.category }}</td>
                    <td class="text-left" {% if cols.uom == 0 %} style="display: none;" {% endif %}>{{ product.uom }}</td>
                    <td class="text-left" {% if cols.availability == 0 %} style="display: none;" {% endif %}>{{ product.availability }}</td>
                    <td class="text-left" {% if cols.dimensions == 0 %} style="display: none;" {% endif %}>{{ product.dimensions }}</td>
                    <td class="text-left" {% if cols.sales_tax == 0 %} style="display: none;" {% endif %}>{{ product.sales_tax }}</td>
                    <td class="text-left" {% if cols.condition == 0 %} style="display: none;" {% endif %}>{{ product.condition }}</td>
                    <td class="text-left" {% if cols.weight == 0 %} style="display: none;" {% endif %}>{{ product.weight }}</td>
                    <td class="text-left pointer111 mark_tree" {% if cols.mark == 0 %} style="display: none;" {% endif %}>{{ product.mark }}</td>
                    <td class="text-left" {% if cols.code_manual == 0 %} style="display: none;" {% endif %}>{{ product.model }}</td>
                   <td class="text-left" {% if cols.fishbowl == 0 %} style="display: none;" {% endif %}>{{ product.sku }}</td>
                    <td class="text-left pointer111" data-name="cost" {% if cols.cost == 0 %} style="display: none;" {% endif %}>{{ product.cost }}</td>
                    <td class="text-right pointer111" data-name="price" {% if cols.price == 0 %} style="display: none;" {% endif %}>{% if product.special %} <span style="text-decoration: line-through;">{{ product.price }}</span><br/>
                      <div class="text-danger">{{ product.special }}</div>
                      {% else %}
                      {{ product.price }}
                      {% endif %}</td>
                    <td class="text-right pointer111" data-name="quantity" {% if cols.quantity == 0 %} style="display: none;" {% endif %}>{% if product.quantity <= 0 %} <span class="label label-warning">{{ product.quantity }}</span> {% elseif product.quantity <= 5 %} <span class="label label-danger">{{ product.quantity }}</span> {% else %} <span class="label label-success">{{ product.quantity }}</span> {% endif %}</td>
                    <td class="text-left pointer111" data-name="status" {% if cols.status == 0 %} style="display: none;" {% endif %} >{{ product.status }}</td>
                    <td class="text-left" {% if cols.sort_order == 0 %} style="display: none;" {% endif %}>{{ product.sort_order }}</td>
                    <td class="text-right"><a href="{{ product.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a></td>
                  </tr>
                  {% endfor %}
                  {% else %}
                  <tr>
                    <td class="text-center" colspan="8">{{ text_no_results }}</td>
                  </tr>
                  {% endif %}
                    </tbody>
                  
                </table>
              </div>
            </form>
            
            
            <div class="row">
              <div class="col-sm-6 text-left">{{ pagination }}</div>
              <div class="col-sm-6 text-right">{{ results }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	var url = '';

	var filter_name = $('input[name=\'filter_name\']').val();

	if (filter_name) {
		url += '&filter_name=' + encodeURIComponent(filter_name);
	}

	var filter_model = $('input[name=\'filter_model\']').val();

	if (filter_model) {
		url += '&filter_model=' + encodeURIComponent(filter_model);
	}

	var filter_price = $('input[name=\'filter_price\']').val();

	if (filter_price) {
		url += '&filter_price=' + encodeURIComponent(filter_price);
	}

	var filter_quantity = $('input[name=\'filter_quantity\']').val();

	if (filter_quantity) {
		url += '&filter_quantity=' + encodeURIComponent(filter_quantity);
	}

	var filter_status = $('select[name=\'filter_status\']').val();

	if (filter_status !== '') {
		url += '&filter_status=' + encodeURIComponent(filter_status);
	}

	var filter_diagram = $('select[name=\'filter_diagram\']').val();

	if (filter_diagram !== '') {
		url += '&filter_diagram=' + encodeURIComponent(filter_diagram);
	}

var filter_sku = $('input[name=\'filter_sku\']').val();

	if (filter_sku) {
		url += '&filter_sku=' + encodeURIComponent(filter_sku);
	}

  
var filter_manufacturer = $('select[name=\'filter_manufacturer\']').val();

	if (filter_manufacturer !== '') {
		url += '&filter_manufacturer=' + encodeURIComponent(filter_manufacturer);
	}

var filter_category = $('select[name=\'filter_category\']').val();

	if (filter_category !== '') {
		url += '&filter_category=' + encodeURIComponent(filter_category);
	}

var filter_mark = $('select[name=\'filter_mark\']').val();

	if (filter_mark !== '') {
		url += '&filter_mark=' + encodeURIComponent(filter_mark);
	}

	location = 'index.php?route=catalog/product&user_token={{ user_token }}' + url;
});
//--></script> 
  <script type="text/javascript"><!--
// IE and Edge fix!
$('button[form=\'form-product\']').on('click', function(e) {
	$('#form-product').attr('action', $(this).attr('formaction'));
});
  
$('#change-status').on('click, focus', function(e) {
 $('#form-product').attr('action', $(this).attr('formaction'));
  console.log($('#form-product').attr('action'));
});
  
$('input[name=\'filter_name\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['product_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'filter_name\']').val(item['label']);
	}
});

$('input[name=\'filter_model\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_model=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['model'],
						value: item['product_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'filter_model\']').val(item['label']);
	}
});
//--></script>
