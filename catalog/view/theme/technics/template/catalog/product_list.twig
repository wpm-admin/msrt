{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right" style="z-index: 10000;position: relative;">
        <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-product').toggleClass('hidden-sm hidden-xs');" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
        <!--a href="javascript:;" data-toggle="tooltip" title="columns" class="btn btn-primary columns"><i class="fa fa-list-ul"></i></a-->
       
        <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
        <button type="submit" form="form-product" formaction="{{ copy }}" data-toggle="tooltip" title="{{ button_copy }}" class="btn btn-default"><i class="fa fa-copy"></i></button>
        <button type="button" form="form-product" formaction="{{ delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-product').submit() : false;"><i class="fa fa-trash-o"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  
  
  <div class="text-left my_category_wrapper">
    <div class="tree_wrapper_my">
      <input type="hidden" name="category_product_id" value="">    
      <p><a href="javascript:;" id="tree-expand-all">show tree</a> | <a href="javascript:;" id="tree-collapse-all">hide tree</a> | <a href="javascript:;" id="tree-clouse-all">close</a></p>
      <ul id="tree">
        {% for index,level in my_categories %}
          <li><a href="javascript:;" id="{{ level.category_id }}">{{ level.name }}</a>
            {% if level.parent %}
              <ul>
              {% for index1,level1 in level.parent %}
                <li><a href="javascript:;" id="{{ level1.category_id }}">{{ level1.name }}</a>
                  {% if level1.parent %}
                    <ul>
                    {% for index2,level2 in level1.parent %}
                      <li><a href="javascript:;" id="{{ level2.category_id }}">{{ level2.name }}</a>
                      {% if level2.parent %}
                        <ul>
                        {% for index3,level3 in level2.parent %}
                          <li><a href="javascript:;" id="{{ level3.category_id }}">{{ level3.name }}</a>
  
                        {% endfor %}
                        </ul>
                      {% endif %}
                  {% endfor %}
                    </ul>
                  {% endif %}
              {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}  
      </ul>
    </div>
  </div>
  
 <div class="text-left my_mark_wrapper">
    <div class="tree_wrapper_my">
      <input type="hidden" name="mark_product_id" value="">    
      <p><a href="javascript:;" id="tree-expand-all">show tree</a> | <a href="javascript:;" id="tree-collapse-all">hide tree</a> | <a href="javascript:;" id="tree-clouse-all">close</a></p>
      <ul id="tree_mark">
        {% for index,level in my_marks %}
          <li><a href="javascript:;" id="{{ level.mark_id }}">{{ level.name }}</a>
            {% if level.parent %}
              <ul>
              {% for index1,level1 in level.parent %}
                <li><a href="javascript:;" id="{{ level1.mark_id }}">{{ level1.name }}</a>
                  {% if level1.parent %}
                    <ul>
                    {% for index2,level2 in level1.parent %}
                      <li><a href="javascript:;" id="{{ level2.mark_id }}">{{ level2.name }}</a>
                      {% if level2.parent %}
                        <ul>
                        {% for index3,level3 in level2.parent %}
                          <li><a href="javascript:;" id="{{ level3.mark_id }}">{{ level3.name }}</a>
  
                        {% endfor %}
                        </ul>
                      {% endif %}
                  {% endfor %}
                    </ul>
                  {% endif %}
              {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}  
      </ul>
    </div>
  </div>
  
  
  <div class="container-fluid">{% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
