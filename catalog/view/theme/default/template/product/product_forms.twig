		<!-- contact_form -->
		<div class="popup popup-container popup-contact_form">
            <form action="{{ add }}" method="post" enctype="multipart/form-data" class="add_garage_form">
            <div class="row">
                  <div class="col-xl-12">
						<div class="personal__action">
							<a href="javascript:;" class="btn button_close_form"> </a>
						</div>
                  </div>
                       
