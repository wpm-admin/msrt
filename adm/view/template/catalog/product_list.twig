        type: 'post',
        dataType: 'html',
        beforeSend: function () {
          $('tr#'+product_id+' .mark_tree').html('saving . . .');
        },
        success: function (json) {
          console.log(json);
          $('tr#'+product_id+' .mark_tree').html(json);
        },
      });      
   
    });
    
   $(document).on('click', '.my_category_wrapper ul a', function(){
      
      var product_id = $('input[name="category_product_id"]').val();
      var category_id = $(this).attr('id');
   
      console.log(product_id+' '+category_id);
   
      $.ajax({
        url: 'index.php?route=catalog/product_edit/category_save&user_token={{ user_token }}&category_id='+category_id+'&product_id='+product_id,
        type: 'post',
        dataType: 'html',
        beforeSend: function () {
          $('tr#'+product_id+' .category_tree').html('saving . . .');
        },
        success: function (json) {
          console.log(json);
          $('tr#'+product_id+' .category_tree').html(json);
        },
      });      
   
    });
    
    
    $(document).on('click', '.mark_tree', function(){
      
      if($(this).hasClass('selected')){
        
        $('.my_mark_wrapper').hide();
        $('.mark_tree').removeClass('selected');

      }else{
      
        $('.my_mark_wrapper').show();
        $('.mark_tree').removeClass('selected');

        $(this).addClass('selected');
        $('input[name="mark_product_id"]').val($(this).parent('tr').attr('id'));    

      }
      
    });
    $(document).on('click', '.category_tree', function(){
      
      if($(this).hasClass('selected')){
        
        $('.my_category_wrapper').hide();
        $('.category_tree').removeClass('selected');

      }else{
      
        $('.my_category_wrapper').show();
        $('.category_tree').removeClass('selected');

        $(this).addClass('selected');
        $('input[name="category_product_id"]').val($(this).parent('tr').attr('id'));    

      }
  
    });
    $(document).on('click', '.my_mark_wrapper #tree-clouse-all', function(){
      $('.my_mark_wrapper').hide();
      $('.mark_tree').removeClass('selected');
    });
    $(document).on('click', '.my_category_wrapper #tree-clouse-all', function(){
      $('.my_category_wrapper').hide();
      $('.category_tree').removeClass('selected');
    });
