                                   </select></td>
                                   <td><input type="text" name="vendor[model]" value="" class="form-control"></td>
                                   <td><input type="text" name="vendor[sku]" value="" class="form-control"></td>
                                   <td><input type="text" name="vendor[uom]" value="" class="form-control"></td>
                                   <td><input type="text" name="vendor[cost]" value="0" class="form-control"></td>
                                   <td><input type="text" name="vendor[qty]" value="0" class="form-control">
                                   <input type="hidden" name="vendor[status]" value="1" class="form-control"></td>
                               </tr>
                           </tbody>
                        </table>
                        <div class="input-group " style="min-width:100%;">
                         <input type="hidden" name="redirect" value="{{ redirect }}">
                         <input type="radio" name="operation" value="add" class=""> add vendor<br>
                         <input type="radio" name="operation" value="update" class="" checked> replace vendor
                         <input type="button" name="save" value="save" class="form-control vendors_mas_save modal_save" style="background-color: #b0bef3;"
                         form="form-product" formaction="{{ update_vendor }}" data-toggle="tooltip" data-original-title="Update"
                         >
                         <input type="button" name="close" value="close" class="form-control header_modal_close" style="background-color: #f3ebb0;"></div>
                    </div>
                    
                     </td-->
              
                     <td class="text-left" {% if cols.category == 0 %} style="display: none;" {% endif %}>{% if sort == 'cd.name' %} <a href="{{ sort_category }}" class="{{ order|lower }}">{{ column_category }}</a> {% else %} <a href="{{ sort_category }}">{{ column_category }}</a> {% endif %}</td>
                     
                     <td class="text-left" {% if cols.uom == 0 %} style="display: none;" {% endif %}>
                       {% if sort == 'p.uom' %}
                        <a href="{{ sort_uom }}" class="{{ order|lower }}">UOM</a>
                       {% else %}
                       <a href="{{ sort_uom }}">UOM</a>
                      {% endif %}
                     </td>
                     
                     <td class="text-left" {% if cols.availability == 0 %} style="display: none;" {% endif %}>
                       {% if sort == 'p.stock_status_id' %}
