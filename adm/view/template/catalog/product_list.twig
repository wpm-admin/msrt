{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-product').toggleClass('hidden-sm hidden-xs');" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
        <a href="javascript:;" data-toggle="tooltip" title="columns" class="btn btn-primary columns"><i class="fa fa-list-ul"></i></a>
        <div class="cols_wrapper">
         <ul>
          {% for col, index in cols %}
          <li><input type="checkbox" name="cols[{{ col }}]" value="1" {% if index %} checked="checked" {% endif %} /> {{ col }}</li>
          {% endfor %}
         </ul>
        </div>
        <style>
         .cols_wrapper{
           position: absolute;
           z-index: 100;
           background: white;
           padding: 15px;
           border: 2px solid;
           display: none;
         }
         .cols_wrapper ul{
          margin: 0;
          padding: 0;
         }
         .cols_wrapper li{
          list-style-type: none;
         }
        </style>
        <script>
         $(document).on('click', '.columns', function(){
           console.log($('.cols_wrapper').css('display'));
           
           if($('.cols_wrapper').css('display') == 'none'){
            $('.cols_wrapper').css('display', 'block');
           }else{
            $('.cols_wrapper').css('display', 'none');
            
            $.ajax({
             url: 'index.php?route=catalog/product/cols&user_token={{ user_token }}',
             type: 'post',
             data: $('.cols_wrapper input:checked'),
             dataType: 'html',
              success: function (json) {
               console.log(json);
               location.reload();
             },
           }); 
           }
           
           
         });
        </script>
        <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
        <button type="submit" form="form-product" formaction="{{ copy }}" data-toggle="tooltip" title="{{ button_copy }}" class="btn btn-default"><i class="fa fa-copy"></i></button>
        <button type="button" form="form-product" formaction="{{ delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-product').submit() : false;"><i class="fa fa-trash-o"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  
  
  <div class="text-left my_category_wrapper">
    <div class="tree_wrapper_my">
      <input type="hidden" name="category_product_id" value="">    
      <p><a href="javascript:;" id="tree-expand-all">show tree</a> | <a href="javascript:;" id="tree-collapse-all">hide tree</a> | <a href="javascript:;" id="tree-clouse-all">close</a></p>
      <ul id="tree">
        {% for index,level in my_categories %}
          <li><a href="javascript:;" id="{{ level.category_id }}">{{ level.name }}</a>
            {% if level.parent %}
              <ul>
              {% for index1,level1 in level.parent %}
                <li><a href="javascript:;" id="{{ level1.category_id }}">{{ level1.name }}</a>
                  {% if level1.parent %}
                    <ul>
                    {% for index2,level2 in level1.parent %}
                      <li><a href="javascript:;" id="{{ level2.category_id }}">{{ level2.name }}</a>
                      {% if level2.parent %}
                        <ul>
                        {% for index3,level3 in level2.parent %}
                          <li><a href="javascript:;" id="{{ level3.category_id }}">{{ level3.name }}</a>
  
                        {% endfor %}
                        </ul>
                      {% endif %}
                  {% endfor %}
                    </ul>
                  {% endif %}
              {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}  
      </ul>
    </div>
  </div>
  
 <div class="text-left my_mark_wrapper">
    <div class="tree_wrapper_my">
      <input type="hidden" name="mark_product_id" value="">    
      <p><a href="javascript:;" id="tree-expand-all">show tree</a> | <a href="javascript:;" id="tree-collapse-all">hide tree</a> | <a href="javascript:;" id="tree-clouse-all">close</a></p>
      <ul id="tree_mark">
        {% for index,level in my_marks %}
          <li><a href="javascript:;" id="{{ level.mark_id }}">{{ level.name }}</a>
            {% if level.parent %}
              <ul>
              {% for index1,level1 in level.parent %}
                <li><a href="javascript:;" id="{{ level1.mark_id }}">{{ level1.name }}</a>
                  {% if level1.parent %}
                    <ul>
                    {% for index2,level2 in level1.parent %}
                      <li><a href="javascript:;" id="{{ level2.mark_id }}">{{ level2.name }}</a>
                      {% if level2.parent %}
                        <ul>
                        {% for index3,level3 in level2.parent %}
                          <li><a href="javascript:;" id="{{ level3.mark_id }}">{{ level3.name }}</a>
  
                        {% endfor %}
                        </ul>
                      {% endif %}
                  {% endfor %}
                    </ul>
                  {% endif %}
              {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}  
      </ul>
    </div>
  </div>
  
  
  <div class="container-fluid">{% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="row">
      <div id="filter-product" class="col-xs-12 hidden-sm hidden-xs">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
          </div>
          <div class="panel-body row">
            <div class="form-group col-xs-3">
              <label class="control-label" for="input-name">{{ entry_name }} or description</label>
              <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
            </div>
            <div class="form-group col-xs-2">
              <label class="control-label" for="input-model">{{ entry_model }}</label>
              <input type="text" name="filter_model" value="{{ filter_model }}" placeholder="{{ entry_model }}" id="input-model" class="form-control" />
            </div>
           <div class="form-group col-xs-2">
              <label class="control-label" for="input-sku">{{ entry_sku }}</label>
              <input type="text" name="filter_sku" value="{{ filter_sku }}" placeholder="{{ entry_sku }}" id="input-sku" class="form-control" />
            </div>
            <div class="form-group col-xs-2">
              <label class="control-label" for="input-price">{{ entry_price }}</label>
              <input type="text" name="filter_price" value="{{ filter_price }}" placeholder="{{ entry_price }}" id="input-price" class="form-control" />
            </div>
             <div class="form-group col-xs-2">
              <label class="control-label" for="input-status">{{ entry_status }}</label>
              <select name="filter_status" id="input-status" class="form-control">
                <option value=""></option>
                  {% if filter_status == '1' %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                  {% else %}
                    <option value="1">{{ text_enabled }}</option>
                  {% endif %}
                  {% if filter_status == '0' %}
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% else %}
                    <option value="0">{{ text_disabled }}</option>
                  {% endif %}
              </select>
            </div>
           <div class="form-group col-xs-1">
              <label class="control-label" for="input-quantity">{{ entry_quantity }}</label>
              <input type="text" name="filter_quantity" value="{{ filter_quantity }}" placeholder="{{ entry_quantity }}" id="input-quantity" class="form-control" />
            </div>
    
            <div class="form-group col-xs-3">
              <label class="control-label" for="input-manufacturer">{{ entry_manufacturer }}</label>
              <select name="filter_manufacturer" id="input-manufacturer" class="form-control">
                <option value=""></option>
                {% for manufacturer in manufacturers %}
                  {% if filter_manufacturer == manufacturer.manufacturer_id %}
                    <option value="{{ manufacturer.manufacturer_id }}" selected="selected">{{ manufacturer.name }}</option>
                  {% else %}
                    <option value="{{ manufacturer.manufacturer_id }}">{{ manufacturer.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="form-group col-xs-2">
              <label class="control-label" for="input-category">{{ entry_category }}</label>
              <select name="filter_category" id="input-category" class="form-control">
                <option value=""></option>
                {% for category in categories %}
                  {% if filter_category == category.category_id %}
                    <option value="{{ category.category_id }}" selected="selected">{{ category.name }}</option>
                  {% else %}
                    <option value="{{ category.category_id }}">{{ category.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
            
           <!--div class="form-group col-xs-2">
              <label class="control-label" for="input-vendor">Vendor</label>
              <select name="filter_vendor" id="input-vendor" class="form-control">
                <option value=""></option>
                {% for vendor in vendors %}
                  {% if filter_vendor == vendor.vendor_id %}
                    <option value="{{ vendor.vendor_id }}" selected="selected">{{ vendor.name }}</option>
                  {% else %}
                    <option value="{{ vendor.vendor_id }}">{{ vendor.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
            </div-->
           <!--  <div class="form-group col-xs-2">
              <label class="control-label" for="input-customer_id">Customer products</label>
              <select name="filter_customer_id" id="input-customer_id" class="form-control">
                <option value="0">-- My Products --</option>
                {% for customer in customers %}
                  {% if filter_customer_id == customer.customer_id %}
                    <option value="{{ customer.customer_id }}" selected="selected">{{ customer.firstname }} {{ customer.lastname }}</option>
                  {% else %}
                    <option value="{{ customer.customer_id }}">{{ customer.firstname }} {{ customer.lastname }}</option>
                  {% endif %}
                {% endfor %}
              </select>
            </div> -->
            <div class="form-group col-xs-2">
              <label class="control-label" for="input-mark">Mark-Model</label>
              <select name="filter_mark" id="input-mark" class="form-control">
                <option value=""></option>
                {% for mark in marks %}
                  {% if filter_mark == mark.mark_id %}
                    <option value="{{ mark.mark_id }}" selected="selected">{{ mark.name }}</option>
                  {% else %}
                    <option value="{{ mark.mark_id }}">{{ mark.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="form-group col-xs-2">
              <label class="control-label" for="input-diagram">Is diagram {{ filter_diagram }}+</label>
              <select name="filter_diagram" id="input-diagram" class="form-control">
                <option value="-1"></option>
                  {% if filter_diagram == '1' %}
                    <option value="1" selected="selected">{{ text_yes }}</option>
                  {% else %}
                    <option value="1">{{ text_yes }}</option>
                  {% endif %}
                  {% if filter_diagram == '0' %}
                    <option value="0" selected="selected">{{ text_no }}</option>
                  {% else %}
                    <option value="0">{{ text_no }}</option>
                  {% endif %}
              </select>
            </div>
  
          <div class="form-group text-right col-xs-1">
              <button type="button" id="button-filter" class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter }}</button>
            </div>
          </div>
        </div>
      </div>
      <div class="col-xs-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
            <select name="select_limit" id="select_limit" class="form-control" style="width: 200px;float: right;">
                <option value="5" selected="selected">Select page limit rows</option>
                {% for ind, row in limits %}
                  {% if ind == limit_value %}
                    <option value="{{ ind }}" selected="selected">{{ row }}</option>
                  {% else %}
                    <option value="{{ ind }}">{{ row }}</option>
                  {% endif %}
                {% endfor %}
              </select>
          </div>
          <script>
           $(document).on('change', '#select_limit', function(){
            var value = $(this).val();
            $.ajax({
             url: 'index.php?route=catalog/product/session&user_token={{ user_token }}&name=product_limit&value=' +  encodeURIComponent(value),
             success: function (json) {
              //console.log(json);
              location.reload();
             },
            });
           });
          </script>
          <div class="panel-body">
            <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-product">
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
