    $(document).on('click', '.my_mark_wrapper ul a', function(){
      
      var product_id = $('input[name="mark_product_id"]').val();
      var mark_id = $(this).attr('id');
   
      console.log(product_id+' '+mark_id);
   
      $.ajax({
