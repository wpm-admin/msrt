                      <td class="text-left" {% if cols.fishbowl == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.sku' %} <a href="{{ sort_sku }}" class="{{ order|lower }}">{{ entry_sku }}{# column_sku #}</a> {% else %} <a href="{{ sort_sku }}">{{ entry_sku }}{# column_sku #}</a> {% endif %}</td>
                      <td class="text-right" {% if cols.cost == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.cost' %} <a href="{{ sort_cost }}" class="{{ order|lower }}">Cost</a> {% else %} <a href="{{ sort_cost }}">Cost</a> {% endif %}</td>
                       <td class="text-right" {% if cols.price == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.price' %} <a href="{{ sort_price }}" class="{{ order|lower }}">{{ column_price }}</a> {% else %} <a href="{{ sort_price }}">{{ column_price }}</a> {% endif %}</td>
                      <td class="text-right" {% if cols.quantity == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.quantity' %} <a href="{{ sort_quantity }}" class="{{ order|lower }}">{{ column_quantity }}</a> {% else %} <a href="{{ sort_quantity }}">{{ column_quantity }}</a> {% endif %}</td>
                      <td class="text-left" {% if cols.status == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.status' %} <a href="{{ sort_status }}" class="{{ order|lower }}">{{ column_status }}</a> {% else %} <a href="{{ sort_status }}">{{ column_status }}</a> {% endif %}
                      <br>
                       <select name="change_status" id="change-status" class="form-control"
                       form="form-product" formaction="{{ update }}" data-toggle="tooltip" onChange="confirm('{{ text_confirm }}') ? $('#form-product').submit() : false;" data-original-title="Update"
                       >
                         <option value="">change status</option>
                           {% if filter_status == '1' %}
                             <option value="1" selected="selected">{{ text_enabled }}</option>
                           {% else %}
                             <option value="1">{{ text_enabled }}</option>
                           {% endif %}
                           {% if filter_status == '0' %}
                             <option value="0" selected="selected">{{ text_disabled }}</option>
                           {% else %}
                             <option value="0">{{ text_disabled }}</option>
                           {% endif %}
                       </select>
                      </td>
                      <td class="text-left" {% if cols.sort_order == 0 %} style="display: none;" {% endif %}>{% if sort == 'p.sort_order' %} <a href="{{ sort_order }}" class="{{ order|lower }}">{{ column_order }}</a> {% else %} <a href="{{ sort_order }}">{{ column_order }}</a> {% endif %}</td>
                      <td class="text-right">{{ column_action }}</td>
                    </tr>
                  </thead>
                  <tbody>
                  
                  {% if products %}
                  {% for product in products %}
                  <tr id="{{ product.product_id }}" class="product_row">
                    <td class="text-center">{% if product.product_id in selected %}
                      <input type="checkbox" name="selected[]" value="{{ product.product_id }}" checked="checked" />
                      {% else %}
                      <input type="checkbox" name="selected[]" value="{{ product.product_id }}" />
                      {% endif %}</td>
                    <td class="text-left">{{ product.product_id }}</td>
                    <td class="text-center" data-name="image" {% if cols.image == 0 %} style="display: none;" {% endif %}>
                      <!--{%
                      if product.image %} <img src="{{ product.image }}" alt="{{ product.name }}" class="img-thumbnail" /> {% else %} <span class="img-thumbnail list"><i class="fa fa-camera fa-2x"></i></span> {% endif %}
                      -->
                    <a href="" id="thumb-image-{{ product.product_id }}" data-toggle="image" class="img-thumbnail"><img src="{{ product.image }}" alt="" title="" data-placeholder="{{ placeholder }}"/></a>
                    <input type="hidden" name="product[image]" value="{{ product.href_image }}" id="input-image-{{ product.product_id }}"/>
                    <span class="modal_save" data-name="image" style="display: none;"></span>
                    
                    </td>
                    <td class="text-left pointer" data-name="name" {% if cols.name == 0 %} style="display: none;" {% endif %}>{{ product.name }}</td>
                    <td class="text-left pointer" data-name="description"  {% if cols.description == 0 %} style="display: none;max-width: 30%;" {% endif %}>{{ product.description }}</td>
                    <td class="text-left pointer" data-name="manufacturer_id" {% if cols.manufacturer == 0 %} style="display: none;" {% endif %} >{{ product.manufacturer_name }}{{ product.manufacturer }}</td>
                   <!--td class="text-left pointer " data-name="vendors" {% if cols.vendor == 0 %} style="display: none;" {% endif %} >
                    {% for vendor in product.vendors %}
                     {{ vendor.name }}<br>
                    {% endfor %}
                   </td-->
                    <td class="text-left pointer category_tree" {% if cols.category == 0 %} style="display: none;" {% endif %}>{{ product.category }}</td>
                    <td class="text-left pointer" data-name="uom" {% if cols.uom == 0 %} style="display: none;" {% endif %}>{{ product.uom }}</td>
                    <td class="text-left pointer" data-name="stock_status_id" {% if cols.availability == 0 %} style="display: none;" {% endif %}>{{ product.availability }}</td>
                    <td class="text-left pointer" data-name="dimensions" {% if cols.dimensions == 0 %} style="display: none;" {% endif %}>{{ product.dimensions }}</td>
                    <td class="text-left pointer" data-name="tax_class_id" {% if cols.sales_tax == 0 %} style="display: none;" {% endif %}>{{ product.sales_tax }}</td>
                    <td class="text-left pointer" data-name="condition_status_id" {% if cols.condition == 0 %} style="display: none;" {% endif %}>{{ product.condition }}</td>
                    <td class="text-left pointer" data-name="weight" {% if cols.weight == 0 %} style="display: none;" {% endif %}>{{ product.weight }}</td>
                    <td class="text-left pointer mark_tree" {% if cols.mark == 0 %} style="display: none;" {% endif %}>{{ product.mark }}</td>
                    <td class="text-left pointer" data-name="model" {% if cols.code_manual == 0 %} style="display: none;" {% endif %}>{{ product.model }}</td>
                   <td class="text-left pointer" data-name="sku" {% if cols.fishbowl == 0 %} style="display: none;" {% endif %}>{{ product.sku }}</td>
                    <td class="text-left pointer" data-name="cost" {% if cols.cost == 0 %} style="display: none;" {% endif %}>{{ product.cost }}</td>
                    <td class="text-right pointer" data-name="price" {% if cols.price == 0 %} style="display: none;" {% endif %}>{% if product.special %} <span style="text-decoration: line-through;">{{ product.price }}</span><br/>
                      <div class="text-danger">{{ product.special }}</div>
                      {% else %}
                      {{ product.price }}
                      {% endif %}</td>
                    <td class="text-right pointer" data-name="quantity" {% if cols.quantity == 0 %} style="display: none;" {% endif %}>{% if product.quantity <= 0 %} <span class="label label-warning">{{ product.quantity }}</span> {% elseif product.quantity <= 5 %} <span class="label label-danger">{{ product.quantity }}</span> {% else %} <span class="label label-success">{{ product.quantity }}</span> {% endif %}</td>
                    <td class="text-left pointer" data-name="status" {% if cols.status == 0 %} style="display: none;" {% endif %} >{{ product.status }}</td>
                    <td class="text-left pointer" data-name="sort_order" {% if cols.sort_order == 0 %} style="display: none;" {% endif %}>{{ product.sort_order }}</td>
                    <td class="text-right"><a href="{{ product.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a></td>
                  </tr>
                  {% endfor %}
                  {% else %}
                  <tr>
                    <td class="text-center" colspan="8">{{ text_no_results }}</td>
                  </tr>
                  {% endif %}
                    </tbody>
                  
                </table>
              </div>
            </form>
