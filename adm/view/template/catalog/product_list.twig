                       {% else %}
                       <a href="{{ sort_uom }}">Availability</a>
                      {% endif %}
                     </td>
                     
                     <td class="text-left" {% if cols.dimensions == 0 %} style="display: none;" {% endif %}>
                       {% if sort == 'p.uom' %}
                        <a href="{{ sort_uom }}" class="{{ order|lower }}">Dimensions</a>
                       {% else %}
                       <a href="{{ sort_uom }}">Dimensions</a>
                      {% endif %}
                     </td>
                     
                     <td class="text-left" {% if cols.sales_tax == 0 %} style="display: none;" {% endif %}>
