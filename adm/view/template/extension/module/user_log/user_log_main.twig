{{ header }}{{ column_left }} 
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
			<a class="btn btn-primary" title="" data-toggle="tooltip" href="{{ view_log }}" data-original-title="{{ button_view_log }}"><i class="fa fa-eye"></i></a>
      </div>
	
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %} 
        <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
        {% endfor %} 
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if (error_warning) %} 
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} 
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %} 
	{% if (success) %} 
	<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
		<button type="button" class="close" data-dismiss="alert">&times;</button>
	</div>
	{% endif %} 
  <nav class="navbar navbar-default">
	<div class="container-fluid">
		<div class="nav navbar-nav navbar-left">
			{% for nav in navs %}
			<a href="{{ nav['href'] }}" class="btn btn-default navbar-btn {{ nav['active'] }}">{{ nav['text'] }}</a>
			{% endfor %}
		</div>
	</div>
  </nav>  
    <div class="panel panel-default">
		<div class="panel-heading">
			<h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
		</div>
		<div class="panel-body">
			<ul class="nav nav-tabs" id="user_log_tabs">
				<li><a href="#tab-settings" data-toggle="tab">{{ tab_settings }}</a></li>
				<li><a href="#tab-help" data-toggle="tab">{{ tab_help }}</a></li>
			</ul>
            <div class="tab-content">
				<div class="tab-pane" id="tab-settings">
					<form action="{{ action }}" method="post" id="form" class="form-horizontal">
						<div class="buttons">
							<button onclick="$('#form').attr('action', '{{ action_apply }}'); $('#form').submit();" class="btn btn-primary" title="{{ button_save }}" type="submit" data-original-title="{{ button_save }}"><i class="fa fa-refresh"></i></button>
							<button onclick="$('#form').submit();"class="btn btn-primary" title="{{ button_save_quit }}" type="submit" data-toggle="tooltip" data-original-title="{{ button_save_quit }}"><i class="fa fa-save"></i></button>
							<a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
						</div>
						<div class="form-group">
							<label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ entry_user_log_enable_help }}">{{ entry_user_log_enable }}</span></label>
							<div class="col-sm-10">
								<select name="user_log_enable" class="form-control">
									{% for key,value in enabled_disabled %}
										{% if key == user_log_enable %}
											{% set selected = 'selected="selected"' %}
										{% else  %}
											{% set selected = '' %}
										{% endif %}
									<option value="{{ key }}" {{ selected }}>{{ value }}</option>
									{% endfor %} 
								</select>
							</div>
						</div>
						<div class="form-group">
							<label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ entry_user_log_login_help }}">{{ entry_user_log_login }}</span></label>
							<div class="col-sm-10">
								<select name="user_log_login" class="form-control">
									{% for key,value in enabled_disabled %} 
										{% if key == user_log_login %}
											{% set selected = 'selected="selected"' %}
										{% else  %}
											{% set selected = '' %}
										{% endif %}
										<option value="{{ key }}" {{ selected }}>{{ value }}</option>
									{% endfor %} 
								</select>
							</div>
						</div>
						<div class="form-group">
							<label class="col-sm-2 control-label">{{ entry_user_log_failed_mail }}</label>
							<div class="col-sm-10">
								<div class="input-group">
									<span class="input-group-addon">
										{% set checked = user_log_failed_mail? 'checked="checked"':'' %}
										<input type="checkbox" name="user_log_failed_mail" value="1" {{ checked }}/>
									</span>
									<input class="form-control" type="text" name="user_log_failed_mailaddress" value="{{ user_log_failed_mailaddress }}" placeholder="{{ text_user_log_failed_mailaddress }}" />
								</div>							
							</div>
						</div>
						<div class="form-group">
							<label class="col-sm-2 control-label">{{ entry_user_log_ban }}</span></label>
							<div class="col-sm-10">
								<select name="user_log_ban" class="form-control">
									{% for key,value in enabled_disabled %} 
										{% if key == user_log_ban %}
											{% set selected = 'selected="selected"' %}
										{% else  %}
											{% set selected = '' %}
										{% endif %}
										<option value="{{ key }}" {{ selected }}>{{ value }}</option>
									{% endfor %} 
								</select>
							</div>
						</div>
						<div class="form-group">
							<label class="col-sm-2 control-label">{{ entry_user_log_ban_count }}</label>
							<div class="col-sm-10">
								<input class="form-control" type="text" name="user_log_ban_count" value="{{ user_log_ban_count }}" />
							</div>							
						</div>
						<div class="form-group">
							<label class="col-sm-2 control-label">{{ entry_user_log_ban_day }}</label>
							<div class="col-sm-10">
								<div class="col-sm-2">
									<input class="form-control" type="text" name="user_log_ban_period" value="{{ user_log_ban_period }}" />
								</div>							
								<div class="col-sm-2">
								<select name="user_log_interval_type" class="form-control">
									{% for type,text in interval_types %} 
										{% if type == user_log_interval_type %}
											{% set selected = 'selected="selected"' %}
										{% else  %}
											{% set selected = '' %}
										{% endif %}
										<option value="{{ type }}" {{ selected }}>{{ text }}</option>
									{% endfor %} 
								</select>
								</div>							

							</div>							
						</div>
						<div class="form-group">
							<label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ entry_user_log_logout_help }}">{{ entry_user_log_logout }}</span></label>
							<div class="col-sm-10">
								<select name="user_log_logout" class="form-control">
									{% for key,value in enabled_disabled %} 
										{% if key == user_log_logout %}
											{% set selected = 'selected="selected"' %}
										{% else  %}
											{% set selected = '' %}
										{% endif %}
										<option value="{{ key }}" {{ selected }}>{{ value }}</option>
									{% endfor %} 
								</select>
							</div>
						</div>
						<div class="form-group">
							<label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ entry_user_log_failedlog_help }}">{{ entry_user_log_failedlog }}</span></label>
							
							<div class="col-sm-10">
								<select name="user_log_failed" class="form-control">
									{% for key,value in enabled_disabled %} 
										{% if key == user_log_failed %}
											{% set selected = 'selected="selected"' %}
										{% else  %}
											{% set selected = '' %}
										{% endif %}
										<option value="{{ key }}" {{ selected }}>{{ value }}</option>
									{% endfor %} 
								</select>
							</div>
						</div>
						<div class="form-group">
							<label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ entry_user_log_access_help }}">{{ entry_user_log_access }}</span></label>
							<div class="col-sm-10">
								<div class="col-sm-5">
								<select name="user_log_access" class="form-control">
									{% for key,value in enabled_disabled %} 
										{% if key == user_log_access %}
											{% set selected = 'selected="selected"' %}
										{% else  %}
											{% set selected = '' %}
										{% endif %}
										<option value="{{ key }}" {{ selected }}>{{ value }}</option>
									{% endfor %} 
								</select>
								</div>
								<div class="col-sm-5">
								<div class="well well-sm" style="height: 150px; overflow: auto;">
									{% for user in users %} 
									<div>
									<label>
										{% if (user.user_id in user_log_access_list) %} 
										<input type="checkbox" name="user_log_access_list[]" value="{{ user.user_id }}" checked="checked" />
										{% else %} 
										<input type="checkbox" name="user_log_access_list[]" value="{{ user.user_id }}" />
										{% endif %} 
										{{ user.username }} 
									</label>
									</div>
									{% endfor %} 
								</div>
								</div>
							</div>
						</div>
{#
						<div class="form-group">
							<label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ entry_user_log_modify_help }}">{{ entry_user_log_modify }}</span></label>
							<div class="col-sm-10">
								<div class="col-sm-5">
								<select name="user_log_modify" class="form-control">
									{% for key,value in enabled_disabled %} 
										{% if key == user_log_modify %}
											{% set selected = 'selected="selected"' %}
										{% else  %}
											{% set selected = '' %}
										{% endif %}
										<option value="{{ key }}" {{ selected }}>{{ value }}</option>
									{% endfor %} 
								</select>
								</div>
								<div class="col-sm-5">
								<div class="well well-sm" style="height: 150px; overflow: auto;">
									{% for user in users %} 
									<div>
									<label>
										{% if (user.user_id in user_log_modify_list) %} 
										<input type="checkbox" name="user_log_modify_list[]" value="{{ user.user_id }}" checked="checked" />
										{% else %} 
										<input type="checkbox" name="user_log_modify_list[]" value="{{ user.user_id }}" />
										{% endif %} 
										{{ user['username'] }} 
									</label>
									</div>
									{% endfor %} 
								</div>
								</div>
							</div>
						</div>
#}						
						<div class="form-group">
							<label class="col-sm-2 control-label">{{ entry_user_log_display }}</label>
							<div class="col-sm-10">
								<input type="text" name="user_log_display" class="form-control"  value="{{ user_log_display }}" />
							</div>
						</div>
						<div class="form-group">
							<label class="col-sm-2 control-label">{{ entry_log_day }}</label>
							<div class="col-sm-10">
								<input type="text" name="user_log_day" class="form-control"  value="{{ user_log_day }}" />
							</div>
						</div>
					</form>
				</div>
				<div class="tab-pane" id="tab-help">

					<div> {{ text_help }}</div>
					<div>
							 {{ text_description }} 
					</div>
				</div>
				
			</div>
		</div>
	</div>
  </div>
  <script type="text/javascript">
$('#user_log_tabs a:first').tab('show');
</script></div>

{{ footer }}