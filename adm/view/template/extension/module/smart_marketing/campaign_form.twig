function addAdvancedSegmentationCondition(key = '', operator = '', value = '') {
   var html = '';

   html += '<tr id="segmentation-condition-advanced-segment-' + sc_advanced_segment_row + '">';
   html += '   <td class="text-left cell-segment-key">';
   html += '      <select name="segmentation_condition[advanced_segment][' + sc_advanced_segment_row +'][key]" data-row-index="' + sc_advanced_segment_row + '" class="advanced-segment-key form-control">';
   html += '         <option value="">{{ text_select|escape('js') }}</option>';
   html += '         <option value="firstname" data-type="text" data-value-type="text">{{ text_field_firstname|escape('js') }}</option>';
   html += '         <option value="lastname" data-type="text" data-value-type="text">{{ text_field_lastname|escape('js') }}</option>';
   html += '         <option value="email" data-type="text" data-value-type="text">{{ text_field_email|escape('js') }}</option>';
   html += '         <option value="customer_group_id" data-type="select" data-value-type="int" data-source="customer-group">{{ text_field_customer_group|escape('js') }}</option>';
   html += '         <option value="country_id" data-type="select" data-value-type="int" data-source="country">{{ text_field_country|escape('js') }}</option>';
   html += '         <option value="source" data-type="select" data-source="source" data-value-type="text">{{ text_field_source|escape('js') }}</option>';
   html += '         <option value="rating" data-type="text" data-value-type="int">{{ text_field_rating|escape('js') }}</option>';
   html += '         <option value="date_added" data-type="date" data-value-type="text">{{ text_field_date_added|escape('js') }}</option>';
   //html += '         <option value="date_modified" data-type="date" data-value-type="text">{{ text_field_date_modified|escape('js') }}</option>';
   html += '         <option value="total_spent" data-type="text" data-value-type="int" data-addon-text="{{ currency_symbol_left ? currency_symbol_left|escape('js') : currency_symbol_right|escape('js') }}">{{ text_field_total_spent|escape('js') }}</option>';
   html += '         <option value="order_count" data-type="text" data-value-type="int">{{ text_field_order_count|escape('js') }}</option>';
   html += '         <option value="last_order" data-type="text" data-value-type="int" data-addon-text="{{ text_day_ago }}">{{ text_field_last_order|escape('js') }}</option>';
   html += '         <option value="last_login" data-type="text" data-value-type="int" data-addon-text="{{ text_day_ago }}">{{ text_field_last_login|escape('js') }}</option>';
   html += '      </select>';
   html += '   </td>';
   html += '   <td class="text-left cell-segment-operator">';
   html += '      <select name="segmentation_condition[advanced_segment][' + sc_advanced_segment_row +'][operator]" data-row-index="' + sc_advanced_segment_row + '" class="advanced-segment-operator form-control">';
   html += '         <option value="">{{ text_select|escape('js') }}</option>';
   html += '      </select>';
   html += '   </td>';
   html += '   <td class="text-left cell-segment-value">';
   html += '      <input name="segmentation_condition[advanced_segment][' + sc_advanced_segment_row +'][value]" value="" data-row-index="' + sc_advanced_segment_row + '" class="advanced-segment-value form-control" />';
   html += '   </td>';
   html += '   <td class="text-right cell-segment-remove">';
   html += '      <button type="button" onclick="deleteAdvancedSegmentationCondition(' + sc_advanced_segment_row + ')" data-toggle="tooltip" rel="tooltip" title="{{ button_remove_condition|escape('js') }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>';
   html += '   </td>';
   html += '</tr>';

   $('#advanced-segment-conditions tbody').append(html);

   //select and add default or used values => case edit
   if (key != '' || operator != '' || value != '') {
      // key is always an select (html tag)
      if (key != '') {
         var object = $('select[name=\'segmentation_condition[advanced_segment][' + sc_advanced_segment_row + '][key]\']');

         $(object).find('option[value=\'' + key + '\']').prop('selected', 'selected');

         // trigger change to fill options
         getAdvancedSegmentationFieldsOnKeyChange(object);
      }

      // operator is always an select (html tag)
      if (operator != '') {
         $('select[name=\'segmentation_condition[advanced_segment][' + sc_advanced_segment_row + '][operator]\'] option[value=\'' + operator + '\']').prop('selected', 'selected');
      }

      if (value != '') {
         var object = $('*[name=\'segmentation_condition[advanced_segment][' + sc_advanced_segment_row + '][value]\']');

         var tag_name = $(object).prop('tagName').toLowerCase();

         if (tag_name == 'select') {
            $(object).find('option[value=\'' + value + '\']').prop('selected', 'selected');
         }

         if (tag_name == 'input') {
            $(object).val(value);
         }
      }
   }

   sc_advanced_segment_row++;
}

function getAdvancedSegmentationFieldsOnKeyChange(object) {
   //console.log('change triggered');

   var row_index = $(object).attr('data-row-index');

   var option = $(object).find(':selected');

   var tag_type = (typeof($(option).attr('data-type')) != 'undefined') ? $(option).attr('data-type') : '';
   var value_type = (typeof($(option).attr('data-value-type')) != 'undefined') ? $(option).attr('data-value-type') : '';
   var addon_text = (typeof($(option).attr('data-addon-text')) != 'undefined') ? $(option).attr('data-addon-text') : '';

   var operator_options = getAdvancedSegmentationOperatorOptions(tag_type, value_type);

   // delete previous options and add new options
   $('.advanced-segment-operator[data-row-index="' + row_index + '"]').find('option').remove().end().append(operator_options);

   // change segment value field => clear content to add new one
   $('#segmentation-condition-advanced-segment-' + row_index + ' .cell-segment-value').empty();

   // bind select source - when
   var source = (typeof($(option).attr('data-source')) != 'undefined') ? $(option).attr('data-source') : '';

   var value_field = getAdvancedSegmentationValueField(tag_type, row_index, source, addon_text);

   // add value field base on selected type
   $('#segmentation-condition-advanced-segment-' + row_index + ' .cell-segment-value').append(value_field);

   // reinitDatePicker for dinamically added date fields
   if (tag_type == 'date') {
      initDatePicker();
   }
}

function getAdvancedSegmentationOperatorOptions(tag_type, value_type) {
   var html = '';

   html += '<option value="">{{ text_select|escape('js') }}</option>';
   html += '<option value="equal">{{ text_operator_is|escape('js') }}</option>';
   html += '<option value="not-equal">{{ text_operator_is_not|escape('js') }}</option>';

   if (tag_type == 'text' && value_type == 'text') {
      html += '<option value="contain">{{ text_operator_contain|escape('js') }}</option>';
      html += '<option value="not-contain">{{ text_operator_not_contain|escape('js') }}</option>';
      html += '<option value="start-with">{{ text_operator_start_with|escape('js') }}</option>';
      html += '<option value="end-with">{{ text_operator_end_with|escape('js') }}</option>';
   }

   if (tag_type == 'text' && value_type == 'int') {
      html += '<option value="greater">{{ text_operator_greater_than|escape('js') }}</option>';
      html += '<option value="less">{{ text_operator_less_than|escape('js') }}</option>';
   }

   if (tag_type == 'date') {
      html += '<option value="is-after">{{ text_operator_is_after|escape('js') }}</option>';
      html += '<option value="is-before">{{ text_operator_is_before|escape('js') }}</option>';
   }

   return html;
}

function getAdvancedSegmentationValueField(type, row_index, source = '', addon_text) {
   var html = '';

   if (type == 'text' || type == 'select') {
      if (addon_text) {
         html += '<div class="input-group">';
      }

      if (type == 'text') {
         html += '<input name="segmentation_condition[advanced_segment][' + row_index +'][value]" value="" data-row-index="' + row_index + '" class="advanced-segment-value form-control" />';
      }

      if (type == 'select') {
         html += '<select name="segmentation_condition[advanced_segment][' + row_index +'][value]" value="" data-row-index="' + row_index + '" class="advanced-segment-value form-control">';

         if (source == 'customer-group') {
            html += '<option value="">{{ text_select }}</option>';

            {% for customer_group in customer_groups %}
            html += '<option value="{{ customer_group.customer_group_id }}">{{ customer_group.name|escape('js') }}</option>';
            {% endfor %}
         }

         if (source == 'country') {
            html += '<option value="">{{ text_select }}</option>';

            {% for country in countries %}
            html += '<option value="{{ country.country_id }}">{{ country.name|escape('js') }}</option>';
            {% endfor %}
         }

         if (source == 'source') {
            html += '<option value="">{{ text_select|escape('js') }}</option>';

            {% for source in sources %}
            html += '<option value="{{ source.code }}">{{ source.name|escape('js') }}</option>';
            {% endfor %}
         }

         if (source == 'yes-no') {
         }

         if (source == 'enabled-disabled') {
         }

         html += '</select>';
      }

      if (addon_text) {
         html += '<span class="input-group-addon">' + addon_text + '</span>';
         html += '</div>';
      }
   }

   if (type == 'date') {
      html += '<div class="input-group date">';
      html += '   <input name="segmentation_condition[advanced_segment][' + row_index +'][value]" value="" data-row-index="' + row_index + '" data-date-format="YYYY-MM-DD" class="advanced-segment-value form-control" />';
      html += '   <span class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></span>';
      html += '</div>';
   }

   return html;
}

function deleteAdvancedSegmentationCondition(row_index) {
   $('#segmentation-condition-advanced-segment-' + row_index).remove();
}

function SMCheckTemplateAction() {
   var template_id = $('input[name=\'template_id\']').val();

   if (template_id) {
      if ($('#template-action-confirmation').is(':hidden')) {
         $('#template-action-confirmation').show();
      }
   }
}

function initDatePicker() {
   $('.date').datetimepicker({
   	pickTime: false
   });
}

function initTimePicker() {
   $('.time').datetimepicker({
      pickDate: false,
      pickTime: true,
      sideBySide: true,
      icons: {
         up:   'fa fa-angle-up',
         down: 'fa fa-angle-down',
      }
   });
}

function initDateTimePicker() {
   $('.datetime').datetimepicker({
      pickDate: true,
      pickTime: true,
      sideBySide: true,
      icons: {
         up:   'fa fa-angle-up',
         down: 'fa fa-angle-down',
      }
   });
}
