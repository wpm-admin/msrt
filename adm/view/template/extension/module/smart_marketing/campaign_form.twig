{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" id="btn-save-campaign" form="form-campaign" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary loading-mask-trigger"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-campaign" class="form-horizontal">
            <fieldset>
              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
                <div class="col-sm-10">
                  <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
                  {% if error_name %}
                  <div class="text-danger">{{ error_name }}</div>
                  {% endif %}
                  <div class="help"><i class="fa fa-fw fa-info-circle"></i> {{ help_name }}</div>
                </div>
              </div>

              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                    <select name="status" class="form-control">
                       {% if status %}
                       <option value="0">{{ text_disabled }}</option>
                       <option value="1" selected="selected">{{ text_enabled }}</option>
                       {% else %}
                       <option value="0" selected="selected">{{ text_disabled }}</option>
                       <option value="1">{{ text_enabled }}</option>
                       {% endif %}
                    </select>
                </div>
              </div>
            </fieldset>

            <fieldset>
               <legend class="small text-center text-uppercase">{{ legend_recipient }}</legend>

               <div class="form-group required">
                  <label class="col-sm-2 control-label" for="input-segmentation-type">{{ entry_segmentation_type }}</label>
                  <div class="col-sm-10">
                     <select name="segmentation_type" class="form-control">
                        {% if segmentation_type == 'subscriber' %}
                        <option value="subscriber" selected="selected" data-segmentation-match-display="false">{{ text_subscriber }}</option>
                        {% else %}
                        <option value="subscriber" data-segmentation-match-display="false">{{ text_subscriber }}</option>
                        {% endif %}

                        {% if segmentation_type == 'customer' %}
                        <option value="customer" selected="selected" data-segmentation-match-display="false">{{ text_customer }}</option>
                        {% else %}
                        <option value="customer" data-segmentation-match-display="false">{{ text_customer }}</option>
                        {% endif %}

                        {% if segmentation_type == 'customer_group' %}
                        <option value="customer_group" selected="selected" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_group }}</option>
                        {% else %}
                        <option value="customer_group" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_group }}</option>
                        {% endif %}

                        {% if segmentation_type == 'customer_who_bought_product' %}
                        <option value="customer_who_bought_product" selected="selected" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_who_bought_product }}</option>
                        {% else %}
                        <option value="customer_who_bought_product" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_who_bought_product }}</option>
                        {% endif %}

                        {% if segmentation_type == 'customer_total_spent' %}
                        <option value="customer_total_spent" selected="selected" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_total_spent }}</option>
                        {% else %}
                        <option value="customer_total_spent" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_total_spent }}</option>
                        {% endif %}

                        {% if segmentation_type == 'customer_order_count' %}
                        <option value="customer_order_count" selected="selected" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_order_count }}</option>
                        {% else %}
                        <option value="customer_order_count" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_order_count }}</option>
                        {% endif %}

                        {% if segmentation_type == 'customer_last_order' %}
                        <option value="customer_last_order" selected="selected" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_last_order }}</option>
                        {% else %}
                        <option value="customer_last_order" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_last_order }}</option>
                        {% endif %}

                        {% if customer_activity_logged %}
                           {% if segmentation_type == 'customer_last_login' %}
                           <option value="customer_last_login" selected="selected" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_last_login }}</option>
                           {% else %}
                           <option value="customer_last_login" data-segmentation-match-display="false" data-segmentation-match-default="or">{{ text_customer_last_login }}</option>
                           {% endif %}
                        {% endif %}

                        {% if segmentation_type == 'advanced_segment' %}
                        <option value="advanced_segment" selected="selected" data-segmentation-match-display="true" data-segmentation-match-default="">{{ text_subscriber_segment }}</option>
                        {% else %}
                        <option value="advanced_segment" data-segmentation-match-display="true" data-segmentation-match-default="">{{ text_subscriber_segment }}</option>
                        {% endif %}
                     </select>

                     {% if error_segmentation_type %}
                     <div class="text-danger">{{ error_segmentation_type }}</div>
                     {% endif %}
                  </div>
               </div>
               <div class="form-group segmentation-match required">
                 <div class="col-sm-10 col-sm-offset-2">
                    <div class="input-group">
                      <span class="input-group-addon input-group-addon-transparent">{{ text_segmentation_match }}</span>
                      <select name="segmentation_match" class="form-control">
                         <option value="">{{ text_select }}</option>

                         {% if segmentation_match == 'or' %}
                         <option value="or" selected="selected">{{ text_any_condition }}</option>
                         {% else %}
                         <option value="or">{{ text_any_condition }}</option>
                         {% endif %}

                         {% if segmentation_match == 'and' %}
                         <option value="and" selected="selected">{{ text_all_condition }}</option>
                         {% else %}
                         <option value="and">{{ text_all_condition }}</option>
                         {% endif %}

                      </select>
                      <span class="input-group-addon input-group-addon-transparent">{{ text_following_condition }}</span>
                    </div>

                    {% if error_segmentation_match %}
                    <div class="text-danger">{{ error_segmentation_match }}</div>
                    {% endif %}
                 </div>
               </div>

               {% set sc_customer_group_row = 0 %}

               <div class="form-group segmentation-case segmentation-customer-group required">
                  <div class="col-sm-10 col-sm-offset-2">
                     <div class="input-group">
                        <span class="input-group-addon">{{ entry_customer_group }}</span>
                        <input type="text" name="customer_group" value="" placeholder="{{ entry_customer_group }}" id="input-customer-group" class="form-control" />
                     </div>
                     <div id="segmentation-condition-customer-group" class="well well-sm" style="margin-top: 10px; height: 100px; overflow: auto;">
                        {% if segmentation_condition['customer_group'] %}
                        {% for segment_condition in segmentation_condition.customer_group %}
                        {% for customer_group in customer_groups %}
                        {% if segment_condition.value == customer_group.customer_group_id %}
                        <div id="segmentation-condition-customer-group-{{ customer_group.customer_group_id }}"><i class="fa fa-minus-circle"></i> {{ customer_group.name }}
                           <input type="hidden" name="segmentation_condition[customer_group][{{ sc_customer_group_row }}][key]" value="{{ segment_condition.key }}" />
                           <input type="hidden" name="segmentation_condition[customer_group][{{ sc_customer_group_row }}][operator]" value="{{ segment_condition.operator }}" />
                           <input type="hidden" name="segmentation_condition[customer_group][{{ sc_customer_group_row }}][value]" value="{{ segment_condition.value }}" />
                        </div>
                        {% endif %}
                        {% endfor %}
                        {% set sc_customer_group_row = sc_customer_group_row + 1 %}
                        {% endfor %}
                        {% endif %}
                     </div>

                     {% if error_segmentation_condition['customer_group'] %}
                     <div class="text-danger">{{ error_segmentation_condition.customer_group }}</div>
                     {% endif %}
                  </div>
               </div>

               {% set sc_bought_product_row = 2 %}

               <div class="form-group segmentation-case segmentation-customer-who-bought-product required">
                  <div class="col-sm-10 col-sm-offset-2">
                     <div class="input-group">
                        <span class="input-group-addon">{{ entry_product }}</span>
                        <input type="text" name="product" value="" placeholder="{{ entry_product }}" id="input-product" class="form-control" />
                     </div>
                     <div id="segmentation-condition-customer-who-bought-product" class="well well-sm" style="margin-top: 10px; height: 100px; overflow: auto;">
                        {% if segmentation_condition['customer_who_bought_product'] %}
                        {% for segment_condition in segmentation_condition.customer_who_bought_product %}
                        {% for product in products %}
                        {% if segment_condition.key == 'product_id' and segment_condition.value == product.product_id %}
                        <div id="segmentation-condition-customer-who-bought-product-{{ product.product_id }}"><i class="fa fa-minus-circle"></i> {{ product.name }}
                           <input type="hidden" name="segmentation_condition[customer_who_bought_product][{{ sc_bought_product_row }}][key]" value="{{ segment_condition.key }}" />
                           <input type="hidden" name="segmentation_condition[customer_who_bought_product][{{ sc_bought_product_row }}][operator]" value="{{ segment_condition.operator }}" />
                           <input type="hidden" name="segmentation_condition[customer_who_bought_product][{{ sc_bought_product_row }}][value]" value="{{ segment_condition.value }}" />
                        </div>
                        {% endif %}
                        {% endfor %}
                        {% set sc_bought_product_row = sc_bought_product_row + 1 %}
                        {% endfor %}
                        {% endif %}
                     </div>

                     {% if error_segmentation_condition['customer_who_bought_product'] %}
                     <div class="text-danger extra-space">{{ error_segmentation_condition.customer_who_bought_product }}</div>
                     {% endif %}

                     <table class="table">
                        <tr>
                           <td class="text-left">
                              <input type="hidden" name="segmentation_condition[customer_who_bought_product][0][key]" value="date_start" />
                              <input type="hidden" name="segmentation_condition[customer_who_bought_product][0][operator]" value="is-after-or-equal" />

                              <div class="input-group date">
                                 <span class="input-group-addon">{{ entry_date_start }}</span>
                                 <input type="text" name="segmentation_condition[customer_who_bought_product][0][value]" value="{{ segmentation_condition['customer_who_bought_product'][0].value ? segmentation_condition['customer_who_bought_product'][0].value : '' }}" placeholder="{{ entry_date_start }}" data-date-format="YYYY-MM-DD" class="form-control" />
                                 <span class="input-group-btn">
                                    <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                                 </span>
                              </div>
                           </td>
                           <td class="text-left">
                              <input type="hidden" name="segmentation_condition[customer_who_bought_product][1][key]" value="date_end" />
                              <input type="hidden" name="segmentation_condition[customer_who_bought_product][1][operator]" value="is-before-or-equal" />

                              <div class="input-group date">
                                 <span class="input-group-addon">{{ entry_date_end }}</span>
                                 <input type="text" name="segmentation_condition[customer_who_bought_product][1][value]" value="{{ segmentation_condition['customer_who_bought_product'][1].value ? segmentation_condition['customer_who_bought_product'][1].value : '' }}" placeholder="{{ entry_date_end }}" data-date-format="YYYY-MM-DD" class="form-control" />
                                 <span class="input-group-btn">
                                    <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                                 </span>
                              </div>
                           </td>
                        </tr>
                     </table>
                  </div>
               </div>

               <div class="form-group segmentation-case segmentation-customer-total-spent required">
                  <div class="col-sm-10 col-sm-offset-2">
                     <table class="table">
                        <tbody>
                           <tr>
                              <td class="left">
                                 <select name="segmentation_condition[customer_total_spent][0][key]" class="form-control" readonly>
                                    <option value="customer_total_spent" selected="selected">{{ entry_total_spent }}</option>
                                 </select>
                              </td>
                              <td>
                                 <select name="segmentation_condition[customer_total_spent][0][operator]" class="form-control">
                                    <option value="">{{ text_select }}</option>
                                    {% if segmentation_condition['customer_total_spent'][0].operator and segmentation_condition['customer_total_spent'][0].operator == 'equal' %}
                                    <option value="equal" selected="selected">{{ text_operator_is }}</option>
                                    {% else %}
                                    <option value="equal">{{ text_operator_is }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_total_spent'][0].operator and segmentation_condition['customer_total_spent'][0].operator == 'not-equal' %}
                                    <option value="not-equal" selected="selected">{{ text_operator_is_not }}</option>
                                    {% else %}
                                    <option value="not-equal">{{ text_operator_is_not }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_total_spent'][0].operator and segmentation_condition['customer_total_spent'][0].operator == 'greater' %}
                                    <option value="greater" selected="selected">{{ text_operator_greater_than }}</option>
                                    {% else %}
                                    <option value="greater">{{ text_operator_greater_than }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_total_spent'][0].operator and segmentation_condition['customer_total_spent'][0].operator == 'less' %}
                                    <option value="less" selected="selected">{{ text_operator_less_than }}</option>
                                    {% else %}
                                    <option value="less">{{ text_operator_less_than }}</option>
                                    {% endif %}
                                 </select>
                              </td>
                              <td>
                                 <div class="input-group">
                                    {% if currency_symbol_left %}
                                    <span class="input-group-addon">{{ currency_symbol_left }}</span>
                                    {% endif %}
                                    <input type="text" name="segmentation_condition[customer_total_spent][0][value]" value="{{ segmentation_condition['customer_total_spent'][0].value ? segmentation_condition['customer_total_spent'][0].value : '' }}" class="form-control" />
                                    {% if currency_symbol_right %}
                                    <span class="input-group-addon">{{ currency_symbol_right }}</span>
                                    {% endif %}
                                 </div>
                              </td>
                           </tr>
                        </tbody>
                     </table>

                     {% if error_segmentation_condition['customer_total_spent'] %}
                     <div class="text-danger">{{ error_segmentation_condition.customer_total_spent }}</div>
                     {% endif %}
                  </div>
               </div>

               <div class="form-group segmentation-case segmentation-customer-order-count required">
                  <div class="col-sm-10 col-sm-offset-2">
                     <table class="table">
                        <tbody>
                           <tr>
                              <td class="left">
                                 <select name="segmentation_condition[customer_order_count][0][key]"  class="form-control" readonly>
                                    <option value="customer_order_count" selected="selected">{{ entry_order_count }}</option>
                                 </select>
                              </td>
                              <td class="left">
                                 <select name="segmentation_condition[customer_order_count][0][operator]" class="form-control">
                                    <option value="">{{ text_select }}</option>
                                    {% if segmentation_condition['customer_order_count'][0].operator and segmentation_condition['customer_order_count'][0].operator == 'equal' %}
                                    <option value="equal" selected="selected">{{ text_operator_is }}</option>
                                    {% else %}
                                    <option value="equal">{{ text_operator_is }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_order_count'][0].operator and segmentation_condition['customer_order_count'][0].operator == 'not-equal' %}
                                    <option value="not-equal" selected="selected">{{ text_operator_is_not }}</option>
                                    {% else %}
                                    <option value="not-equal">{{ text_operator_is_not }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_order_count'][0].operator and segmentation_condition['customer_order_count'][0].operator == 'greater' %}
                                    <option value="greater" selected="selected">{{ text_operator_greater_than }}</option>
                                    {% else %}
                                    <option value="greater">{{ text_operator_greater_than }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_order_count'][0].operator and segmentation_condition['customer_order_count'][0].operator == 'less' %}
                                    <option value="less" selected="selected">{{ text_operator_less_than }}</option>
                                    {% else %}
                                    <option value="less">{{ text_operator_less_than }}</option>
                                    {% endif %}
                                 </select>
                              </td>
                              <td class="left">
                                 <input type="text" name="segmentation_condition[customer_order_count][0][value]" value="{{ segmentation_condition['customer_order_count'][0].value ? segmentation_condition['customer_order_count'][0].value : '' }}" class="form-control" />
                              </td>
                           </tr>
                        </tbody>
                     </table>

                     {% if error_segmentation_condition['customer_order_count'] %}
                     <div class="text-danger">{{ error_segmentation_condition['customer_order_count'] }}</div>
                     {% endif %}
                  </div>
               </div>

               <div class="form-group segmentation-case segmentation-customer-last-order required">
                  <div class="col-sm-10 col-sm-offset-2">
                     <table class="table">
                        <tbody>
                           <tr>
                              <td class="left">
                                 <select name="segmentation_condition[customer_last_order][0][key]"  class="form-control" readonly>
                                    <option value="customer_last_order" selected="selected">{{ entry_last_order }}</option>
                                 </select>
                              </td>
                              <td class="left">
                                 <select name="segmentation_condition[customer_last_order][0][operator]" class="form-control">
                                    <option value="">{{ text_select }}</option>
                                    {% if segmentation_condition['customer_last_order'][0].operator and segmentation_condition['customer_last_order'][0].operator == 'equal' %}
                                    <option value="equal" selected="selected">{{ text_operator_is }}</option>
                                    {% else %}
                                    <option value="equal">{{ text_operator_is }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_last_order'][0].operator and segmentation_condition['customer_last_order'][0].operator == 'not-equal' %}
                                    <option value="not-equal" selected="selected">{{ text_operator_is_not }}</option>
                                    {% else %}
                                    <option value="not-equal">{{ text_operator_is_not }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_last_order'][0].operator and segmentation_condition['customer_last_order'][0].operator == 'greater' %}
                                    <option value="greater" selected="selected">{{ text_operator_greater_than }}</option>
                                    {% else %}
                                    <option value="greater">{{ text_operator_greater_than }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_last_order'][0].operator and segmentation_condition['customer_last_order'][0].operator == 'less' %}
                                    <option value="less" selected="selected">{{ text_operator_less_than }}</option>
                                    {% else %}
                                    <option value="less">{{ text_operator_less_than }}</option>
                                    {% endif %}
                                 </select>
                              </td>
                              <td class="left">
                                 <div class="input-group">
                                    <input type="text" name="segmentation_condition[customer_last_order][0][value]" value="{{ segmentation_condition['customer_last_order'][0].value ? segmentation_condition['customer_last_order'][0].value : '' }}" class="form-control" />
                                    <span class="input-group-addon">{{ text_day_ago }}</span>
                                 </div>
                              </td>
                           </tr>
                        </tbody>
                     </table>

                     {% if error_segmentation_condition['customer_last_order'] %}
                     <div class="text-danger">{{ error_segmentation_condition.customer_last_order }}</div>
                     {% endif %}
                  </div>
               </div>

               {% if customer_activity_logged %}
               <div class="form-group segmentation-case segmentation-customer-last-login required">
                  <div class="col-sm-10 col-sm-offset-2">
                     <table class="table">
                        <tbody>
                           <tr>
                              <td class="left">
                                 <select name="segmentation_condition[customer_last_login][0][key]"  class="form-control" readonly>
                                    <option value="customer_last_login" selected="selected">{{ entry_last_login }}</option>
                                 </select>
                              </td>
                              <td class="left">
                                 <select name="segmentation_condition[customer_last_login][0][operator]" class="form-control">
                                    <option value="">{{ text_select }}</option>
                                    {% if segmentation_condition['customer_last_login'][0].operator and segmentation_condition['customer_last_login'][0].operator == 'equal' %}
                                    <option value="equal" selected="selected">{{ text_operator_is }}</option>
                                    {% else %}
                                    <option value="equal">{{ text_operator_is }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_last_login'][0].operator and segmentation_condition['customer_last_login'][0].operator == 'not-equal' %}
                                    <option value="not-equal" selected="selected">{{ text_operator_is_not }}</option>
                                    {% else %}
                                    <option value="not-equal">{{ text_operator_is_not }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_last_login'][0].operator and segmentation_condition['customer_last_login'][0].operator == 'greater' %}
                                    <option value="greater" selected="selected">{{ text_operator_greater_than }}</option>
                                    {% else %}
                                    <option value="greater">{{ text_operator_greater_than }}</option>
                                    {% endif %}

                                    {% if segmentation_condition['customer_last_login'][0].operator and segmentation_condition['customer_last_login'][0].operator == 'less' %}
                                    <option value="less" selected="selected">{{ text_operator_less_than }}</option>
                                    {% else %}
                                    <option value="less">{{ text_operator_less_than }}</option>
                                    {% endif %}
                                 </select>
                              </td>
                              <td class="left">
                                 <div class="input-group">
                                    <input type="text" name="segmentation_condition[customer_last_login][0][value]" value="{{ segmentation_condition['customer_last_login'][0].value ? segmentation_condition['customer_last_login'][0].value : '' }}" class="form-control" />
                                    <span class="input-group-addon">{{ text_day_ago }}</span>
                                 </div>
                              </td>
                           </tr>
                        </tbody>
                     </table>

                     {% if error_segmentation_condition['customer_last_login'] %}
                     <div class="text-danger">{{ error_segmentation_condition.customer_last_login }}</div>
                     {% endif %}
                  </div>
               </div>
               {% endif %}

               <div class="form-group required segmentation-case segmentation-advanced-segment required">
                  <div class="col-sm-10 col-sm-offset-2">
                     <table class="table" id="advanced-segment-conditions">
                        <tbody>
                        </tbody>
                        <tfoot>
                           <tr>
                              <td class="text-left" colspan="4"><a href="javascript:void(0);" class="" onclick="addAdvancedSegmentationCondition();"><i class="fa fa-plus-circle"></i> {{ button_add_condition }}</a></td>
                           </tr>
                        </tfoot>
                     </table>

                     {% if error_segmentation_condition['advanced_segment'] %}
                     <div class="text-danger">{{ error_segmentation_condition.advanced_segment }}</div>
                     {% endif %}
                  </div>
               </div>

               <div class="form-group">
                  <div class="col-sm-10 col-sm-offset-2">
                     <div class="segmentation-count">
                        <div class="info">
                           {% if error_recipient_total %}
                           <div class="text-danger"><i class="fa fa-fw fa-arrow-up"></i> {{ error_recipient_total }} <i class="fa fa-fw fa-arrow-up"></i></div>
                           {% else %}
                           {{ help_update_recipient_count }}
                           {% endif %}
                        </div>
                        <div class="icon segmentation-count-update" data-toggle="tooltip" title="{{ button_update_recipient_count }}"><i class="fa fa-refresh"></i></div>
                     </div>
                  </div>
               </div>

            </fieldset>

            <fieldset>
               <legend class="small text-center text-uppercase">{{ legend_sender }}</legend>
               <div class="form-group required">
                 <label class="col-sm-2 control-label" for="input-sender-name">{{ entry_sender_name }}</label>
                 <div class="col-sm-10">
                   <div class="input-group">
                      <span class="input-group-addon"><i class="fa fa-building"></i></span>
                      <input type="text" name="sender_name" value="{{ sender_name }}" placeholder="{{ entry_sender_name }}" id="input-sender-name" class="form-control" />
                   </div>
