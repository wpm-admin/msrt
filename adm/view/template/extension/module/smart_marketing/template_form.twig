{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" id="btn-save-template" form="form-template" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary loading-mask-trigger"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
         {% for breadcrumb in breadcrumbs %}
         <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
         {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-template" class="form-horizontal">
           <div class="form-group required">
             <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
             <div class="col-sm-10">
               <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
               {% if error_name %}
               <div class="text-danger">{{ error_name }}</div>
               {% endif %}
               <div class="help"><i class="fa fa-fw fa-info-circle"></i> {{ help_name }}</div>
             </div>
           </div>

            <hr />

            <div class="form-group required">
               <label class="col-sm-2 control-label" for="input-html-content">{{ entry_html_content }}</label>
               <div class="col-sm-10">
                  <div class="well design-editor">
                     <div class="design-preview"></div>
                     <a href="javascript:void(0);" id="btn-smc-editor">
                        <i class="fa fa-edit"></i>
                        <span class="text-uppercase">{{ button_edit_design }}</span>
                     </a>

                     <div class="btn-send-test" data-format="html" data-toggle="tooltip" title="{{ button_html_test_email }}"><i class="fa fa-send"></i></div>
                  </div>

                  <textarea name="html_content" id="input-html-content" rows="20" class="form-control hidden">{{ html_content }}</textarea>

                  {% if error_html_content %}
                  <div class="text-danger">{{ error_html_content }}</div>
                  {% endif %}

                  <div class="help"><i class="fa fa-fw fa-info-circle"></i> {{ help_html_content }}</div>
               </div>
            </div>

           <div class="form-group required">
             <label class="col-sm-2 control-label" for="input-plain-content">{{ entry_plain_content }}</label>
             <div class="col-sm-10">
               <textarea name="plain_content" placeholder="{{ entry_plain_content }}" id="input-plain-content" rows="10" class="form-control">{{ plain_content }}</textarea>

               {% if error_plain_content %}
               <div class="text-danger">{{ error_plain_content }}</div>
               {% endif %}

               <div class="help"><i class="fa fa-fw fa-info-circle"></i> {{ help_plain_content }}</div>
             </div>
           </div>

           <input type="hidden" name="test_email_type" value="" />
        </form>

        <div class="smc-editor code-plus-preview">
          <div id="smc-grapejs">{{ html_content }}</div>
        </div>

        <div class="loading-mask-overlay">
           <div class="loading-mask-loading fixed">
             <div class='uil-ripple-css'><div></div><div></div></div>
           </div>
        </div>

      </div>
    </div>
  </div>
  <link href="view/javascript/grapesjs/css/grapes.min.css" rel="stylesheet" />
  <script type="text/javascript" src="view/javascript/grapesjs/grapes.min.js"></script>
  <script type="text/javascript" src="view/javascript/grapesjs/grapesjs-preset-newsletter-custom.min.js"></script>
  <script type="text/javascript" src="view/javascript/grapesjs/smart-marketing.js"></script>

  <script type="text/javascript"><!--
  // custom script later here - if required
  //--></script></div>
{{ footer }}
