<div class="modal-dialog modal-lg" role="document">
 <div class="modal-content">
   <div class="modal-header">
     <button type="button" class="close" data-dismiss="modal" aria-label=""><span aria-hidden="true">&times;</span></button>
     <button type="button" class="window-button minimize" data-action="minimize"><span><i class="fa fa-minus-square-o"></i></span></button>
     <button type="button" class="window-button maximize" data-action="maximize"><span><i class="fa fa-square-o"></i></span></button>
     <h4 class="modal-title text-uppercase">{{ heading_title }}</h4>
     {{ language_switcher }}
   </div>
   <div class="modal-body">
      <div id="section-search-filters">
         <form enctype="multipart/form-data" id="form-search-filters" class="form-horizontal">
            <div class="form-group required import-options">
               <label class="col-sm-2 control-label" for="input-product">{{ entry_import }}</label>
               <div class="col-sm-10">
                  <select name="import_source" class="form-control">
                     <option value="hand-pick" selected="selected">{{ text_hand_pick }}</option>
                     <option value="latest">{{ text_latest }}</option>
                     <option value="special">{{ text_special }}</option>
                     <option value="top-sales">{{ text_top_sales }}</option>
                     <option value="related">{{ text_related }}</option>
                     <option value="also-bought">{{ text_also_bought }}</option>
                     <option value="advanced-search">{{ text_advanced_search }}</option>
                  </select>
               </div>
            </div>

            <div id="import-option-hand-pick" class="form-group import-option">
               <label class="col-sm-2 control-label" for="input-hand-pick-product">{{ entry_product }}</label>
               <div class="col-sm-10">
                  <input type="text" name="hand_pick_product_name" value="" placeholder="{{ entry_product }}" id="input-hand-pick-product" class="product-autocomplete form-control" data-autocomplete-target="hand-pick-product" />
                  <div id="hand-pick-product" class="well well-sm product-autocomplete-list sortable" style="height: 100px; margin-top: 5px; margin-bottom:0px; overflow: auto;">
                  </div>
               </div>
