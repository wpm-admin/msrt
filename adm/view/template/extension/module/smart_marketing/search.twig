function getAdvancedSearchFieldsOnKeyChange(object) {
   //console.log('change triggered');

   var row_index = $(object).attr('data-row-index');

   var option = $(object).find(':selected');

   var tag_type = (typeof($(option).attr('data-type')) != 'undefined') ? $(option).attr('data-type') : '';
   var value_type = (typeof($(option).attr('data-value-type')) != 'undefined') ? $(option).attr('data-value-type') : '';
   var addon_text = (typeof($(option).attr('data-addon-text')) != 'undefined') ? $(option).attr('data-addon-text') : '';
   var multiple = (typeof($(option).attr('data-multiple')) != 'undefined') ? $(option).attr('data-multiple') : 0;
   var compute = (typeof($(option).attr('data-compute')) != 'undefined') ? ($(option).attr('data-compute') ? 1 : 0) : 0;

   var operator_options = getAdvancedSearchOperatorOptions(tag_type, value_type, multiple);

   // delete previous options and add new options
   $('.search-condition-operator[data-row-index="' + row_index + '"]').find('option').remove().end().append(operator_options);

   // change segment value field => clear content to add new one
   $('#advanced-search-condition-' + row_index + ' .cell-search-value').empty();

   // bind select source - when
   var source = (typeof($(option).attr('data-source')) != 'undefined') ? $(option).attr('data-source') : '';

   var value_field = getAdvancedSearchValueField(tag_type, multiple, row_index, source, addon_text);

   // add value field base on selected type
   $('#advanced-search-condition-' + row_index + ' .cell-search-value').append(value_field);

   // set as computed or not
   $('.search-condition-compute[data-row-index="' + row_index + '"]').val(compute);

   // reinitDatePicker for dinamically added date fields
   if (tag_type == 'date') {
      initDatePicker();
   }
}

function getAdvancedSearchOperatorOptions(tag_type, value_type, multiple) {
   var html = '';

   html += '<option value="">{{ text_select|escape('js') }}</option>';

   if (tag_type == 'select' && multiple) {
      html += '<option value="is-in">{{ text_operator_is_in|escape('js') }}</option>';
      html += '<option value="is-not-in">{{ text_operator_is_not_in|escape('js') }}</option>';
   } else {
      html += '<option value="equal">{{ text_operator_is|escape('js') }}</option>';
      html += '<option value="not-equal">{{ text_operator_is_not|escape('js') }}</option>';
   }

   if (tag_type == 'text' && value_type == 'text') {
      html += '<option value="contain">{{ text_operator_contain|escape('js') }}</option>';
      html += '<option value="not-contain">{{ text_operator_not_contain|escape('js') }}</option>';
      html += '<option value="start-with">{{ text_operator_start_with|escape('js') }}</option>';
      html += '<option value="end-with">{{ text_operator_end_with|escape('js') }}</option>';
   }

   if (tag_type == 'text' && value_type == 'int') {
      html += '<option value="greater">{{ text_operator_greater_than|escape('js') }}</option>';
      html += '<option value="less">{{ text_operator_less_than|escape('js') }}</option>';
   }

   if (tag_type == 'date') {
      html += '<option value="is-after">{{ text_operator_is_after|escape('js') }}</option>';
      html += '<option value="is-before">{{ text_operator_is_before|escape('js') }}</option>';
   }

   return html;
}

function getAdvancedSearchValueField(type, multiple, row_index, source = '', addon_text) {
   var html = '';

   if (type == 'text' || type == 'select') {
      if (addon_text) {
         html += '<div class="input-group">';
      }

      if (type == 'text') {
         html += '<input name="search_condition[' + row_index +'][value]" value="" data-row-index="' + row_index + '" class="search-condition-value form-control" />';
      }

      if (type == 'select') {

         if (!multiple) {
            html += '<select name="search_condition[' + row_index +'][value]" data-row-index="' + row_index + '" class="search-condition-value form-control">';
         } else {
            html += '<select name="search_condition[' + row_index +'][multiple]" data-row-index="' + row_index + '" multiple="multiple" size="' + multiple + '"' + 'class="search-condition-value select-multiple-options form-control">';
         }

         if (source == 'manufacturer') {
            if (!multiple) {
               html += '<option value="">{{ text_select }}</option>';
            }

            {% for manufacturer in manufacturers %}
            html += '<option value="{{ manufacturer.manufacturer_id }}">{{ manufacturer.name|escape('js') }}</option>';
            {% endfor %}
         }

         if (source == 'category') {
            if (!multiple) {
               html += '<option value="">{{ text_select }}</option>';
            }

            {% for category in categories %}
            html += '<option value="{{ category.category_id }}">{{ category.name|escape('js') }}</option>';
            {% endfor %}
         }

         if (source == 'yes-no') {
            html += '<option value="1">{{ text_yes|escape('js') }}</option>';
            html += '<option value="0">{{ text_no|escape('js') }}</option>';
         }

         if (source == 'enabled-disabled') {
            html += '<option value="1">{{ text_enabled|escape('js') }}</option>';
            html += '<option value="0">{{ text_disabled|escape('js') }}</option>';
         }

         if (source == 'stock') {
            html += '<option value="1">{{ text_in_stock|escape('js') }}</option>';
            html += '<option value="0">{{ text_out_stock|escape('js') }}</option>';
         }

         html += '</select>';

         if (multiple) {
            html += '<input type="hidden" name="search_condition[' + row_index +'][value]" data-row-index="' + row_index + '" value="" class="search-condition-value-select-multiple" />';
            html += '<div class="help help-advanced-search">{{ help_select_multiple|escape('js') }}</div>';
         }
      }

      if (addon_text) {
         html += '<span class="input-group-addon">' + addon_text + '</span>';
         html += '</div>';
      }
   }

   if (type == 'date') {
      html += '<div class="input-group date">';
      html += '   <input name="search_condition[' + row_index +'][value]" value="" data-row-index="' + row_index + '" data-date-format="YYYY-MM-DD" class="search-condition-value form-control" />';
      html += '   <span class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></span>';
      html += '</div>';
   }

   return html;
}

function handleSelectMultipleOptions(object) {
   var row_index = $(object).attr('data-row-index');
   var options = $(object).val();
   var selected_options = '';

   if (options.length) {
      selected_options = options.join(',');
   }

   $('.search-condition-value-select-multiple[data-row-index="' + row_index + '"]').val(selected_options);
}

function deleteAdvancedSearchCondition(row_index) {
   $('#advanced-search-condition-' + row_index).remove();
}

// --------------------------------------------------------

function initDatePicker() {
   $('.date').datetimepicker({
   	pickTime: false
   });
}

function initTimePicker() {
   $('.time').datetimepicker({
      pickDate: false,
      pickTime: true,
      sideBySide: true,
      icons: {
         up:   'fa fa-angle-up',
         down: 'fa fa-angle-down',
      }
   });
}

function initDateTimePicker() {
   $('.datetime').datetimepicker({
      pickDate: true,
      pickTime: true,
      sideBySide: true,
      icons: {
         up:   'fa fa-angle-up',
         down: 'fa fa-angle-down',
      }
   });
}

function initSortable() {
	$(".sortable" ).sortable();
}
