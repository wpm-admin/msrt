                        <input type="text" name="latest_date_start" value="" placeholder="{{ entry_date_start }}" data-date-format="YYYY-MM-DD" id="input-latest-date-start" class="form-control" />
                        <span class="input-group-btn">
                           <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                        </span>
                     </div>
                     <div class="help">{{ help_latest_date_start }}</div>
                  </div>
               </div>

               <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-latest-category">{{ entry_category }}</label>
                  <div class="col-sm-10">
                     <input type="text" name="latest_category_name" value="" placeholder="{{ entry_category }}" id="input-latest-category" class="category-autocomplete form-control" data-autocomplete-target="latest-category" />
                     <div id="latest-category" class="well well-sm category-autocomplete-list sortable" style="height: 100px; margin-top: 5px; margin-bottom:0px; overflow: auto;">
                     </div>
                     <div class="help">{{ help_category }}</div>
                  </div>
               </div>
               <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-latest-sub-category">{{ entry_sub_category }}</label>
                  <div class="col-sm-10">
                     <select name="latest_sub_category" class="form-control">
                        <option value="0">{{ text_no }}</option>
                        <option value="1">{{ text_yes }}</option>
                     </select>
                     <div class="help">{{ help_sub_category }}</div>
                  </div>
