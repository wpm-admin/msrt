            </div>

            <div id="import-option-special" class="form-group import-option">
               <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-special-category">{{ entry_category }}</label>
                  <div class="col-sm-10">
                     <input type="text" name="special_category_name" value="" placeholder="{{ entry_category }}" id="input-special-category" class="category-autocomplete form-control" data-autocomplete-target="special-category" />
                     <div id="special-category" class="well well-sm category-autocomplete-list sortable" style="height: 100px; margin-top: 5px; margin-bottom:0px; overflow: auto;">
                     </div>
                     <div class="help">{{ help_category }}</div>
                  </div>
               </div>
               <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-special-sub-category">{{ entry_sub_category }}</label>
                  <div class="col-sm-10">
                     <select name="special_sub_category" class="form-control">
                        <option value="0">{{ text_no }}</option>
                        <option value="1">{{ text_yes }}</option>
                     </select>
                     <div class="help">{{ help_sub_category }}</div>
                  </div>
               </div>
               <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-special-discount-min">{{ entry_discount_min }}</label>
                  <div class="col-sm-10">
