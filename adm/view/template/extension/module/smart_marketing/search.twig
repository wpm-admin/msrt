                     <div class="help">{{ help_discount_min }}</div>
                  </div>
               </div>
               <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-special-discount-max">{{ entry_discount_max }}</label>
                  <div class="col-sm-10">
                     <div class="input-group">
                        <input type="text" name="special_discount_max" value="" placeholder="{{ entry_discount_max }}" id="input-special-discount-max" class="form-control" />
                        <span class="input-group-addon">%</span>
                     </div>
                     <div class="help">{{ help_discount_max }}</div>
                  </div>
               </div>
               <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-special-sort-order">{{ entry_sort }}</label>
                  <div class="col-sm-10">
                     <select name="special_sort_order" class="form-control">
                        <option value="p.product_id|desc">{{ text_date_added_desc }}</option>
                        <option value="p.product_id|asc">{{ text_date_added_asc }}</option>
                        <option value="discount_percent|asc">{{ text_discount_asc }}</option>
                        <option value="discount_percent|desc">{{ text_discount_desc }}</option>
                     </select>
                  </div>
               </div>
            </div>

            <div id="import-option-top-sales" class="form-group import-option">
