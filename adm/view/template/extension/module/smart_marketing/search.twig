                  <label class="col-sm-2 control-label" for="input-top-sales-type">{{ entry_top_type }}</label>
                  <div class="col-sm-10">
                     <select name="top_sales_type" class="form-control">
                        <option value="quantity">{{ text_top_quantity }}</option>
